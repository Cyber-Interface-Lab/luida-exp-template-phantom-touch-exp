    - target: {fileID: 5964733846762761526, guid: 964d6187f971a8f43b4ee67279f1ef90,
        type: 3}
      propertyPath: sourceCode
      value: "expID = \"expID_example\";\ntoken = \"token_example\";\ncallExternalEndpointID
        = \"callExternalEndpointID_example\";\npNum = 1;\nisTestMode = true;\n\r\nconst
        uploadInterval = 1;\r\nconst dataLengthPerUpload = 100;\r\nconst dataByteLengthPerUpload
        = 100000; // 102400\r\n\r\n$.onStart(() => {\r\n    $.state.customData =
        [];\r\n    $.state.uploadIndex = 0;\r\n    $.state.elapsedTime = 0;\r\n   
        // $.state.dataLength = 0;\r\n    $.state.steps = 0;\r\n    $.state.isUploading
        = false;\r\n})\r\n\r\n$.onUpdate((deltaTime) => {\r\n    // A different sessionID
        in this group means a new participant's session started (session reset).
        Rows of the\r\n    // previous session that were never uploaded (a participant
        who left in the middle) are dropped instead of\r\n    // being uploaded under
        the new sessionID. Not while an upload is in progress: it empties the buffer
        itself.\r\n    if ($.state.boundSessionID !== $.groupState.sessionID) {\r\n       
        if ($.state.boundSessionID !== undefined && !$.state.isUploading\r\n           
        && Array.isArray($.state.customData) && $.state.customData.length > 0) {\r\n           
        $.log(\"[DataCollector] new session; dropping \" + $.state.customData.length
        + \" unsent row(s) of the previous session\");\r\n            $.state.customData
        = [];\r\n        }\r\n        $.state.boundSessionID = $.groupState.sessionID;\r\n   
        }\r\n    if ($.getStateCompat(\"this\", \"exp_recordCustomData\", \"boolean\"))
        {\r\n        $.setStateCompat(\"this\", \"exp_recordCustomData\", false);\r\n       
        recordData();\r\n    }\r\n    if ($.getStateCompat(\"this\", \"exp_uploadCustomData\",
        \"boolean\")) {\r\n        if ($.state.uploadIndex === 0) {\r\n           
        uploadDataInit();\r\n            $.setStateCompat(\"this\", \"exp_uploadCustomData\",
        false);\r\n        }\r\n    }\r\n    if ($.state.isUploading) {\r\n       
        $.state.elapsedTime = $.state.elapsedTime + deltaTime;\r\n        if ($.state.elapsedTime
        >= uploadInterval && $.state.uploadIndex < $.state.steps) {\r\n           
        $.state.elapsedTime = 0;\r\n            uploadDataStep();\r\n        }\r\n   
        }\r\n})\r\n\r\n$.onExternalCallEnd((res, meta, err) =>\r\n{\r\n    if (res
        == null) {\r\n        $.log(\"callExternal ERROR: \" + err);\r\n        return;\r\n   
        }\r\n\r\n    if (meta === \"customDataUploaded\") {\r\n        $.log(\"Response
        after customDataUploaded called: \" + JSON.stringify(res));\r\n    }\r\n});\r\n\r\n//
        Accept data pushed by other items via send() (e.g. a custom CCK item).\r\n//
        Item-group-independent: the payload carries the data, which we merge into\r\n//
        THIS collector's own $.groupState.collectedData scratchpad, then optionally\r\n//
        snapshot a row / flush - mirroring the exp_recordCustomData / exp_uploadCustomData\r\n//
        handling in $.onUpdate above.\r\n// Message: send(\"luida_collect\", { label:
        value, ..., __record?: bool, __upload?: bool })\r\n//   - Every data key
        is merged into the collector's scratchpad.\r\n//   - __record: true snapshots
        a row HERE (after the data lands) \u2014 do this instead of\r\n//     triggering
        the save from another item/gimmick, which can race send()'s delivery\r\n//    
        latency and snapshot the previous (or default) value instead.\r\n//   - __upload:
        true flushes the buffer to the backend.\r\n//   \"__record\" / \"__upload\"
        are control flags, not data (never written to the scratchpad).\r\n$.onReceive((messageType,
        arg, sender) => {\r\n    if (messageType !== \"luida_collect\") return;\r\n\r\n   
        if (!$.groupState.collectedData) $.groupState.collectedData = {};\r\n   
        const cd = $.groupState.collectedData;\r\n    if (arg && typeof arg === \"object\")
        {\r\n        for (const k in arg) {\r\n            if (k === \"__record\"
        || k === \"__upload\") continue;\r\n            cd[k] = arg[k];\r\n       
        }\r\n    }\r\n    $.groupState.collectedData = cd;\r\n\r\n    // Snapshot
        / flush HERE, after the just-sent data is in the scratchpad, so the row\r\n   
        // captures this send's value even on the very first send.\r\n    if (arg
        && arg.__record) recordData();\r\n    if (arg && arg.__upload && $.state.uploadIndex
        === 0) uploadDataInit();\r\n});\r\n\r\nfunction recordData () {\r\n    $.state.customData
        = calculateData();\r\n}\r\n\r\nfunction uploadDataInit() {\r\n    $.state.uploadIndex
        = 0;\r\n    $.state.elapsedTime = 0;\r\n    $.state.isUploading = true;\r\n\r\n   
        let dataByteLength = utf8ByteLength(JSON.stringify($.state.customData));\r\n   
        $.log(\"Data byte length: \" + dataByteLength);\r\n    $.state.steps = Math.ceil(dataByteLength
        / dataByteLengthPerUpload);\r\n}\r\n\r\nfunction uploadDataStep() {\r\n   
        $.log(\"Upload data step: \" + $.state.uploadIndex);\r\n    if ($.state.uploadIndex
        < $.state.steps) {\r\n        let request = {\r\n            type: \"uploadCustomData\",\r\n           
        token: token || \"\",\r\n            data: { data: $.state.customData.slice($.state.uploadIndex
        * dataLengthPerUpload, ($.state.uploadIndex + 1) * dataLengthPerUpload) },\r\n           
        eID: expID || \"\",\r\n            sID: $.groupState.sessionID || \"\"\r\n       
        };\r\n        $.log(JSON.stringify(request));\r\n        $.callExternal(\r\n           
        new ExternalEndpointId(callExternalEndpointID),\r\n            JSON.stringify(request),\r\n           
        \"customDataUploaded\");\r\n        $.state.uploadIndex = $.state.uploadIndex
        + 1;\r\n\r\n        if ($.state.uploadIndex >= $.state.steps) {\r\n           
        $.state.uploadIndex = 0;\r\n            $.state.isUploading = false;\r\n           
        $.state.customData = [];\r\n        }\r\n    }\r\n}\r\n\r\nfunction utf8ByteLength(str)
        {\r\n    let bytes = 0;\r\n    for (let i = 0; i < str.length; i++) {\r\n       
        const code = str.charCodeAt(i);\r\n\r\n        if (code <= 0x7F)                     
        bytes += 1; // U+0000 \u2013 U+007F\r\n        else if (code <= 0x7FF)               
        bytes += 2; // U+0080 \u2013 U+07FF\r\n        else if (code >= 0xD800 &&
        code <= 0xDBFF) {\r\n            // Surrogate pair (astral plane)\r\n           
        bytes += 4;                          // Whole pair is 4 bytes\r\n           
        i++;                                 // Skip the next surrogate\r\n       
        }\r\n        else                                   bytes += 3; // U+0800
        \u2013 U+FFFF\r\n    }\r\n    return bytes;\r\n}\r\n\r\nfunction calculateData
        () {\r\n    let returnData = $.state.customData;\r\n    if (!Array.isArray(returnData))
        returnData = [];\r\n    const CONDITION = $.groupState.currentCondition;\r\n   
        const PARTICIPANTS = [null].concat($.groupState.participants);\r\n    const
        COLLECTED_DATA = $.groupState.collectedData;\r\n    function saveData() {\r\n\r\n//
        === LUIDA AUTO-GENERATED (do not edit between markers) ===\n// Regenerated
        from LuidaDataCollectorConfig \u2014 manual edits inside this block will
        be lost.\n// No CCK-eligible labels registered. Add labels in LUIDA \u2192
        Configure data collector \u2192 Collected data items.\n// === LUIDA AUTO-GENERATED
        END ===\n\n// LUIDA tip: automation is active in this scene, so COLLECTED_DATA[\"stateLog\"]\n//           
        contains the latest state transition ({ id, name, startAt }).\n//           
        Add `stateLog: COLLECTED_DATA[\"stateLog\"]` to your returned\n//           
        object below to include it in the uploaded data.\n// Study 4 (phantom touch):
        one row per trial / setup / device check.\n// Written by Study4SceneBuilder
        (Code mode). Values are pushed by the state-listening items\n// (SendDataToCollector)
        and by the NPC item (group state). Labels that a row does not use keep\n//
        the value of the previous save, so interpret rows by stateLog.name.\nconst
        CD = (typeof COLLECTED_DATA !== 'undefined' && COLLECTED_DATA) ? COLLECTED_DATA
        : {};\nreturn {\n    stateLog: CD['stateLog'],\n    cond: CONDITION || {},\n   
        savedAt: Date.now(),\n    // block setup (Trial - Start, rep == 1)\n    avatar:
        CD['avatar'],\n    avatarArmLen: CD['avatarArmLen'], avatarShoulder: CD['avatarShoulder'],\n   
        avatarHeadH: CD['avatarHeadH'], avatarHipsH: CD['avatarHipsH'], avatarIsDefault:
        CD['avatarIsDefault'],\n    setupSec: CD['setupSec'], setupRetry: CD['setupRetry'],
        avatarCheckFallback: CD['avatarCheckFallback'],\n    // device check\n   
        deviceCheckSec: CD['deviceCheckSec'], deviceCheckForced: CD['deviceCheckForced'],\n   
        // per-trial report\n    rating: CD['rating'], mc: CD['mc'], ptype: CD['ptype'],
        ploc: CD['ploc'], reportDoneTs: CD['reportDoneTs'],\n    ptypeOther: CD['ptypeOther'],
        plocOther: CD['plocOther'],\n    // NPC measurements\n    social: CD['social'],
        npcBlock: CD['npcBlock'], npcRep: CD['npcRep'], npcAvatar: CD['npcAvatar'],\n   
        trialStartTs: CD['trialStartTs'], reachStartTs: CD['reachStartTs'], contactTs:
        CD['contactTs'], retractEndTs: CD['retractEndTs'],\n    strokeEndTs: CD['strokeEndTs'],
        strokeAmp: CD['strokeAmp'], strokeCycles: CD['strokeCycles'],\n    strokeBack:
        CD['strokeBack'], strokeReturnSpeed: CD['strokeReturnSpeed'],\n    // greeting
        period (written on both trials of the block)\n    greetSec: CD['greetSec'],
        greetGazeEvents: CD['greetGazeEvents'], greetHandRaises: CD['greetHandRaises'],\n   
        greetNpcReactions: CD['greetNpcReactions'], greetNpcNods: CD['greetNpcNods'],
        greetNpcWaves: CD['greetNpcWaves'],\n    greetNpcSmiles: CD['greetNpcSmiles'],
        greetNpcIdleReactions: CD['greetNpcIdleReactions'], greetTouches: CD['greetTouches'],\n   
        // height matching (head-bone heights, m; platform under the participant
        / riser under the NPC)\n    participantHeadH: CD['participantHeadH'], npcHeadH:
        CD['npcHeadH'], heightPlatform: CD['heightPlatform'], npcLift: CD['npcLift'],\n   
        pathLen: CD['pathLen'], reachDur: CD['reachDur'], contactDist: CD['contactDist'],
        reachable: CD['reachable'],\n    headPos0: CD['headPos0'], headRot0: CD['headRot0'],\n   
        retreatOnsetDist: CD['retreatOnsetDist'], retreatDist: CD['retreatDist'],
        oscAmp: CD['oscAmp'],\n    lookedAtNpc: CD['lookedAtNpc'], lookTs: CD['lookTs'],
        greeted: CD['greeted'],\n    npcTimeout: CD['npcTimeout'],\n    trace: CD['trace'],\n};\n\r\n   
        return {};\r\n  }\r\n  returnData.push(saveData());\r\n  return returnData;\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5964733846762761527, guid: 964d6187f971a8f43b4ee67279f1ef90,
        type: 3}
      propertyPath: id.value
      value: 2164424375340771255
      objectReference: {fileID: 0}
