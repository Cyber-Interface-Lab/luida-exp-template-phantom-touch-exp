%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22975fc05975d2a4f9b750cd520d63a0, type: 3}
  m_Name: PhantomTouch
  m_EditorClassIdentifier: ClusterMetaverseLab.Luida::LuidaDataCollectorConfig
  schemaVersion: 2
  collectedLabels:
  - label: avatar
    type: 6
    ignoreOnSave: 0
  - label: rating
    type: 6
    ignoreOnSave: 0
  - label: mc
    type: 6
    ignoreOnSave: 0
  - label: ptype
    type: 6
    ignoreOnSave: 0
  - label: ploc
    type: 6
    ignoreOnSave: 0
  - label: trace
    type: 6
    ignoreOnSave: 0
  fields: []
  customJsSuffix: 
  useCustomCodeMode: 1
  rawJs: "// Study 4 (phantom touch): one row per trial / setup / device check.\n//
    Written by Study4SceneBuilder (Code mode). Values are pushed by the state-listening
    items\n// (SendDataToCollector) and by the NPC item (group state). Labels that
    a row does not use keep\n// the value of the previous save, so interpret rows
    by stateLog.name.\nconst CD = (typeof COLLECTED_DATA !== 'undefined' && COLLECTED_DATA)
    ? COLLECTED_DATA : {};\nreturn {\n    stateLog: CD['stateLog'],\n    cond: CONDITION
    || {},\n    savedAt: Date.now(),\n    // block setup (Trial - Start, rep == 1)\n   
    avatar: CD['avatar'],\n    avatarArmLen: CD['avatarArmLen'], avatarShoulder:
    CD['avatarShoulder'],\n    avatarHeadH: CD['avatarHeadH'], avatarHipsH: CD['avatarHipsH'],
    avatarIsDefault: CD['avatarIsDefault'],\n    setupSec: CD['setupSec'], setupRetry:
    CD['setupRetry'], avatarCheckFallback: CD['avatarCheckFallback'],\n    // device
    check\n    deviceCheckSec: CD['deviceCheckSec'], deviceCheckForced: CD['deviceCheckForced'],\n   
    // shoulder height and arm length from the pose check (same row): arms held out
    to the sides (the hands' mean height,\n    // relative to the head bone, m),
    then forward (each hand's distance from the shoulder, m); '' when not measured\n   
    // (rescue button). The NPC aims at shoulder + arm / 2 (faceUp in the trial rows).\n   
    poseShoulderUp: CD['poseShoulderUp'], poseArmLen: CD['poseArmLen'], poseArmLeft:
    CD['poseArmLeft'], poseArmRight: CD['poseArmRight'],\n    // per-trial report\n   
    rating: CD['rating'], mc: CD['mc'], ptype: CD['ptype'], ploc: CD['ploc'], reportDoneTs:
    CD['reportDoneTs'],\n    ptypeOther: CD['ptypeOther'], plocOther: CD['plocOther'],\n   
    // NPC measurements\n    social: CD['social'], npcBlock: CD['npcBlock'], npcRep:
    CD['npcRep'], npcAvatar: CD['npcAvatar'],\n    trialStartTs: CD['trialStartTs'],
    reachStartTs: CD['reachStartTs'], contactTs: CD['contactTs'], retractEndTs: CD['retractEndTs'],\n   
    strokeEndTs: CD['strokeEndTs'], strokeAmp: CD['strokeAmp'], strokeCycles: CD['strokeCycles'],\n   
    strokeBack: CD['strokeBack'], strokeReturnSpeed: CD['strokeReturnSpeed'], strokeRampSec:
    CD['strokeRampSec'],\n    // guided greeting (every trial): seconds from each
    instruction to the participant following it (0 = already\n    // doing it, -1
    = skipped after the timeout), number skipped, cues the NPC received, and the
    NPC's counters\n    greetStepSec: CD['greetStepSec'], greetTimeouts: CD['greetTimeouts'],
    greetCues: CD['greetCues'],\n    greetSec: CD['greetSec'], greetGazeEvents: CD['greetGazeEvents'],
    greetHandRaises: CD['greetHandRaises'],\n    greetNpcReactions: CD['greetNpcReactions'],
    greetNpcNods: CD['greetNpcNods'], greetNpcWaves: CD['greetNpcWaves'],\n    greetNpcSmiles:
    CD['greetNpcSmiles'], greetTouches: CD['greetTouches'],\n    // height matching
    (head-bone heights, m; platform under the participant / riser under the NPC)\n   
    participantHeadH: CD['participantHeadH'], npcHeadH: CD['npcHeadH'], heightPlatform:
    CD['heightPlatform'], npcLift: CD['npcLift'],\n    pathLen: CD['pathLen'], reachDur:
    CD['reachDur'], contactDist: CD['contactDist'], reachable: CD['reachable'],\n   
    headPos0: CD['headPos0'], headRot0: CD['headRot0'],\n    // touch target height
    above the head bone (m) and where it came from: calibrated (forehead) / eyeBones
    / headBone\n    faceUp: CD['faceUp'], faceUpSrc: CD['faceUpSrc'],\n    retreatOnsetDist:
    CD['retreatOnsetDist'], retreatDist: CD['retreatDist'], oscAmp: CD['oscAmp'],\n   
    // backing away with the stick during the touch (slow, touchMoveRate x the normal
    speed): avatar position at the\n    // approach start, its distance from the
    marker then / at the end of the retract, its retreat like retreatDist,\n    //
    and whether the participant was put back on the marker after the NPC had gone\n   
    touchMoveRate: CD['touchMoveRate'], rootStart: CD['rootStart'], rootShiftPre:
    CD['rootShiftPre'],\n    rootRetreat: CD['rootRetreat'], rootShiftEnd: CD['rootShiftEnd'],
    returnedToMarker: CD['returnedToMarker'],\n    lookedAtNpc: CD['lookedAtNpc'],
    lookTs: CD['lookTs'], greeted: CD['greeted'],\n    npcTimeout: CD['npcTimeout'],\n   
    trace: CD['trace'],\n};\n"
