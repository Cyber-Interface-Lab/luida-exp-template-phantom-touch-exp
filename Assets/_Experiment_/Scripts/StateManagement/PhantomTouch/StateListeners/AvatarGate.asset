  eventHandlers: []
  otherImplementation: "// ---- Study 4: AvatarGate (avatar switch instruction +
    automatic check + two-step confirmation) ----\n// Bone-length signature of the
    LUIDA \"Default Avatar\" (participantAvatarMode = DEFAULT; luida_default_avatar).\n//
    Not measured yet: while AG_D_ARM / AG_D_SHOULDER are 0 the automatic check is
    off and the gate relies on\n// the participant's two-step self-report (recorded
    as avatarCheckFallback = true). To calibrate, wear the\n// Default Avatar in
    Cluster, read the \"[AvatarGate] signature\" log line and put its values here.\nconst
    AG_D_ARM = 0;          // upper arm + forearm (m)\nconst AG_D_SHOULDER = 0;    
    // distance between the two upper-arm joints (m)\nconst AG_TOL = 0.015;\nconst
    AG_STABLE_MS = 1000;\n// If the automatic check has not matched after this many
    seconds, show the button anyway and rely on\n// the participant's two-step self-report
    (recorded as avatarCheckFallback). 0 disables the fallback.\nconst AG_FALLBACK_SEC
    = 30;\nconst AG_LOG_SEC = 5;          // log the measured bone-length signature
    this often (calibration aid)\n\nfunction ag_send(id, cfg) {\n  try { const h
    = $.worldItemReference(id); if (h) h.send('btn_cfg', cfg); } catch (e) { $.log('[AvatarGate]
    send ' + id + ': ' + e); }\n}\nfunction ag_showButtons(changed, yesNo) {\n  ag_send('AG_Changed',
    { visible: changed, label: '\u7740\u66FF\u3048\u307E\u3057\u305F' });\n  ag_send('AG_Yes',
    { visible: yesNo, label: '\u306F\u3044' });\n  ag_send('AG_No', { visible: yesNo,
    label: '\u3044\u3044\u3048' });\n}\n// Photo 1: open the menu and tap 'Avatar'.
    Photo 2 picks 'LUIDA Default Avatar', so it is shown only when that is\n// the
    avatar to wear (in the daily-avatar block it could lead to the wrong choice).\nfunction
    ag_photos(show) {\n  if (show) ShowChild('MenuPhoto1'); else HideChild('MenuPhoto1');\n 
    if (show && $.state.ag_avatar === 'assigned') ShowChild('MenuPhoto2'); else HideChild('MenuPhoto2');\n}\nfunction
    ag_signature(p) {\n  const ua = p.getHumanoidBonePosition(HumanoidBone.LeftUpperArm);\n 
    const la = p.getHumanoidBonePosition(HumanoidBone.LeftLowerArm);\n  const h =
    p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n  const rua = p.getHumanoidBonePosition(HumanoidBone.RightUpperArm);\n 
    const head = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const hips = p.getHumanoidBonePosition(HumanoidBone.Hips);\n 
    const root = p.getPosition();\n  if (!ua || !la || !h || !rua || !head || !root)
    return null;\n  return {\n    armLen: ua.clone().sub(la).length() + la.clone().sub(h).length(),\n   
    shoulder: ua.clone().sub(rua).length(),\n    headH: head.y - root.y,\n    hipsH:
    hips ? hips.y - root.y : -1,\n  };\n}\nfunction ag_calibrated() { return AG_D_ARM
    > 0 && AG_D_SHOULDER > 0; }\nfunction ag_isDefault(s) {\n  return ag_calibrated()
    && !!s && Math.abs(s.armLen - AG_D_ARM) < AG_TOL && Math.abs(s.shoulder - AG_D_SHOULDER)
    < AG_TOL;\n}\nfunction ag_targetMatches(sig) {\n  if (!sig || !ag_calibrated())
    return false;\n  const isDefault = ag_isDefault(sig);\n  return $.state.ag_avatar
    === 'assigned' ? isDefault : !isDefault;\n}\nfunction ag_begin() {\n  $.state.ag_active
    = false;\n  if (!CONDITION || CONDITION['rep'] !== '1') {\n    // second trial
    of a block: no avatar change, skip the setup immediately\n    HideChild('Text');\n   
    ag_showButtons(false, false);\n    ToNextState();\n    return;\n  }\n  const
    dailyFirst = CONDITION['order'] === 'daily_first';\n  $.state.ag_avatar = (dailyFirst
    === (CONDITION['block'] === '1')) ? 'daily' : 'assigned';\n  $.state.ag_step
    = 1;\n  $.state.ag_active = true;\n  $.state.ag_startTs = Date.now();\n  $.state.ag_retry
    = 0;\n  $.state.ag_lastMatch = null;\n  $.state.ag_matchSince = Date.now();\n 
    $.state.ag_okShown = null;\n  $.state.ag_fallback = !ag_calibrated();   // not
    calibrated: self-report only\n  $.state.ag_logAt = 0;\n  ShowChild('Text');\n 
    ag_photos(true);   // photos of how to switch the avatar, next to the panel\n 
    ag_showButtons(false, false);\n  ag_renderText('');\n  $.log('[AvatarGate] block
    ' + CONDITION['block'] + ' -> ' + $.state.ag_avatar);\n}\nfunction ag_renderText(note)
    {\n  const daily = $.state.ag_avatar === 'daily';\n  let t;\n  if ($.state.ag_step
    === 1) {\n    t = daily\n      ? '\u30E1\u30CB\u30E5\u30FC\u304B\u3089\u3001\u666E\u6BB5\u3044\u3061\u3070\u3093\u3088\u304F\u4F7F\u3046\u30A2\u30D0\u30BF\u30FC\u306B\\n\u7740\u66FF\u3048\u3066\u304F\u3060\u3055\u3044\u3002\\n\u7D42\u308F\u3063\u305F\u3089\u300C\u7740\u66FF\u3048\u307E\u3057\u305F\u300D\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002'\n     
    : '\u30E1\u30CB\u30E5\u30FC\u306E\u30A2\u30D0\u30BF\u30FC\u5909\u66F4\u306B\u8868\u793A\u3055\u308C\u308B\\n\u300CDefault
    Avatar\u300D\u306B\u7740\u66FF\u3048\u3066\u304F\u3060\u3055\u3044\u3002\\n\u7D42\u308F\u3063\u305F\u3089\u300C\u7740\u66FF\u3048\u307E\u3057\u305F\u300D\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044\u3002';\n 
    } else {\n    t = daily\n      ? '\u3044\u307E\u7740\u3066\u3044\u308B\u30A2\u30D0\u30BF\u30FC\u306F\u3001\\n\u3042\u306A\u305F\u304C\u666E\u6BB5\u3044\u3061\u3070\u3093\u3088\u304F\u4F7F\u3046\u30A2\u30D0\u30BF\u30FC\u3067\u3059\u304B\uFF1F'\n     
    : '\u3044\u307E\u7740\u3066\u3044\u308B\u306E\u306F\u300CDefault Avatar\u300D\u3067\u3059\u304B\uFF1F';\n 
    }\n  if (note) t += '\\n' + note;\n  SetText(t);\n}\nfunction ag_update(dt) {\n 
    if (!$.state.ag_active) return;\n  const p = PARTICIPANTS[1];\n  if (!p || !p.exists())
    return;\n  const sig = ag_signature(p);\n  const match = ag_targetMatches(sig);\n 
    if (match !== $.state.ag_lastMatch) { $.state.ag_lastMatch = match; $.state.ag_matchSince
    = Date.now(); }\n  const elapsed = (Date.now() - ($.state.ag_startTs || Date.now()))
    / 1000;\n  if (sig && elapsed >= ($.state.ag_logAt || 0)) {\n    $.state.ag_logAt
    = elapsed + AG_LOG_SEC;\n    $.log('[AvatarGate] signature armLen=' + sig.armLen.toFixed(3)
    + ' shoulder=' + sig.shoulder.toFixed(3) +\n          ' headH=' + sig.headH.toFixed(3)
    + ' calibrated=' + ag_calibrated() + ' default=' + ag_isDefault(sig) + ' target='
    + $.state.ag_avatar);\n  }\n  if (!$.state.ag_fallback && AG_FALLBACK_SEC > 0
    && elapsed >= AG_FALLBACK_SEC && !match) {\n    $.state.ag_fallback = true;\n   
    $.log('[AvatarGate] automatic check did not match within ' + AG_FALLBACK_SEC
    + ' s; falling back to self-report');\n    $.state.ag_okShown = null;   // force
    a redraw below\n  }\n  const ok = $.state.ag_fallback || (match && (Date.now()
    - ($.state.ag_matchSince || 0)) >= AG_STABLE_MS);\n  if (ok !== $.state.ag_okShown)
    {\n    $.state.ag_okShown = ok;\n    if ($.state.ag_step === 1) {\n      ag_showButtons(ok,
    false);\n      ag_renderText(ok ? '' : ($.state.ag_avatar === 'assigned' ? '\uFF08\u307E\u3060\u300CDefault
    Avatar\u300D\u306B\u306A\u3063\u3066\u3044\u307E\u305B\u3093\uFF09' : '\uFF08\u307E\u3060\u300CDefault
    Avatar\u300D\u306E\u307E\u307E\u3067\u3059\uFF09'));\n    }\n  }\n  const b =
    $.getStateCompat('this', 'gate_btn', 'integer');\n  if (!(b > 0)) return;\n 
    $.setStateCompat('this', 'gate_btn', 0);\n  if (b === 1 && $.state.ag_step ===
    1 && ok) {\n    $.state.ag_step = 2;\n    ag_showButtons(false, true);\n    ag_renderText('');\n 
    } else if (b === 2 && $.state.ag_step === 2) {\n    if (!ok) {\n      $.state.ag_step
    = 1;\n      $.state.ag_okShown = null;\n      ag_showButtons(false, false);\n     
    ag_renderText('\uFF08\u30A2\u30D0\u30BF\u30FC\u304C\u4E00\u81F4\u3057\u3066\u3044\u307E\u305B\u3093\u3002\\n\u3082\u3046\u4E00\u5EA6\u7740\u66FF\u3048\u3066\u304F\u3060\u3055\u3044\uFF09');\n     
    return;\n    }\n    ag_confirm(sig);\n  } else if (b === 3 && $.state.ag_step
    === 2) {\n    $.state.ag_retry = ($.state.ag_retry || 0) + 1;\n    $.state.ag_step
    = 1;\n    $.state.ag_okShown = null;\n    ag_showButtons(false, false);\n   
    ag_renderText('');\n  }\n}\nfunction ag_confirm(sig) {\n  $.state.ag_active =
    false;\n  SendDataToCollector('avatar', $.state.ag_avatar);\n  SendDataToCollector('avatarArmLen',
    sig ? sig.armLen : -1);\n  SendDataToCollector('avatarShoulder', sig ? sig.shoulder
    : -1);\n  SendDataToCollector('avatarHeadH', sig ? sig.headH : -1);\n  SendDataToCollector('avatarHipsH',
    sig ? sig.hipsH : -1);\n  SendDataToCollector('avatarIsDefault', ag_calibrated()
    ? ag_isDefault(sig) : null);\n  SendDataToCollector('setupSec', (Date.now() -
    ($.state.ag_startTs || Date.now())) / 1000);\n  SendDataToCollector('setupRetry',
    $.state.ag_retry || 0);\n  SendDataToCollector('avatarCheckFallback', !!$.state.ag_fallback);\n 
    ProcessAndSaveCollectedData();\n  ag_showButtons(false, false);\n  ag_photos(false);\n 
    SetText('\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002');\n 
    ToNextState();\n}\nfunction ag_end() {\n  ag_showButtons(false, false);\n  HideChild('Text');\n 
    ag_photos(false);\n  $.state.ag_active = false;\n}\n"
