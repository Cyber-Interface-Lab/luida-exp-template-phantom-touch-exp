  otherImplementation: "// ---- Study 4: SessionReset (next participant in the same
    space) ----\n// Scripts run only while someone is in the space, so the reset
    runs when the NEXT player joins and finds End\n// with the previous participant
    gone. Phases: idle -> end -> (reset) -> settle -> pm -> idle.\n// Each step waits
    for confirmation and never advances on a timeout. Enrollment stays blocked by
    construction\n// until ParticipantManager has finished its own reset (the last
    step: ParticipantManager enrolls only while\n// isParticipantsEnough is false,
    and its reset clears that flag last). 'luida_reset_ack' is a completion notice;\n//
    Start (sr_idle) also ends the wait, because Start can only follow a completed
    ParticipantManager reset.\n// Upload success is not verified (decision 2026-11-06):
    SR_MIN_END_SEC only lets the existing uploader issue\n// End's request under
    the old sessionID before anything is reset.\nconst SR_END_ID = 11;\nconst SR_POLL_SEC
    = 0.5;\nconst SR_MIN_END_SEC = 5;     // script time since End began (End's upload
    is issued 1 s after End begins)\nconst SR_RESEND_SEC = 2;      // re-send while
    unconfirmed (the handlers are idempotent per token)\nconst SR_ALERT_SEC = 15;     
    // show an error on the instruction board after this long without confirmation\n\nfunction
    sr_status(extra) {   // read by Instruction (same group) for the waiting / error
    texts\n  $.groupState.luida_resetStatus = Object.assign({ phase: $.state.sr_phase
    || 'idle', token: $.state.sr_token || null }, extra || {});\n}\nfunction sr_phase(p)
    { $.state.sr_phase = p; $.state.sr_phaseSec = 0; $.state.sr_lastSend = -1e9;
    sr_status(); }\nfunction sr_idle() { sr_phase('idle'); $.state.sr_pmAck = false;
    }\nfunction sr_endBegin() { sr_phase('end'); $.state.sr_pollIn = 0; }\nfunction
    sr_prevGone() { const p = PARTICIPANTS[1]; return !!p && !p.exists(); }\nfunction
    sr_someoneHere() { return $.getPlayersNear($.getPosition(), Infinity).length
    > 0; }\nfunction sr_globalsReset() {\n  return $.getStateCompat('global', 'state_currentID',
    'integer') === 0\n      && $.getStateCompat('global', 'exp_trialID', 'integer')
    === 0\n      && $.getStateCompat('global', 'exp_readyToLeaveTrials', 'boolean')
    === false\n      && $.getStateCompat('global', 'exp_arePlayersEnough', 'boolean')
    === false;\n}\nfunction sr_send(id, msg, arg) {\n  try {\n    const h = $.worldItemReference(id);\n   
    if (!h) { $.log('[SessionReset] missing world item reference: ' + id); return
    false; }\n    h.send(msg, arg || {});\n    return true;\n  } catch (e) { $.log('[SessionReset]
    send ' + id + '/' + msg + ': ' + e); return false; }\n}\nfunction sr_due() {          
    // rate-limits the re-sends\n  if ($.state.sr_phaseSec - $.state.sr_lastSend
    < SR_RESEND_SEC) return false;\n  $.state.sr_lastSend = $.state.sr_phaseSec;\n 
    return true;\n}\nfunction sr_startReset() {\n  $.state.sr_token = ($.groupState.sessionID
    || 'none') + ':' + Date.now();\n  $.state.sr_pmAck = false;\n  $.log('[SessionReset]
    previous participant left after End; resetting for the next participant, token='
    + $.state.sr_token);\n  $.sendSignalCompat('this', 'exp_sessionReset');   //
    GlobalLogic x5 (see the builder)\n  $.groupState.participants = [];\n  $.groupState.collectedData
    = {};\n  sr_send('NPC', 'npc_hide');\n  sr_send('ConditionManager', 'luida_reset',
    { token: $.state.sr_token });\n  sr_phase('settle');\n  $.state.sr_lastSend =
    0;    // the first re-send comes SR_RESEND_SEC after the first send\n}\nfunction
    sr_tick(dt) {\n  const phase = $.state.sr_phase || 'idle';\n  if (phase === 'idle')
    return;\n  $.state.sr_phaseSec = ($.state.sr_phaseSec || 0) + dt;\n  $.state.sr_pollIn
    = ($.state.sr_pollIn || 0) - dt;\n  if ($.state.sr_pollIn > 0) return;\n  $.state.sr_pollIn
    = SR_POLL_SEC;\n  if (phase === 'end') {\n    if ($.getStateCompat('global',
    'state_currentID', 'integer') !== SR_END_ID) return;\n    if ($.state.sr_phaseSec
    < SR_MIN_END_SEC) return;\n    if (!sr_prevGone() || !sr_someoneHere()) return;\n   
    sr_startReset();\n  } else if (phase === 'settle') {\n    const acked = $.groupState.luida_resetAck
    === $.state.sr_token;\n    if (acked && sr_globalsReset()) {\n      $.log('[SessionReset]
    Globals and ConditionManager reset; resetting ParticipantManager');\n      sr_phase('pm');\n     
    sr_send('ParticipantManager', 'luida_reset', { token: $.state.sr_token });\n     
    $.state.sr_lastSend = 0;\n      return;\n    }\n    if (sr_due()) {\n      if
    (!sr_globalsReset()) { $.log('[SessionReset] Globals not reset yet; re-sending');
    $.sendSignalCompat('this', 'exp_sessionReset'); }\n      if (!acked) { $.log('[SessionReset]
    ConditionManager not reset yet; re-sending'); sr_send('ConditionManager', 'luida_reset',
    { token: $.state.sr_token }); }\n    }\n    if ($.state.sr_phaseSec >= SR_ALERT_SEC)
    sr_status({ error: 'reset' });\n  } else if (phase === 'pm') {\n    if ($.state.sr_pmAck)
    { $.log('[SessionReset] done; ParticipantManager reset acknowledged'); sr_idle();
    return; }\n    if (sr_due()) { $.log('[SessionReset] ParticipantManager not reset
    yet; re-sending'); sr_send('ParticipantManager', 'luida_reset', { token: $.state.sr_token
    }); }\n    if ($.state.sr_phaseSec >= SR_ALERT_SEC) sr_status({ error: 'reset'
    });\n  }\n}\n$.onReceive((messageType, arg) => {\n  if (messageType === 'luida_reset_ack'
    && arg && arg.token === $.state.sr_token) {\n    $.state.sr_pmAck = true;\n   
    $.log('[SessionReset] ParticipantManager reset acknowledged, new sID=' + arg.sessionID);\n 
    }\n});\n"
