  eventHandlers: []
  otherImplementation: "// ---- Study 4: position of this trial in its avatar block
    ----\nconst TRIALS_PER_BLOCK = 2;\nfunction trialInBlock() {\n  const t = $.getStateCompat('global',
    'exp_trialID', 'integer');\n  return ((typeof t === 'number' && t >= 0) ? t %
    TRIALS_PER_BLOCK : 0) + 1;\n}\nfunction firstTrialOfBlock() { return trialInBlock()
    === 1; }\nfunction lastTrialOfBlock() { return trialInBlock() === TRIALS_PER_BLOCK;
    }\n// ---- Study 4: DeviceCheck (head yaw left/right + both hands above the head,
    then the eye height) ----\n// Runs in the pose-check state (after the avatar
    switch, before the NPC appears) on the 1st trial of each block,\n// with the
    MirrorPanel's front mirror shown; the later trials of a block skip it immediately.\n//
    1st part ('pose'): tracking check. 2nd part ('eye'): the participant's own eye
    height in this avatar. Cluster puts\n// the first-person camera a little off
    the avatar's eye bones, and an item script cannot read the camera. So the\n//
    participant holds the right hand beside the headset (their own eye height) and
    clicks the large button straight\n// ahead (DC_Eye; an item script cannot see
    a bare trigger pull, only Interact / Use on an item). The right hand's\n// height
    above the head bone, averaged over the last DC_EYE_WINDOW_SEC, is sent to the
    NPC ('npc_eye_cal'), which\n// aims its hand from it in this block.\nconst DC_YAW_DEG
    = 25, DC_HANDS_SEC = 1.0, DC_RESCUE_SEC = 60;\nconst DC_FORCE_LABEL = '\u78BA\u8A8D\u3067\u304D\u306A\u3044\u5834\u5408\u306F\\n\u3053\u3061\u3089\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044';\nconst
    DC_EYE_LABEL = '\u3053\u3053\u306B\u5411\u3051\u3066\\n\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u304F';\nconst
    DC_EYE_WINDOW_SEC = 0.5;                  // the hand height is averaged over
    this long before the click ...\nconst DC_EYE_STILL = 0.03;                     
    // ... and must not have varied by more than this (m)\nconst DC_EYE_MIN = -0.05,
    DC_EYE_MAX = 0.30;    // accepted eye height above the head bone (m)\nconst DC_EYE_RESCUE_SEC
    = 45, DC_EYE_RESCUE_TRIES = 3;   // then the rescue button skips the measurement\nlet
    dcEyeSamples = [];\nfunction dc_btnSend(id, cfg) { try { const h = $.worldItemReference(id);
    if (h) h.send('btn_cfg', cfg); } catch (e) { $.log('[DeviceCheck] send ' + id
    + ': ' + e); } }\nfunction dc_send(cfg) { dc_btnSend('DC_Force', cfg); }\nfunction
    dc_sendEye(cfg) { dc_btnSend('DC_Eye', cfg); }\nfunction dc_begin() {\n  $.state.dc_active
    = false;\n  if (!firstTrialOfBlock()) { ToNextState(); return; }\n  $.state.dc_active
    = true;\n  $.state.dc_phase = 'pose';\n  $.state.dc_start = Date.now();\n  $.state.dc_left
    = false; $.state.dc_right = false; $.state.dc_hands = 0;\n  $.state.dc_yaw0 =
    null; $.state.dc_rescue = false; $.state.dc_lastText = '';\n  $.setStateCompat('this',
    'dc_btn', 0);\n  ShowChild('Text');\n  dc_send({ visible: false, label: DC_FORCE_LABEL
    });\n  dc_sendEye({ visible: false, label: DC_EYE_LABEL });\n  dc_render();\n}\nfunction
    dc_yaw(p) {\n  const r = p.getHumanoidBoneRotation(HumanoidBone.Head);\n  if
    (!r) return null;\n  const f = new Vector3(0, 0, 1).applyQuaternion(r);\n  return
    Math.atan2(f.x, f.z) * 180 / Math.PI;\n}\nfunction dc_angleDiff(a, b) { let d
    = a - b; while (d > 180) d -= 360; while (d < -180) d += 360; return d; }\nfunction
    dc_render() {\n  let t;\n  if ($.state.dc_phase === 'eye') {\n    const why =
    $.state.dc_eyeWhy;\n    t = (why === 'moving' ? '\u624B\u3092\u6B62\u3081\u3066\u304B\u3089\u3001\u3082\u3046\u4E00\u5EA6'
    : why ? '\u624B\u3092\u76EE\u306E\u9AD8\u3055\u306B\u4E0A\u3052\u3066\u3001\u3082\u3046\u4E00\u5EA6'
    : '\u76EE\u306E\u9AD8\u3055\u306E\u78BA\u8A8D') + '\\n' +\n      '\u53F3\u624B\u3092\u30D8\u30C3\u30C9\u30BB\u30C3\u30C8\u306E\u53F3\u6A2A\\n\uFF08\u3054\u81EA\u8EAB\u306E\u76EE\u306E\u9AD8\u3055\uFF09\u306B\u6DFB\u3048\u3066\u3001\\n\u6B63\u9762\u306E\u30DC\u30BF\u30F3\u306B\u5411\u3051\u3066\\n\u30C8\u30EA\u30AC\u30FC\u3092\u5F15\u3044\u3066\u304F\u3060\u3055\u3044';\n 
    } else {\n    t = '\u30C8\u30E9\u30C3\u30AD\u30F3\u30B0\u306E\u78BA\u8A8D\\n'
    +\n      (($.state.dc_left && $.state.dc_right) ? '[\u6E08] ' : '[\u3000] ')
    + '\u982D\u3092\u5DE6\u53F3\u306B\u5411\u3051\u308B\\n' +\n      (($.state.dc_hands
    || 0) >= DC_HANDS_SEC ? '[\u6E08] ' : '[\u3000] ') + '\u4E21\u624B\u3092\u982D\u3088\u308A\u4E0A\u306B\uFF081\u79D2\uFF09';\n 
    }\n  if (t !== $.state.dc_lastText) { $.state.dc_lastText = t; SetText(t); }\n}\nfunction
    dc_update(dt) {\n  if (!$.state.dc_active) return;\n  const p = PARTICIPANTS[1];\n 
    if (!p || !p.exists()) return;\n  const b = $.getStateCompat('this', 'dc_btn',
    'integer');   // 1: rescue button, 2: eye-height button\n  if (b > 0) $.setStateCompat('this',
    'dc_btn', 0);\n  if ($.state.dc_phase === 'eye') { dc_eyeUpdate(p, b); return;
    }\n  const yaw = dc_yaw(p);\n  if (yaw !== null) {\n    if ($.state.dc_yaw0 ===
    null || $.state.dc_yaw0 === undefined) $.state.dc_yaw0 = yaw;\n    const d =
    dc_angleDiff(yaw, $.state.dc_yaw0);\n    if (d <= -DC_YAW_DEG) $.state.dc_left
    = true;\n    if (d >= DC_YAW_DEG) $.state.dc_right = true;\n  }\n  const head
    = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const lh = p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n 
    const rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n  if (head &&
    lh && rh && lh.y > head.y && rh.y > head.y) $.state.dc_hands = ($.state.dc_hands
    || 0) + dt;\n  else if (($.state.dc_hands || 0) < DC_HANDS_SEC) $.state.dc_hands
    = 0;\n  const elapsed = (Date.now() - ($.state.dc_start || Date.now())) / 1000;\n 
    if (elapsed > DC_RESCUE_SEC && !$.state.dc_rescue) { $.state.dc_rescue = true;
    dc_send({ visible: true }); }\n  const forced = b === 1 && !!$.state.dc_rescue;\n 
    const passed = $.state.dc_left && $.state.dc_right && ($.state.dc_hands || 0)
    >= DC_HANDS_SEC;\n  if (passed || forced) { dc_eyeBegin(elapsed, forced); return;
    }\n  dc_render();\n}\n// 2nd part. After a forced pose check (tracking trouble)
    the rescue button stays, so this part can be skipped at once.\nfunction dc_eyeBegin(elapsed,
    forced) {\n  SendDataToCollector('deviceCheckSec', elapsed);\n  SendDataToCollector('deviceCheckForced',
    !!forced);\n  $.state.dc_phase = 'eye';\n  $.state.dc_eyeStart = Date.now();\n 
    $.state.dc_eyeTries = 0; $.state.dc_eyeWhy = '';\n  $.state.dc_rescue = !!forced;\n 
    dcEyeSamples = [];\n  dc_send({ visible: !!forced });\n  dc_sendEye({ visible:
    true, label: DC_EYE_LABEL });\n  dc_render();\n  $.log('[DeviceCheck] pose check
    ' + (forced ? 'forced' : 'passed') + ' after ' + elapsed.toFixed(1) + ' s; eye
    height next');\n}\nfunction dc_eyeUpdate(p, b) {\n  const now = Date.now();\n 
    const head = p.getHumanoidBonePosition(HumanoidBone.Head), rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n 
    if (head && rh) dcEyeSamples.push({ t: now, up: rh.y - head.y, hand: rh.y, head:
    head.y });\n  while (dcEyeSamples.length > 0 && now - dcEyeSamples[0].t > DC_EYE_WINDOW_SEC
    * 1000) dcEyeSamples.shift();\n  const elapsed = (now - ($.state.dc_eyeStart
    || now)) / 1000;\n  if (!$.state.dc_rescue && (elapsed > DC_EYE_RESCUE_SEC ||
    ($.state.dc_eyeTries || 0) >= DC_EYE_RESCUE_TRIES)) {\n    $.state.dc_rescue
    = true; dc_send({ visible: true });\n  }\n  if (b === 1 && $.state.dc_rescue)
    { dc_finish(null, elapsed); return; }\n  if (b === 2) {\n    const m = dc_eyeMeasure();\n   
    if (m.ok) { dc_finish(m, elapsed); return; }\n    $.state.dc_eyeTries = ($.state.dc_eyeTries
    || 0) + 1;\n    $.state.dc_eyeWhy = m.why;\n    $.log('[DeviceCheck] eye height
    not taken (' + m.why + (m.up !== undefined ? ', hand ' + m.up.toFixed(3) + '
    m above the head bone' : '') +\n          '); attempt ' + $.state.dc_eyeTries);\n 
    }\n  dc_render();\n}\n// The right hand's height above the head bone over the
    last DC_EYE_WINDOW_SEC: still enough and plausible?\nfunction dc_eyeMeasure()
    {\n  const n = dcEyeSamples.length;\n  if (n < 2) return { ok: false, why: 'bones'
    };\n  let up = 0, hand = 0, head = 0, lo = Infinity, hi = -Infinity;\n  for (const
    s of dcEyeSamples) { up += s.up; hand += s.hand; head += s.head; if (s.up < lo)
    lo = s.up; if (s.up > hi) hi = s.up; }\n  up /= n; hand /= n; head /= n;\n  if
    (hi - lo > DC_EYE_STILL) return { ok: false, why: 'moving', up: up };\n  if (up
    < DC_EYE_MIN || up > DC_EYE_MAX) return { ok: false, why: 'range', up: up };\n 
    return { ok: true, up: up, hand: hand, head: head };\n}\n// m: the measurement,
    or null when skipped with the rescue button (the NPC then uses the avatar's eye
    bones).\nfunction dc_finish(m, eyeSec) {\n  $.state.dc_active = false;\n  const
    r3 = (x) => Math.round(x * 1000) / 1000;\n  SendDataToCollector('eyeCalUp', m
    ? r3(m.up) : '');\n  SendDataToCollector('eyeCalHandY', m ? r3(m.hand) : '');\n 
    SendDataToCollector('eyeCalHeadY', m ? r3(m.head) : '');\n  SendDataToCollector('eyeCalSec',
    Math.round(eyeSec * 10) / 10);\n  SendDataToCollector('eyeCalRetries', $.state.dc_eyeTries
    || 0);\n  SendDataToCollector('eyeCalSkipped', !m);\n  if (m) {\n    try { $.worldItemReference('NPC').send('npc_eye_cal',
    { up: m.up }); }\n    catch (e) { $.log('[DeviceCheck] npc_eye_cal: ' + e); }\n 
    }\n  $.log('[DeviceCheck] eye height ' + (m ? r3(m.up) + ' m above the head bone
    (hand ' + r3(m.hand) + ', head bone ' + r3(m.head) + ')' : 'skipped') +\n       
    ' after ' + eyeSec.toFixed(1) + ' s, ' + ($.state.dc_eyeTries || 0) + ' failed
    attempt(s)');\n  ProcessAndSaveCollectedData();\n  dc_send({ visible: false });
    dc_sendEye({ visible: false });\n  SetText('\u78BA\u8A8D\u3067\u304D\u307E\u3057\u305F\u3002\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002');\n 
    ToNextState();\n}\nfunction dc_end() { dc_send({ visible: false }); dc_sendEye({
    visible: false }); HideChild('Text'); $.state.dc_active = false; }\n"
