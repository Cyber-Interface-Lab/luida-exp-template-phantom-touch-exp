  eventHandlers: []
  otherImplementation: "// ---- Study 4: DeviceCheck (head yaw left/right + both
    hands above the head) ----\n// Runs in the pose-check state (after the avatar
    switch, before the NPC appears) on the 1st trial of each block,\n// with the
    MirrorPanel's front mirror shown; the 2nd trial of a block skips it immediately.\nconst
    DC_YAW_DEG = 25, DC_HANDS_SEC = 1.0, DC_RESCUE_SEC = 60;\nconst DC_FORCE_LABEL
    = '\u78BA\u8A8D\u3067\u304D\u306A\u3044\u5834\u5408\u306F\\n\u3053\u3061\u3089\u3092\u62BC\u3057\u3066\u304F\u3060\u3055\u3044';\nfunction
    dc_send(cfg) { try { const h = $.worldItemReference('DC_Force'); if (h) h.send('btn_cfg',
    cfg); } catch (e) { $.log('[DeviceCheck] send: ' + e); } }\nfunction dc_begin()
    {\n  $.state.dc_active = false;\n  if (!CONDITION || CONDITION['rep'] !== '1')
    { ToNextState(); return; }\n  $.state.dc_active = true;\n  $.state.dc_start =
    Date.now();\n  $.state.dc_left = false; $.state.dc_right = false; $.state.dc_hands
    = 0;\n  $.state.dc_yaw0 = null; $.state.dc_rescue = false; $.state.dc_lastText
    = '';\n  ShowChild('Text');\n  dc_send({ visible: false, label: DC_FORCE_LABEL
    });\n  dc_render();\n}\nfunction dc_yaw(p) {\n  const r = p.getHumanoidBoneRotation(HumanoidBone.Head);\n 
    if (!r) return null;\n  const f = new Vector3(0, 0, 1).applyQuaternion(r);\n 
    return Math.atan2(f.x, f.z) * 180 / Math.PI;\n}\nfunction dc_angleDiff(a, b)
    { let d = a - b; while (d > 180) d -= 360; while (d < -180) d += 360; return
    d; }\nfunction dc_render() {\n  const t = '\u30C8\u30E9\u30C3\u30AD\u30F3\u30B0\u306E\u78BA\u8A8D\\n'
    +\n    (($.state.dc_left && $.state.dc_right) ? '[\u6E08] ' : '[\u3000] ') +
    '\u982D\u3092\u5DE6\u53F3\u306B\u5411\u3051\u308B\\n' +\n    (($.state.dc_hands
    || 0) >= DC_HANDS_SEC ? '[\u6E08] ' : '[\u3000] ') + '\u4E21\u624B\u3092\u982D\u3088\u308A\u4E0A\u306B\uFF081\u79D2\uFF09';\n 
    if (t !== $.state.dc_lastText) { $.state.dc_lastText = t; SetText(t); }\n}\nfunction
    dc_update(dt) {\n  if (!$.state.dc_active) return;\n  const p = PARTICIPANTS[1];\n 
    if (!p || !p.exists()) return;\n  const yaw = dc_yaw(p);\n  if (yaw !== null)
    {\n    if ($.state.dc_yaw0 === null || $.state.dc_yaw0 === undefined) $.state.dc_yaw0
    = yaw;\n    const d = dc_angleDiff(yaw, $.state.dc_yaw0);\n    if (d <= -DC_YAW_DEG)
    $.state.dc_left = true;\n    if (d >= DC_YAW_DEG) $.state.dc_right = true;\n 
    }\n  const head = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const lh =
    p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n  const rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n 
    if (head && lh && rh && lh.y > head.y && rh.y > head.y) $.state.dc_hands = ($.state.dc_hands
    || 0) + dt;\n  else if (($.state.dc_hands || 0) < DC_HANDS_SEC) $.state.dc_hands
    = 0;\n  const elapsed = (Date.now() - ($.state.dc_start || Date.now())) / 1000;\n 
    if (elapsed > DC_RESCUE_SEC && !$.state.dc_rescue) { $.state.dc_rescue = true;
    dc_send({ visible: true }); }\n  let forced = false;\n  const b = $.getStateCompat('this',
    'dc_btn', 'integer');\n  if (b > 0) { $.setStateCompat('this', 'dc_btn', 0);
    if ($.state.dc_rescue) forced = true; }\n  const passed = $.state.dc_left &&
    $.state.dc_right && ($.state.dc_hands || 0) >= DC_HANDS_SEC;\n  if (passed ||
    forced) { dc_finish(elapsed, forced); return; }\n  dc_render();\n}\nfunction
    dc_finish(elapsed, forced) {\n  $.state.dc_active = false;\n  SendDataToCollector('deviceCheckSec',
    elapsed);\n  SendDataToCollector('deviceCheckForced', !!forced);\n  ProcessAndSaveCollectedData();\n 
    dc_send({ visible: false });\n  SetText('\u78BA\u8A8D\u3067\u304D\u307E\u3057\u305F\u3002\\n\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002');\n 
    ToNextState();\n}\nfunction dc_end() { dc_send({ visible: false }); HideChild('Text');
    $.state.dc_active = false; }\n"
