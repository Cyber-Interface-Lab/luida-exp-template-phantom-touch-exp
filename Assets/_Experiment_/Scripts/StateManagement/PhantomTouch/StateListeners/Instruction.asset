        displayLabel: 
        codeSnippet: 
        variables: []
        category: 
      customAction: "ins_show('center', '\u3054\u53C2\u52A0\u3044\u305F\u3060\u304D\u3001\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\\n\u3053\u306E\u5B9F\u9A13\u3067\u306F\u3001\u300C\u30D5\u30A1\u30F3\u30C8\u30E0\u30BB\u30F3\u30B9\uFF08VR\u611F\u899A\u30FBV\u611F\uFF09\u300D\u306E\u3046\u3061\u3001\\n\u8AB0\u304B\u306B\u89E6\u308C\u3089\u308C\u305F\u3068\u611F\u3058\u308B\u300C\u30D5\u30A1\u30F3\u30C8\u30E0\u30BF\u30C3\u30C1\u932F\u899A\u300D\u304C\u3001\\n\u76F8\u624B\u306E\u53CD\u5FDC\u3084\u81EA\u5206\u306E\u30A2\u30D0\u30BF\u30FC\u306B\u5F71\u97FF\u3055\u308C\u308B\u304B\u3092\u8ABF\u3079\u3066\u3044\u307E\u3057\u305F\u3002\\n\u30D5\u30A1\u30F3\u30C8\u30E0\u30BF\u30C3\u30C1\u932F\u899A\u3068\u306F\u3001VR
        \u3067\u76F8\u624B\u306E\u30A2\u30D0\u30BF\u30FC\u306E\u624B\u304C\u9854\u306B\\n\u8FD1\u3065\u3044\u305F\u308A\u89E6\u308C\u305F\u308A\u3057\u305F\u3068\u304D\u306B\u3001\u5B9F\u969B\u306B\u306F\u89E6\u308C\u3089\u308C\u3066\u3044\u306A\u3044\u306E\u306B\u3001\\n\u9854\u306B\u611F\u899A\u304C\u751F\u3058\u308B\u73FE\u8C61\u3067\u3059\u3002\\n\u5177\u4F53\u7684\u306B\u306F\u3001\u76F8\u624B\u304C\u76EE\u3092\u5408\u308F\u305B\u305F\u308A\u624B\u3092\u632F\u3063\u305F\u308A\u3059\u308B\u304B\u3069\u3046\u304B\u3068\u3001\\n\u666E\u6BB5\u4F7F\u3044\u306E\u30A2\u30D0\u30BF\u30FC\u304B\u3069\u3046\u304B\u3067\u3001\\n\u611F\u3058\u65B9\u304C\u3069\u3046\u5909\u308F\u308B\u304B\u3092\u6BD4\u3079\u307E\u3057\u305F\u3002\\n\u3010\u304A\u9858\u3044\u3011
