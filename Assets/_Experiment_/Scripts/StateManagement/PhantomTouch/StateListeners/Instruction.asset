  otherImplementation: "// ---- Study 4: Instruction board (placements; coloured
    backing sized to the line count) ----\nconst INS_SLOTS = {\n  front: { p: new
    Vector3(0, 2.1867, 1.5), r: new Quaternion(-0.1994, 0, 0, 0.9799) },\n  side:
    { p: new Vector3(-1.1491, 1.65, 0.9642), r: new Quaternion(-0.0302, -0.4224,
    -0.0141, 0.9058) },\n  center: { p: new Vector3(0, 1.7, 1.5), r: new Quaternion(-0.0498,
    0, 0, 0.9988) },\n};\nconst INS_BG_MAX = 7;\nfunction ins_show(slot, text) {\n 
    const s = INS_SLOTS[slot] || INS_SLOTS.front;\n  const t = $.subNode('Text');\n 
    if (t) { t.setPosition(s.p); t.setRotation(s.r); }\n  SetText(text);\n  const
    n = Math.min(INS_BG_MAX, text ? String(text).split('\\n').length : 0);\n  for
    (let i = 1; i <= INS_BG_MAX; i++) { const bg = $.subNode('Bg_' + i); if (bg)
    bg.setEnabled(i === n); }\n}\n// Debrief 'OK' button (item DB_Ok; its Interact
    Item Trigger writes the Integer state 'ins_btn' here)\nfunction ins_okButton(visible)
    {\n  try { const h = $.worldItemReference('DB_Ok'); if (h) h.send('btn_cfg',
    { visible: visible, label: 'OK' }); }\n  catch (e) { $.log('[Instruction] send
    DB_Ok: ' + e); }\n}\nfunction ins_okBegin() { $.setStateCompat('this', 'ins_btn',
    0); ins_okButton(true); }\nfunction ins_okPressed() {\n  const b = $.getStateCompat('this',
    'ins_btn', 'integer');\n  if (!(b > 0)) return false;\n  $.setStateCompat('this',
    'ins_btn', 0);\n  return true;\n}\n// End: countdown to the exit gate (ExitPortal
    uses the same delay). After the participant has left, the next\n// participant
    who joins the same space sees a waiting text until the session reset brings the
    world back to\n// Start, or an error text when the reset cannot be confirmed
    (SessionReset publishes luida_resetStatus).\nconst INS_END_SEC = 10;\nfunction
    ins_endBegin() { $.state.ins_endTs = Date.now(); $.state.ins_endText = null;
    ins_endTick(); }\nfunction ins_endText() {\n  const rs = $.groupState.luida_resetStatus;\n 
    if (rs && rs.error) return '\u30A8\u30E9\u30FC\uFF1A\u5B9F\u9A13\u306E\u521D\u671F\u5316\u306B\\n\u5931\u6557\u3057\u307E\u3057\u305F\u3002\\n\u5B9F\u9A13\u8005\u306B\u3054\u9023\u7D61\u304F\u3060\u3055\u3044\u3002';\n 
    const p = PARTICIPANTS[1];\n  if (!p || !p.exists()) return '\u3057\u3070\u3089\u304F\u304A\u5F85\u3061\u304F\u3060\u3055\u3044\u2026';\n 
    const left = Math.max(0, Math.ceil(INS_END_SEC - (Date.now() - ($.state.ins_endTs
    || Date.now())) / 1000));\n  return left > 0\n    ? '\u3054\u53C2\u52A0\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\\n\u3042\u3068
    ' + left + ' \u79D2\u3067\u52DF\u96C6\u30EF\u30FC\u30EB\u30C9\u3078\\n\u79FB\u52D5\u3057\u307E\u3059\u3002'\n   
    : '\u3054\u53C2\u52A0\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\\n\u52DF\u96C6\u30EF\u30FC\u30EB\u30C9\u3078\u79FB\u52D5\u3057\u307E\u3059\u3002';\n}\nfunction
    ins_endTick() {\n  const text = ins_endText();\n  if (text === $.state.ins_endText)
    return;\n  $.state.ins_endText = text;\n  ins_show('center', text);\n}\n"
