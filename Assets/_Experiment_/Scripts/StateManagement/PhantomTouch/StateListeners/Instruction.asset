  eventHandlers: []
  otherImplementation: "// ---- Study 4: position of this trial in its avatar block
    ----\nconst TRIALS_PER_BLOCK = 2;\nfunction trialInBlock() {\n  const t = $.getStateCompat('global',
    'exp_trialID', 'integer');\n  return ((typeof t === 'number' && t >= 0) ? t %
    TRIALS_PER_BLOCK : 0) + 1;\n}\nfunction firstTrialOfBlock() { return trialInBlock()
    === 1; }\nfunction lastTrialOfBlock() { return trialInBlock() === TRIALS_PER_BLOCK;
    }\n// ---- Study 4: Instruction board (placements; backing quad scaled to the
    text) ----\n// slots: front = above the NPC's head, above = just above the questionnaire
    form, center = straight ahead\nconst INS_SLOTS = {\n  front: { p: new Vector3(0,
    2.1867, 1.5), r: new Quaternion(-0.1994, 0, 0, 0.9799), size: 0.024 },\n  above:
    { p: new Vector3(0, 2.55, 1.7), r: new Quaternion(-0.2627, 0, 0, 0.9649), size:
    0.03 },\n  center: { p: new Vector3(0, 1.65, 1.5), r: new Quaternion(-0.0333,
    0, 0, 0.9994), size: 0.024 },\n};\n// CCK TextView metrics (Noto Sans CJK): full-width
    glyph ~1.85 x size wide, ASCII ~0.56 of that, line ~2.74 x size\nconst INS_GLYPH_W
    = 1.85, INS_LINE_H = 2.74, INS_PAD = 0.05;\nfunction ins_show(slot, text, size)
    {\n  const s = INS_SLOTS[slot] || INS_SLOTS.front;\n  const sz = size || s.size;\n 
    const t = $.subNode('Text');\n  if (t) {\n    t.setPosition(s.p); t.setRotation(s.r);\n   
    try { t.setTextSize(sz); } catch (e) { $.log('[Instruction] setTextSize: ' +
    e); }\n  }\n  SetText(text);\n  const lines = text ? String(text).split('\\n')
    : [];\n  let w = 0;\n  for (const ln of lines) { let lw = 0; for (let i = 0;
    i < ln.length; i++) lw += ln.charCodeAt(i) < 0x80 ? 0.56 : 1; if (lw > w) w =
    lw; }\n  const bg = $.subNode('Bg');\n  if (!bg) return;\n  if (lines.length
    === 0 || w === 0) { bg.setEnabled(false); return; }\n  try {\n    bg.getUnityComponent('Transform').unityProp.localScale
    = new Vector3(w * INS_GLYPH_W * sz + INS_PAD * 2, lines.length * INS_LINE_H *
    sz + INS_PAD, 1);\n    bg.setEnabled(true);\n  } catch (e) { $.log('[Instruction]
    backing: ' + e); }\n}\n// Debrief 'OK' button (item DB_Ok; its Interact Item
    Trigger writes the Integer state 'ins_btn' here)\nfunction ins_okButton(visible)
    {\n  try { const h = $.worldItemReference('DB_Ok'); if (h) h.send('btn_cfg',
    { visible: visible, label: 'OK' }); }\n  catch (e) { $.log('[Instruction] send
    DB_Ok: ' + e); }\n}\nfunction ins_okBegin() { $.setStateCompat('this', 'ins_btn',
    0); ins_okButton(true); }\nfunction ins_okPressed() {\n  const b = $.getStateCompat('this',
    'ins_btn', 'integer');\n  if (!(b > 0)) return false;\n  $.setStateCompat('this',
    'ins_btn', 0);\n  return true;\n}\n// End: countdown to the exit gate (ExitPortal
    uses the same delay). After the participant has left, the next\n// person who
    joins the same space sees a waiting text; the LUIDA ParticipantManager asks them,
    in front of\n// them, whether they are a new participant and brings the world
    back to Start when they confirm.\nconst INS_END_SEC = 10;\nfunction ins_endBegin()
    { $.state.ins_endTs = Date.now(); $.state.ins_endText = null; ins_endTick();
    }\nfunction ins_endText() {\n  const p = PARTICIPANTS[1];\n  if (!p || !p.exists())
    return '\u3057\u3070\u3089\u304F\u304A\u5F85\u3061\u304F\u3060\u3055\u3044\u2026';\n 
    const left = Math.max(0, Math.ceil(INS_END_SEC - (Date.now() - ($.state.ins_endTs
    || Date.now())) / 1000));\n  return left > 0\n    ? '\u3054\u53C2\u52A0\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\\n\u3042\u3068
    ' + left + ' \u79D2\u3067\u52DF\u96C6\u30EF\u30FC\u30EB\u30C9\u3078\u79FB\u52D5\u3057\u307E\u3059\u3002'\n   
    : '\u3054\u53C2\u52A0\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\u3002\\n\u52DF\u96C6\u30EF\u30FC\u30EB\u30C9\u3078\u79FB\u52D5\u3057\u307E\u3059\u3002';\n}\nfunction
    ins_endTick() {\n  const text = ins_endText();\n  if (text === $.state.ins_endText)
    return;\n  $.state.ins_endText = text;\n  ins_show('center', text);\n}\n"
