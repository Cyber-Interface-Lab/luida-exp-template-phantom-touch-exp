  eventHandlers: []
  otherImplementation: "// ---- Study 4: position of this trial in its avatar block
    ----\nconst TRIALS_PER_BLOCK = 2;\nfunction trialInBlock() {\n  const t = $.getStateCompat('global',
    'exp_trialID', 'integer');\n  return ((typeof t === 'number' && t >= 0) ? t %
    TRIALS_PER_BLOCK : 0) + 1;\n}\nfunction firstTrialOfBlock() { return trialInBlock()
    === 1; }\nfunction lastTrialOfBlock() { return trialInBlock() === TRIALS_PER_BLOCK;
    }\n// ---- Study 4: MirrorPanel (the touch mirror is fitted to the participant's
    height) ----\nconst MP_TOUCH = { local: new Vector3(0.9192, 0.075, -0.3808),
    baseY: 1.275, w: 0.9, floorY: 0,\n  minBottom: 0.3, maxTop: 2.1, margin: 0.05,
    eyeAboveHead: 0.07, topAboveHead: 0.22 };\n// returns false while the participant's
    bones cannot be read (the mirror keeps its previous size)\nfunction mp_fitTouch()
    {\n  const p = PARTICIPANTS[1];\n  if (!p || !p.exists()) return false;\n  let
    head = null;\n  try { head = p.getHumanoidBonePosition(HumanoidBone.Head); }
    catch (e) { head = null; }\n  const root = p.getPosition();\n  if (!head || !root
    || head.y - root.y < 0.3) return false;\n  const c = MP_TOUCH;\n  const eye =
    head.y + c.eyeAboveHead, feet = Math.min(root.y, c.floorY), top = head.y + c.topAboveHead;\n 
    const bottom = Math.max(c.minBottom, (eye + feet) / 2 - c.margin);\n  const upper
    = Math.min(c.maxTop, Math.max(bottom + 0.3, (eye + top) / 2 + c.margin));\n 
    const node = $.subNode('MirrorTouch');\n  if (!node) return true;\n  const mid
    = (bottom + upper) / 2;\n  node.setPosition(new Vector3(c.local.x, c.local.y
    + mid - c.baseY, c.local.z));\n  try { node.getUnityComponent('Transform').unityProp.localScale
    = new Vector3(c.w, upper - bottom, 1); }\n  catch (e) { $.log('[MirrorPanel]
    mirror size: ' + e); }\n  $.log('[MirrorPanel] touch mirror ' + bottom.toFixed(2)
    + '..' + upper.toFixed(2) + ' m (head bone ' + head.y.toFixed(2) + ', feet '
    + root.y.toFixed(2) + ')');\n  return true;\n}\n"
