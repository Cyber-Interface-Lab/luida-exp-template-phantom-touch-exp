%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb8c4c8a0a4dc6418e2f4d59454f5e3, type: 3}
  m_Name: MirrorPanel
  m_EditorClassIdentifier: ClusterMetaverseLab.Luida::StateListeningItemData
  stateListeners:
  - stateID: 0
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Show item
        displayLabel: 
        codeSnippet: $.setStateCompat('this', 'exp_showItem', true);
        variables: []
        category: Item
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    - predefinedActionTemplate:
        actionType: Hide child
        displayLabel: 
        codeSnippet: $.subNode('{_childName_}').setEnabled(false)
        variables:
        - childName
        category: Item child
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys:
      - childName
      _variableValuesList:
      - Mirror
    - predefinedActionTemplate:
        actionType: Hide child
        displayLabel: 
        codeSnippet: $.subNode('{_childName_}').setEnabled(false)
        variables:
        - childName
        category: Item child
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys:
      - childName
      _variableValuesList:
      - MirrorFront
    duringStateActions: []
    onStateExitedActions: []
  - stateID: 1
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        displayLabel: 
        codeSnippet: 
        variables: []
        category: 
      customAction: if (firstTrialOfBlock()) $.subNode('Mirror').setEnabled(true);
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions: []
  - stateID: 2
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        displayLabel: 
        codeSnippet: 
        variables: []
        category: 
      customAction: if (firstTrialOfBlock()) { $.subNode('MirrorFront').setEnabled(true);
        $.subNode('Mirror').setEnabled(false); }
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions:
    - predefinedActionTemplate:
        actionType: Hide child
        displayLabel: 
        codeSnippet: $.subNode('{_childName_}').setEnabled(false)
        variables:
        - childName
        category: Item child
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys:
      - childName
      _variableValuesList:
      - MirrorFront
  - stateID: 3
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Show child
        displayLabel: 
        codeSnippet: $.subNode('{_childName_}').setEnabled(true)
        variables:
        - childName
        category: Item child
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys:
      - childName
      _variableValuesList:
      - Mirror
    duringStateActions: []
    onStateExitedActions: []
  - stateID: 4
    onStateStartedActions: []
    duringStateActions: []
    onStateExitedActions:
    - predefinedActionTemplate:
        actionType: Hide child
        displayLabel: 
        codeSnippet: $.subNode('{_childName_}').setEnabled(false)
        variables:
        - childName
        category: Item child
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys:
      - childName
      _variableValuesList:
      - Mirror
  eventHandlers: []
  otherImplementation: "// ---- Study 4: position of this trial in its avatar block
    ----\nconst TRIALS_PER_BLOCK = 2;\nfunction trialInBlock() {\n  const t = $.getStateCompat('global',
    'exp_trialID', 'integer');\n  return ((typeof t === 'number' && t >= 0) ? t %
    TRIALS_PER_BLOCK : 0) + 1;\n}\nfunction firstTrialOfBlock() { return trialInBlock()
    === 1; }\nfunction lastTrialOfBlock() { return trialInBlock() === TRIALS_PER_BLOCK;
    }\n// A mirror shown or hidden by another item (the DeviceCheck hides the front
    mirror for the pose check's\n// last step): { name, visible }\n$.onReceive((messageType,
    arg) => {\n  if (messageType !== 'mp_mirror' || !arg) return;\n  const n = $.subNode(String(arg.name));\n 
    if (n) n.setEnabled(!!arg.visible);\n});\n"
