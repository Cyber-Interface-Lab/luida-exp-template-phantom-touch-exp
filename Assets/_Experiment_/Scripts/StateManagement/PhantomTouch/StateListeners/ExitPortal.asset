      _variableValuesList:
      - WorldGateToLuidaBar
    duringStateActions: []
    onStateExitedActions: []
  - stateID: 11
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        displayLabel: 
        codeSnippet: 
        variables: []
        category: 
      customAction: ep_begin();
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        displayLabel: 
        codeSnippet: 
        variables: []
