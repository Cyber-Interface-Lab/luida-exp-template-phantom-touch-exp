    touching the NPC's head / torso / arms (edge-triggered).\nfunction detectTouch(p,
    rest, ip) {\n  const hands = [p.getHumanoidBonePosition(HumanoidBone.LeftHand),
    p.getHumanoidBonePosition(HumanoidBone.RightHand)];\n  const parts = [\n    {
    bone: HumanoidBone.Head, up: 0.07, r: 0.13 },\n    { bone: HumanoidBone.Chest,
    up: 0.0, r: 0.17 },\n    { bone: HumanoidBone.Hips, up: 0.0, r: 0.16 },\n   
    { bone: HumanoidBone.LeftUpperArm, up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.RightUpperArm,
    up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.LeftLowerArm, up: 0.0, r: 0.06
    },\n    { bone: HumanoidBone.RightLowerArm, up: 0.0, r: 0.06 },\n  ];\n  let
    touching = false;\n  for (const part of parts) {\n    const info = nodeByBone[part.bone];\n   
    if (!info) continue;\n    const gp = info.node.getGlobalPosition();\n    if (!gp)
    continue;\n    const c = vadd(gp, vscale(UP, part.up));\n    for (const h of
    hands) {\n      if (h && vlen(vsub(h, c)) < part.r + NPC_CFG.TOUCH_HAND_MARGIN)
    { touching = true; break; }\n    }\n    if (touching) break;\n  }\n  const edge
    = touching && !$.state.npc_touching;\n  $.state.npc_touching = touching;\n  return
    edge;\n}\n// Detect the participant's social signals (gaze alignment, raised
    hand) with hysteresis / edges.\nfunction detectParticipantSignals(p, head, rest,
    ip) {\n  const npcHeadW = toWorld(rest.head, ip);\n  const toNpc = vnorm(vsub(npcHeadW,
    head.pos));\n  const ang = Math.acos(Math.max(-1, Math.min(1, vdot(vnorm(head.fwd),
    toNpc)))) * 180 / Math.PI;\n  let gazeEdge = false;\n  if (!$.state.npc_gazeAligned
    && ang < NPC_CFG.LOOK_AT_DEG) { $.state.npc_gazeAligned = true; gazeEdge = true;
    }\n  else if ($.state.npc_gazeAligned && ang > NPC_CFG.LOOK_AWAY_DEG) { $.state.npc_gazeAligned
    = false; }\n\n  const lh = p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n 
    const rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n  const th = head.pos.y
    - NPC_CFG.HAND_RAISE_OFFSET;\n  const up = !!((lh && lh.y > th) || (rh && rh.y
    > th));\n  let handEdge = false;\n  if (up && !$.state.npc_handUp) { $.state.npc_handUp
    = true; handEdge = true; }\n  else if (!up && $.state.npc_handUp) { $.state.npc_handUp
    = false; }\n  return { gazeEdge: gazeEdge, handEdge: handEdge, aligned: $.state.npc_gazeAligned,
    handUp: up };\n}\n\n// ----------------------------------------------------------------
    trial control\nfunction startTrial() {\n  const rest = restGeom();\n  if (!rest)
    { $.log(\"[NPC] rest geometry not ready; trial start deferred\"); $.state.npc_pendingStart
    = true; return; }\n  $.state.npc_pendingStart = false;\n  moveToStand(0, true);                    
    // step closer to the reach spot during PREP\n  $.state.npc_phase = \"prep\";\n 
    $.state.npc_t = 0;\n  clearReaction();\n  $.state.npc_bodyTurning = false;\n 
    $.state.npc_lookedAt = false;\n  $.state.npc_lookTs = 0;\n  $.state.npc_greeted
    = false;\n  $.state.npc_trace = [];\n  traceBuf = [];\n  $.state.npc_trialStartTs
    = Date.now();\n  $.log(\"[NPC] trial start \" + JSON.stringify($.state.npc_trial
    || {}) + \" social=\" + $.state.npc_social);\n}\n\nlet traceBuf = [];\nlet sampleTimer
    = 0;\nlet baseSamples = [];\n\n// Ready palm point on the shoulder->face line
    (local). T = face target (local).\nfunction readyContact(rest, T) {\n  return
    vadd(rest.sR, vscale(vsub(T, rest.sR), NPC_CFG.READY_FRAC));\n}\n\nfunction beginApproach(head,
    rest, ip) {\n  const T = toLocal(facePointWorld(head), ip);\n  const H0 = readyContact(rest,
    T);  // local palm point; the hand is already here after the READY phase\n  const
    full = vlen(vsub(T, H0));\n  const L = Math.max(0.02, full - NPC_CFG.STOP_MARGIN);\n 
    $.state.npc_H0 = H0;\n  $.state.npc_T = T;\n  $.state.npc_L = L;\n  $.state.npc_dir
    = vnorm(vsub(T, H0));\n  const frame = reachHandFrame($.state.npc_dir);\n  $.state.npc_frame
    = frame;    // hand orientation is kept fixed during the approach\n  const Wend
    = vsub(vsub(T, vscale($.state.npc_dir, NPC_CFG.STOP_MARGIN)), palmOffset(frame));\n 
    $.state.npc_reachable = vlen(vsub(Wend, rest.sR)) <= (rest.L1 + rest.L2);\n 
    $.state.npc_phase = \"approach\";\n  $.state.npc_t = 0;\n  $.state.npc_reachStartTs
    = Date.now();\n  $.state.npc_headPos0 = vcopy(head.pos);\n  $.state.npc_headRot0
    = head.rot.x + \",\" + head.rot.y + \",\" + head.rot.z + \",\" + head.rot.w;\n 
    $.state.npc_contactTs = 0;\n  $.state.npc_contactDist = -1;\n  $.state.npc_contactT
    = 0;\n  $.state.npc_strokeEndTs = 0;\n  $.state.npc_base = null;\n  $.state.npc_away
    = 0; $.state.npc_latMin = 0; $.state.npc_latMax = 0;\n  $.state.npc_onsetDist
    = -1;\n  $.state.npc_axisW = vhoriz(qrot(ip.rot, $.state.npc_dir));\n  const
    H0w = toWorld(H0, ip), Tw = toWorld(T, ip);\n  $.state.npc_H0w = f3(H0w.x) +
    \",\" + f3(H0w.y) + \",\" + f3(H0w.z);\n  $.state.npc_Tw = f3(Tw.x) + \",\" +
    f3(Tw.y) + \",\" + f3(Tw.z);\n  baseSamples = [];\n  sampleTimer = 0;\n  $.log(\"[NPC]
    approach: path=\" + f3(L) + \" m, duration=\" + f3(L / NPC_CFG.REACH_SPEED) +
    \" s, reachable=\" + $.state.npc_reachable);\n}\n\nfunction finishTrial() {\n 
    const traces = ($.state.npc_trace || []).concat(traceBuf);\n  traceBuf = [];\n 
    const tr = $.state.npc_trial || {};\n  const data = {\n    social: $.state.npc_social
    ? \"with\" : \"without\",\n    npcBlock: tr.block !== undefined ? String(tr.block)
    : \"\",\n    npcRep: tr.rep !== undefined ? String(tr.rep) : \"\",\n    npcAvatar:
    tr.avatar !== undefined ? String(tr.avatar) : \"\",\n    trialStartTs: $.state.npc_trialStartTs
    || 0,\n    reachStartTs: $.state.npc_reachStartTs || 0,\n    contactTs: $.state.npc_contactTs
    || 0,\n    strokeEndTs: $.state.npc_strokeEndTs || 0,\n    strokeAmp: NPC_CFG.STROKE_AMP,\n   
    strokeBack: NPC_CFG.STROKE_BACK,\n    strokeCycles: NPC_CFG.STROKE_CYCLES,\n   
    strokeReturnSpeed: NPC_CFG.STROKE_RETURN_SPEED,\n    heightPlatform: $.state.npc_platformH
    || 0,\n    npcLift: $.state.npc_lift || 0,\n    retractEndTs: Date.now(),\n   
    pathLen: $.state.npc_L || 0,\n    reachDur: ($.state.npc_contactTs && $.state.npc_reachStartTs)
    ? ($.state.npc_contactTs - $.state.npc_reachStartTs) / 1000 : 0,\n    contactDist:
    $.state.npc_contactDist,\n    reachable: !!$.state.npc_reachable,\n    headPos0:
    $.state.npc_headPos0 ? (f3($.state.npc_headPos0.x) + \",\" + f3($.state.npc_headPos0.y)
    + \",\" + f3($.state.npc_headPos0.z)) : \"\",\n    headRot0: $.state.npc_headRot0
    || \"\",\n    handStart: $.state.npc_H0w || \"\",   // fingertip world position
    at approach start\n    faceTarget: $.state.npc_Tw || \"\",   // face target world
    position (fixed at approach start)\n    traceFormat: \"t,hx,hy,hz,hqx,hqy,hqz,hqw,d\",\n   
    retreatOnsetDist: $.state.npc_onsetDist,\n    retreatDist: $.state.npc_away ||
    0,\n    oscAmp: ($.state.npc_latMax || 0) - ($.state.npc_latMin || 0),\n    lookedAtNpc:
    !!$.state.npc_lookedAt,\n    lookTs: $.state.npc_lookTs || 0,\n    greeted: !!$.state.npc_greeted,\n   
    trace: traces.join(\";\"),\n  };\n  pushData(data);\n  $.state.npc_trace = [];\n 
    $.log(\"[NPC] trial done: samples=\" + traces.length + \" contactDist=\" + f3(data.contactDist)
    + \" retreat=\" + f3(data.retreatDist));\n  leave(true);\n}\n\n// Step back to
    the conversation spot, then disappear (tick); with signalDone, \"npc_done\" is
    sent once hidden.\nfunction leave(signalDone) {\n  $.state.npc_pendingStart =
    false;\n  $.state.npc_phase = \"leave\";\n  $.state.npc_t = 0;\n  $.state.npc_leaveSignal
    = !!signalDone;\n  clearReaction();\n  if (!$.state.npc_visible || !moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    true)) $.state.npc_glide = null;\n}\n\nfunction pushData(obj) {\n  try {\n   
    if ($.groupState) {\n      const cd = $.groupState.collectedData || {};\n     
    for (const k in obj) cd[k] = obj[k];\n      $.groupState.collectedData = cd;\n     
    return;\n    }\n  } catch (e) { $.log(\"[NPC] groupState write failed: \" + e);
    }\n  try {\n    const h = $.worldItemReference(\"luida-data-collector\");\n   
    if (h) h.send(\"luida_collect\", obj);\n  } catch (e) { $.log(\"[NPC] luida_collect
    send failed: \" + e); }\n}\n\n// ----------------------------------------------------------------
    pose building\n// Arm description (item-local directions): upper = shoulder->elbow,
    lower = elbow->wrist,\n// hand = wrist->fingers, palm = palm normal. Rest (T-pose,
    VRM convention): arms horizontal,\n// palms facing down, elbows flexing forward.\nconst
    PALM_DOWN = new Vector3(0, -1, 0);\n\nfunction armRots(rest, side, arm) {\n 
    const restU = side === \"R\" ? rest.axisRU : rest.axisLU;\n  const restL = side
    === \"R\" ? rest.axisRL : rest.axisLL;\n  return {\n    u: basisRot(restU, rest.fwd,
    arm.upper, arm.lower),   // elbow bends toward the forearm\n    l: basisRot(restL,
    PALM_DOWN, arm.lower, arm.palm),   // forearm twist follows the palm\n    h:
    basisRot(restL, PALM_DOWN, arm.hand, arm.palm),    // hand: fingers + palm direction\n 
    };\n}\n// Relaxed arm hanging at the side, palm facing the thigh (toward the
    body midline).\nfunction idleArm(rest, side) {\n  const R = vscale(rest.right,
    side === \"R\" ? 1 : -1), F = rest.fwd;\n  const lower = vnorm(vadd(vadd(vscale(UP,
    -0.92), vscale(F, 0.30)), vscale(R, 0.12)));\n  return {\n    upper: vnorm(vadd(vadd(vscale(UP,
    -1.0), vscale(R, 0.22)), vscale(F, 0.05))),\n    lower: lower,\n    hand: lower,\n   
    palm: vscale(R, -1),\n  };\n}\n// Left arm raised for waving: forearm up (oscillating
    sideways), palm facing the participant.\nfunction waveArm(rest, gt) {\n  const
    Lf = vscale(rest.right, -1), F = rest.fwd;\n  const upper = vnorm(vadd(vadd(vscale(UP,
    -0.4), vscale(Lf, 0.75)), vscale(F, 0.2)));\n  let lower = vnorm(vadd(vadd(vscale(UP,
    0.85), vscale(F, 0.25)), vscale(Lf, 0.2)));\n  lower = qrot(qaxis(F, 25 * Math.sin(2
    * Math.PI * 2.5 * gt)), lower);\n  return { upper: upper, lower: lower, hand:
    lower, palm: F };\n}\n// Reaching hand: fingers HAND_PITCH_DEG above horizontal,
    in the vertical plane of the approach direction d;\n// palm facing along d (toward
    the face). When the fingers point almost along d, the palm faces forward-down.\nfunction
    reachHandFrame(d) {\n  const dn = vnorm(d);\n  const horiz = vhoriz(dn);\n  const
    pitch = NPC_CFG.HAND_PITCH_DEG * Math.PI / 180;\n  const h = vnorm(vadd(vscale(horiz,
    Math.cos(pitch)), vscale(UP, Math.sin(pitch))));\n  let n = perpTo(dn, h);\n 
    if (vlen(n) < 0.2) n = perpTo(vsub(horiz, UP), h);\n  return { h: h, n: vnorm(n)
    };\n}\n// Wrist -> contact point (finger pads).\nfunction palmOffset(frame) {\n 
    return vadd(vscale(frame.h, NPC_CFG.CONTACT_LEN), vscale(frame.n, NPC_CFG.PALM_OFF));\n}\n//
    Right arm placing the palm contact point at F (local) with the given hand frame.\nfunction
    reachArm(rest, F, frame) {\n  const W = vsub(F, palmOffset(frame));\n  const
    hint = vnorm(vadd(vscale(UP, -0.8), vscale(rest.right, 0.6)));\n  const sol =
    solveArm(rest.sR, W, rest.L1, rest.L2, hint);\n  return { upper: sol.upperDir,
    lower: sol.lowerDir, hand: frame.h, palm: frame.n, frame: frame };\n}\n// Stroke
    after contact (local coordinates). Each cycle: slide down the face by STROKE_AMP
    at REACH_SPEED,\n// pull back STROKE_BACK from the face, rise while pulled back,
    touch again at the top (these three legs at\n// STROKE_RETURN_SPEED); the last
    cycle ends at the bottom of its down-stroke. Returns the waypoints and the\n//
    time at which each one is reached.\nfunction strokePath(Fc, dir) {\n  const A
    = NPC_CFG.STROKE_AMP, B = NPC_CFG.STROKE_BACK, N = NPC_CFG.STROKE_CYCLES;\n 
    const vs = NPC_CFG.REACH_SPEED, vr = NPC_CFG.STROKE_RETURN_SPEED;\n  const pts
    = [Fc], times = [0];\n  if (!(A > 0) || !(N > 0) || !(vs > 0)) return { pts:
    pts, times: times, total: 0 };\n  const down = vscale(UP, -A), back = vscale(vnorm(dir),
    -B);\n  let p = Fc, t = 0;\n  function go(q, v) { t += vlen(vsub(q, p)) / Math.max(1e-3,
    v); p = q; pts.push(q); times.push(t); }\n  for (let k = 0; k < N; k++) {\n   
    go(vadd(p, down), vs);                       // stroke down, in contact\n   
    if (k < N - 1 && vr > 0) {\n      if (B > 0) go(vadd(p, back), vr);         
    // pull back a little\n      go(vsub(p, down), vr);                     // rise\n     
    if (B > 0) go(vsub(p, back), vr);          // touch again at the top\n    }\n 
    }\n  return { pts: pts, times: times, total: t };\n}\n// Position on the stroke
    path t seconds after contact.\nfunction strokePoint(path, t) {\n  const pts =
    path.pts, times = path.times;\n  if (t <= 0 || pts.length < 2) return pts[0];\n 
    for (let i = 1; i < pts.length; i++) {\n    if (t <= times[i]) {\n      const
    u = (t - times[i - 1]) / Math.max(1e-6, times[i] - times[i - 1]);\n      return
    vlerp(pts[i - 1], pts[i], u);\n    }\n  }\n  return pts[pts.length - 1];\n}\n//
    Actual palm contact point of a solved right arm (accounts for IK clamping when
    out of reach).\nfunction contactOf(rest, arm) {\n  const W = vadd(vadd(rest.sR,
    vscale(arm.upper, rest.L1)), vscale(arm.lower, rest.L2));\n  return vadd(W, palmOffset(arm.frame));\n}\n//
    Two-bone IK for a wrist target W (local). Returns {upperDir, lowerDir}.\nfunction
    solveArm(S, W, L1, L2, bendHint) {\n  const toW = vsub(W, S);\n  let d = vlen(toW);\n 
    d = Math.max(0.03, Math.min(L1 + L2 - 0.002, d));\n  const dir = vnorm(toW);\n 
    let cosA = (L1 * L1 + d * d - L2 * L2) / (2 * L1 * d);\n  cosA = Math.max(-1,
    Math.min(1, cosA));\n  const sinA = Math.sqrt(Math.max(0, 1 - cosA * cosA));\n 
    let perp = vsub(bendHint, vscale(dir, vdot(bendHint, dir)));\n  if (vlen(perp)
    < 1e-4) perp = vcross(dir, UP);\n  perp = vnorm(perp);\n  const upperDir = vnorm(vadd(vscale(dir,
    cosA), vscale(perp, sinA)));\n  const E = vadd(S, vscale(upperDir, L1));\n  const
    lowerDir = vnorm(vsub(W, E));\n  return { upperDir: upperDir, lowerDir: lowerDir,
    elbow: E };\n}\nfunction applyPose(Q) {\n  const worldRots = {};\n  for (let
    i = 0; i < boneNodes.length; i++) {\n    const e = boneNodes[i];\n    const q
    = Q[e.bone] || IDENT;\n    worldRots[e.bone] = q;\n    const parentQ = (e.parentBone
    === null || worldRots[e.parentBone] === undefined) ? IDENT : worldRots[e.parentBone];\n   
    const desired = qmul(q, e.rest);\n    const parent = qmul(parentQ, e.restParent);\n   
    e.node.setRotation(qmul(qinv(parent), desired));\n  }\n}\n\n// ----------------------------------------------------------------
    per-frame\n$.onUpdate((deltaTime) => {\n  try { tick(deltaTime); } catch (e)
    { $.log(\"[NPC] tick error: \" + e); }\n});\n\nfunction tick(dt) {\n  $.state.npc_clock
    = ($.state.npc_clock || 0) + dt;\n  if (boneNodes.length === 0) cacheBones();\n 
    const rest = restGeom();\n  if (!rest) return;                       // keep
    the model visible until the rest pose is measured\n\n  // Visibility: hidden
    until shown (also re-applied after a script reload).\n  if ($.state.npc_visibilityApplied
    !== !!$.state.npc_visible) applyVisibility();\n\n  if ($.state.npc_heightPending)
    tryHeightMatch();\n\n  if ($.state.npc_pendingStart) {\n    $.state.npc_startDelay
    = ($.state.npc_startDelay || 0) - dt;\n    if ($.state.npc_startDelay <= 0) startTrial();\n   
    return;\n  }\n\n  // Glide to the target standing pose (position/rotation are
    networked, so keep it short).\n  const g = $.state.npc_glide;\n  if (g) {\n   
    const t = clamp01((g.t || 0) + dt / NPC_CFG.GLIDE_SEC);\n    const e = easeInOut(t);\n   
    $.setPosition(vlerp(g.fromPos, g.toPos, e));\n    $.setRotation(qslerp(g.fromRot,
    g.toRot, e));\n    if (t >= 1) $.state.npc_glide = null; else { g.t = t; $.state.npc_glide
    = g; }\n  }\n\n  // Back at the conversation spot after a trial: disappear (out
    of the way of the report panel and the\n  // questionnaires), then let the director
    move on.\n  if ($.state.npc_phase === \"leave\" && !$.state.npc_glide) {\n   
    $.state.npc_phase = \"idle\";\n    $.state.npc_t = 0;\n    setVisible(false);\n   
    if ($.state.npc_leaveSignal) $.sendSignalCompat(\"this\", \"npc_done\");\n   
    $.state.npc_leaveSignal = false;\n    $.log(\"[NPC] back at the conversation
    spot; hidden\");\n    return;\n  }\n\n  if (!$.state.npc_visible) return;       
    // nothing to animate while hidden\n\n  const p = participant();\n  const head
    = p ? headOf(p) : null;\n  let ip = itemPose();\n  const social = !!$.state.npc_social;\n 
    const phase = $.state.npc_phase || \"idle\";\n  const greeting = $.state.npc_mode
    === \"greeting\";\n  if (greeting && social && head && !$.state.npc_glide) ip
    = turnBodyToward(head, restGeom(), ip, dt);\n  let t = ($.state.npc_t || 0) +
    dt;\n  $.state.npc_t = t;\n\n  const Q = {};\n  const R = rest.right, F = rest.fwd;\n\n 
    // --- torso / idle motion (social only) ---\n  if (social) {\n    const breathe
    = Math.sin(2 * Math.PI * 0.25 * (Date.now() / 1000)) * 1.0;\n    Q[HumanoidBone.Chest]
    = qaxis(R, breathe);\n    if (phase === \"approach\" || phase === \"stroke\"
    || phase === \"hold\") Q[HumanoidBone.Spine] = qaxis(R, 5);\n  }\n\n  // ---
    gaze (social only): head (and eyes) only; large angles are taken up by the body
    turn above,\n  //     which also unwinds the head's local rotation as the body
    comes around ---\n  if (social && head) {\n    const dir = vnorm(vsub(toLocal(head.pos,
    ip), rest.head));\n    const qFull = qfromTo(F, dir);\n    const qHead = qclamp(qFull,
    NPC_CFG.HEAD_MAX_DEG);\n    const qEye = qmul(qHead, qclamp(qmul(qinv(qHead),
    qFull), NPC_CFG.EYE_EXTRA_DEG));\n    Q[HumanoidBone.Head] = qHead;\n    Q[HumanoidBone.LeftEye]
    = qEye;\n    Q[HumanoidBone.RightEye] = qEye;\n  }\n\n  // --- participant signals:
    greeting period (reactive), trial prep (logging + one greeting) ---\n  if (head
    && (greeting || phase === \"prep\" || phase === \"approach\")) {\n    const sig
    = detectParticipantSignals(p, head, rest, ip);\n    if (greeting) {\n      if
    (sig.gazeEdge) { $.state.npc_gGaze = ($.state.npc_gGaze || 0) + 1; if (social)
    startReaction(\"gaze\"); }\n      if (sig.handEdge) { $.state.npc_gHand = ($.state.npc_gHand
    || 0) + 1; if (social) startReaction(\"hand\"); }\n      if (social && p && detectTouch(p,
    rest, ip)) surprise();\n    } else if (sig.aligned && !$.state.npc_lookedAt)
    {\n      $.state.npc_lookedAt = true;\n      $.state.npc_lookTs = Date.now();\n     
    if (social && phase === \"prep\" && !$.state.npc_react) { startReaction(\"prep\",
    true); $.state.npc_greeted = true; }\n    }\n  }\n  // greeting, social: nothing
    has triggered a reaction for a while -> nod and smile once\n  if (greeting &&
    social && !$.state.npc_react &&\n      nowSec() - ($.state.npc_lastReactEnd ||
    0) >= NPC_CFG.IDLE_REACT_SEC) startReaction(\"idle\");\n\n  // --- arms (bone
    rotations incl. twist, so the palms face the right way) ---\n  const idleR =
    armRots(rest, \"R\", idleArm(rest, \"R\"));\n  const idleL = armRots(rest, \"L\",
    idleArm(rest, \"L\"));\n  let armR = idleR, armL = idleL;\n\n  // reaction gesture
    (nod and/or left-hand wave with the palm toward the participant), social only\n 
    let nodDeg = 0;\n  const react = $.state.npc_react;\n  if (social && react) {\n   
    const rt = (react.t || 0) + dt;\n    if (react.wave) {\n      const lift = Math.sin(Math.PI
    * clamp01(rt / react.dur));     // 0 -> 1 -> 0\n      armL = slerpArm(idleL,
    armRots(rest, \"L\", waveArm(rest, rt)), lift);\n    }\n    if (react.nod) {\n     
    const nodSec = react.wave ? 0.6 : NPC_CFG.NOD_SEC;\n      nodDeg = NPC_CFG.NOD_DEG
    * Math.sin(Math.PI * clamp01(rt / nodSec));\n    }\n    if (rt >= react.dur)
    clearReaction(); else { react.t = rt; $.state.npc_react = react; }\n  } else
    if (react && !social) {\n    clearReaction();\n  }\n\n  // --- phase machine
    for the right arm ---\n  if (phase === \"prep\") {\n    const greetBusy = social
    && $.state.npc_react;\n    if (t >= NPC_CFG.PREP_SEC && !greetBusy && head &&
    !$.state.npc_glide) {\n      // social: if the participant never looked, greet
    once before raising the hand\n      if (social && !$.state.npc_greeted) { $.state.npc_greeted
    = true; startReaction(\"prep\", true); }\n      else { $.state.npc_phase = \"ready\";
    $.state.npc_t = 0; }\n    }\n  } else if (phase === \"ready\") {\n    // raise
    the hand from the idle pose to the ready position, palm already turned toward
    the\n    // participant's face (fast; the stimulus starts afterwards)\n    const
    T = head ? toLocal(facePointWorld(head), ip) : vadd(rest.sR, vadd(vscale(rest.fwd,
    0.4), vscale(UP, 0.2)));\n    const H0 = readyContact(rest, T);\n    const readyArm
    = armRots(rest, \"R\", reachArm(rest, H0, reachHandFrame(vsub(T, H0))));\n   
    armR = slerpArm(idleR, readyArm, easeInOut(t / NPC_CFG.READY_SEC));\n    if (t
    >= NPC_CFG.READY_SEC && head) beginApproach(head, rest, ip);\n  } else if (phase
    === \"approach\") {\n    const L = $.state.npc_L, dir = $.state.npc_dir, H0 =
    $.state.npc_H0;\n    const frame = $.state.npc_frame || reachHandFrame(dir);\n   
    const s = Math.min(NPC_CFG.REACH_SPEED * t, L);\n    const Ft = vadd(H0, vscale(dir,
    s));\n    const arm = reachArm(rest, Ft, frame);\n    armR = armRots(rest, \"R\",
    arm);\n    const Fw = toWorld(contactOf(rest, arm), ip);\n    let d = -1;\n   
    if (head) {\n      d = vlen(vsub(Fw, facePointWorld(head)));\n      sampleTrace(dt,
    t, head, Fw, d);\n    }\n    const reachedEnd = s >= L;\n    const earlyContact
    = d >= 0 && d <= NPC_CFG.STOP_MARGIN;\n    if (reachedEnd || earlyContact) {\n     
    $.state.npc_contactTs = Date.now();\n      $.state.npc_contactDist = d;\n     
    $.state.npc_contactT = t;\n      $.state.npc_Fc = Ft;\n      $.state.npc_strokeSec
    = strokePath(Ft, dir).total;\n      $.state.npc_Fhold = Ft;\n      $.state.npc_phase
    = \"stroke\";\n      $.state.npc_t = 0;\n      $.log(\"[NPC] contact: d=\" +
    f3(d) + \" early=\" + earlyContact + \", stroking for \" + f3($.state.npc_strokeSec)
    + \" s\");\n    }\n  } else if (phase === \"stroke\") {\n    // gently stroke
    the face along strokePath(): down in contact, pull back, rise, touch again (same
    hand\n    // orientation as the approach)\n    const Fc = $.state.npc_Fc || $.state.npc_T;\n   
    const dur = $.state.npc_strokeSec || 0;\n    const Fs = strokePoint(strokePath(Fc,
    $.state.npc_dir), Math.min(t, dur));\n    const arm = reachArm(rest, Fs, $.state.npc_frame
    || reachHandFrame($.state.npc_dir));\n    armR = armRots(rest, \"R\", arm);\n   
    if (head) {\n      const Fw = toWorld(contactOf(rest, arm), ip);\n      sampleTrace(dt,
    ($.state.npc_contactT || 0) + t, head, Fw, vlen(vsub(Fw, facePointWorld(head))));\n   
    }\n    if (social) nodDeg = Math.max(nodDeg, 10 * Math.sin(Math.PI * clamp01(t
    / 1.0)));\n    if (t >= dur) {\n      $.state.npc_strokeEndTs = Date.now();\n     
    $.state.npc_Fhold = Fs;              // rest where the last stroke ended\n     
    $.state.npc_phase = \"hold\";\n      $.state.npc_t = 0;\n    }\n  } else if (phase
    === \"hold\") {\n    const Fc = $.state.npc_Fhold || $.state.npc_Fc || $.state.npc_T;\n   
    const arm = reachArm(rest, Fc, $.state.npc_frame || reachHandFrame($.state.npc_dir));\n   
    armR = armRots(rest, \"R\", arm);\n    const sinceContact = ($.state.npc_strokeSec
    || 0) + t;\n    if (head) {\n      const Fw = toWorld(contactOf(rest, arm), ip);\n     
    sampleTrace(dt, ($.state.npc_contactT || 0) + sinceContact, head, Fw, vlen(vsub(Fw,
    facePointWorld(head))));\n    }\n    if (social) nodDeg = Math.max(nodDeg, 10
    * Math.sin(Math.PI * clamp01(sinceContact / 1.0)));\n    if (t >= NPC_CFG.HOLD_SEC)
    {\n      $.state.npc_phase = \"retract\";\n      $.state.npc_t = 0;\n      //
    duration from the distance back toward the ready point at RETRACT_SPEED (+0.8
    s to settle)\n      $.state.npc_retractSec = vlen(vsub(Fc, $.state.npc_H0)) /
    NPC_CFG.RETRACT_SPEED + 0.8;\n    }\n  } else if (phase === \"retract\") {\n   
    // blend the joint rotations from the hold pose back to the relaxed arm\n   
    const Fc = $.state.npc_Fhold || $.state.npc_Fc || $.state.npc_T;\n    const holdArm
    = armRots(rest, \"R\", reachArm(rest, Fc, $.state.npc_frame || reachHandFrame($.state.npc_dir)));\n   
    const u = clamp01(t / Math.max(0.5, $.state.npc_retractSec || 2.0));\n    armR
    = slerpArm(holdArm, idleR, easeInOut(u));\n    if (u >= 1) finishTrial();\n 
    }\n\n  // nod composes with gaze\n  if (nodDeg !== 0) {\n    const qNod = qaxis(R,
    nodDeg);\n    Q[HumanoidBone.Head] = qmul(Q[HumanoidBone.Head] || IDENT, qNod);\n 
    }\n\n  Q[HumanoidBone.RightUpperArm] = armR.u;\n  Q[HumanoidBone.RightLowerArm]
    = armR.l;\n  Q[HumanoidBone.RightHand] = armR.h;\n  Q[HumanoidBone.LeftUpperArm]
    = armL.u;\n  Q[HumanoidBone.LeftLowerArm] = armL.l;\n  Q[HumanoidBone.LeftHand]
    = armL.h;\n\n  applyPose(Q);\n}\n\n// 10 Hz head trace plus the in-world retreat
    estimate.\nfunction sampleTrace(dt, t, head, Fw, d) {\n  sampleTimer += dt;\n 
    if (sampleTimer < NPC_CFG.SAMPLE_INTERVAL) return;\n  sampleTimer = 0;\n  const
    h = head.pos, r = head.rot;\n  const total = ($.state.npc_trace || []).length
    + traceBuf.length;\n  if (total < NPC_CFG.MAX_SAMPLES) {\n    traceBuf.push([t.toFixed(1),
    f3(h.x), f3(h.y), f3(h.z), f3(r.x), f3(r.y), f3(r.z), f3(r.w), f3(d)].join(\",\"));\n 
    }\n  if (traceBuf.length >= 10) {\n    $.state.npc_trace = ($.state.npc_trace
    || []).concat(traceBuf);\n    traceBuf = [];\n  }\n  // retreat / oscillation
    estimate (world frame)\n  if (!$.state.npc_base) {\n    baseSamples.push(vcopy(h));\n   
    if (t >= 1.0) {\n      let sum = v3(0, 0, 0);\n      for (const b of baseSamples)
    sum = vadd(sum, b);\n      $.state.npc_base = vscale(sum, 1 / Math.max(1, baseSamples.length));\n   
    }\n    return;\n  }\n  const axis = $.state.npc_axisW || v3(0, 0, 1);\n  const
    delta = vsub(h, $.state.npc_base);\n  const away = -vdot(delta, axis);\n  const
    lateral = vdot(delta, vcross(axis, UP));\n  if (away > ($.state.npc_away || 0))
    $.state.npc_away = away;\n  if (lateral < ($.state.npc_latMin || 0)) $.state.npc_latMin
    = lateral;\n  if (lateral > ($.state.npc_latMax || 0)) $.state.npc_latMax = lateral;\n 
    if ($.state.npc_onsetDist < 0 && away > NPC_CFG.RETREAT_THRESHOLD) $.state.npc_onsetDist
    = d;\n}\n"
