    = 0;\n  $.state.npc_bodyTurning = false;\n  clearReaction();\n  $.log(\"[NPC]
    greeting begin social=\" + $.state.npc_social);\n}\nfunction endGreeting() {\n 
    if ($.state.npc_mode !== \"greeting\") return;\n  $.state.npc_mode = \"none\";\n 
    $.state.npc_bodyTurning = false;\n  pushData({\n    greetSec: (Date.now() - ($.state.npc_greetStartTs
    || Date.now())) / 1000,\n    greetGazeEvents: $.state.npc_gGaze || 0,\n    greetHandRaises:
    $.state.npc_gHand || 0,\n    greetNpcReactions: $.state.npc_gReact || 0,\n   
    greetNpcNods: $.state.npc_gNods || 0,\n    greetNpcWaves: $.state.npc_gWaves
    || 0,\n    greetNpcSmiles: $.state.npc_smiles || 0,\n    greetTouches: $.state.npc_gTouch
    || 0,\n    greetNpcIdleReactions: $.state.npc_gIdle || 0,\n  });\n  $.log(\"[NPC]
    greeting end: gaze=\" + ($.state.npc_gGaze || 0) + \" hands=\" + ($.state.npc_gHand
    || 0) +\n        \" reactions=\" + ($.state.npc_gReact || 0) + \" touches=\"
    + ($.state.npc_gTouch || 0));\n}\n// Start a reaction to the participant. source:
    \"gaze\" | \"hand\" | \"prep\" | \"idle\".\n//   first reaction of the greeting
    period (and \"prep\"): nod + wave, smiling;\n//   gaze: nod only / wave only
    / both at random; hand raise: wave, with or without a nod;\n//   smiling with
    probability JOY_PROB. The face returns to neutral when the reaction ends.\n//  
    idle (no reaction for IDLE_REACT_SEC): nod + smile, no wave; does not count as
    the first reaction.\nfunction startReaction(source, force) {\n  const now = nowSec();\n 
    if ($.state.npc_react) return false;\n  const idle = source === \"idle\";\n 
    if (!force && !idle && now - ($.state.npc_lastReact || 0) < NPC_CFG.REACT_COOLDOWN_SEC)
    return false;\n  const first = !idle && (force || !$.state.npc_reacted);\n  let
    nod, wave;\n  if (idle) { nod = true; wave = false; }\n  else if (first) { nod
    = true; wave = true; }\n  else if (source === \"hand\") { wave = true; nod =
    Math.random() < 0.5; }\n  else { const r = Math.floor(Math.random() * 3); nod
    = r !== 1; wave = r !== 0; }   // 0 nod, 1 wave, 2 both\n  const joy = idle ||
    first || Math.random() < NPC_CFG.JOY_PROB;\n  $.state.npc_react = { t: 0, nod:
    nod, wave: wave, joy: joy, dur: wave ? NPC_CFG.WAVE_SEC : NPC_CFG.NOD_SEC };\n 
    // the idle nod neither counts as the first reaction nor starts the cooldown,
    so a greeting right after it\n  // is still answered\n  if (idle) $.state.npc_gIdle
    = ($.state.npc_gIdle || 0) + 1;\n  else { $.state.npc_reacted = true; $.state.npc_lastReact
    = now; }\n  $.state.npc_gReact = ($.state.npc_gReact || 0) + 1;\n  if (nod) $.state.npc_gNods
    = ($.state.npc_gNods || 0) + 1;\n  if (wave) $.state.npc_gWaves = ($.state.npc_gWaves
    || 0) + 1;\n  setJoy(joy);\n  return true;\n}\n// Rotate the whole body toward
    the participant when they are too far to the side (greeting only).\nfunction
    turnBodyToward(head, rest, ip, dt) {\n  const faceDir = vhoriz(vsub(head.pos,
    ip.pos));\n  const curFwd = vhoriz(qrot(ip.rot, rest.fwd));\n  const cosA = Math.max(-1,
    Math.min(1, vdot(curFwd, faceDir)));\n  const ang = Math.acos(cosA) * 180 / Math.PI;\n 
    if (!$.state.npc_bodyTurning && ang > NPC_CFG.BODY_TURN_START_DEG) $.state.npc_bodyTurning
    = true;\n  if (!$.state.npc_bodyTurning) return ip;\n  if (ang < NPC_CFG.BODY_TURN_STOP_DEG)
    { $.state.npc_bodyTurning = false; return ip; }\n  const yaw = cosA < -0.999
    ? qaxis(UP, 180) : qfromTo(curFwd, faceDir);\n  const target = qmul(yaw, ip.rot);\n 
    const rot = qslerp(ip.rot, target, 1 - Math.exp(-NPC_CFG.BODY_TURN_RATE * dt));\n 
    $.setRotation(rot);\n  return { pos: ip.pos, rot: rot };\n}\n// Participant hand(s)
    touching the NPC's head / torso / arms (edge-triggered).\nfunction detectTouch(p,
    rest, ip) {\n  const hands = [p.getHumanoidBonePosition(HumanoidBone.LeftHand),
    p.getHumanoidBonePosition(HumanoidBone.RightHand)];\n  const parts = [\n    {
    bone: HumanoidBone.Head, up: 0.07, r: 0.13 },\n    { bone: HumanoidBone.Chest,
    up: 0.0, r: 0.17 },\n    { bone: HumanoidBone.Hips, up: 0.0, r: 0.16 },\n   
    { bone: HumanoidBone.LeftUpperArm, up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.RightUpperArm,
    up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.LeftLowerArm, up: 0.0, r: 0.06
    },\n    { bone: HumanoidBone.RightLowerArm, up: 0.0, r: 0.06 },\n  ];\n  let
    touching = false;\n  for (const part of parts) {\n    const info = nodeByBone[part.bone];\n   
    if (!info) continue;\n    const gp = info.node.getGlobalPosition();\n    if (!gp)
    continue;\n    const c = vadd(gp, vscale(UP, part.up));\n    for (const h of
    hands) {\n      if (h && vlen(vsub(h, c)) < part.r + NPC_CFG.TOUCH_HAND_MARGIN)
    { touching = true; break; }\n    }\n    if (touching) break;\n  }\n  const edge
    = touching && !$.state.npc_touching;\n  $.state.npc_touching = touching;\n  return
    edge;\n}\n// Detect the participant's social signals (gaze alignment, raised
    hand) with hysteresis / edges.\nfunction detectParticipantSignals(p, head, rest,
    ip) {\n  const npcHeadW = toWorld(rest.head, ip);\n  const toNpc = vnorm(vsub(npcHeadW,
    head.pos));\n  const ang = Math.acos(Math.max(-1, Math.min(1, vdot(vnorm(head.fwd),
    toNpc)))) * 180 / Math.PI;\n  let gazeEdge = false;\n  if (!$.state.npc_gazeAligned
    && ang < NPC_CFG.LOOK_AT_DEG) { $.state.npc_gazeAligned = true; gazeEdge = true;
    }\n  else if ($.state.npc_gazeAligned && ang > NPC_CFG.LOOK_AWAY_DEG) { $.state.npc_gazeAligned
    = false; }\n\n  const lh = p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n 
    const rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n  const th = head.pos.y
    - NPC_CFG.HAND_RAISE_OFFSET;\n  const up = !!((lh && lh.y > th) || (rh && rh.y
    > th));\n  let handEdge = false;\n  if (up && !$.state.npc_handUp) { $.state.npc_handUp
    = true; handEdge = true; }\n  else if (!up && $.state.npc_handUp) { $.state.npc_handUp
    = false; }\n  return { gazeEdge: gazeEdge, handEdge: handEdge, aligned: $.state.npc_gazeAligned,
    handUp: up };\n}\n\n// ----------------------------------------------------------------
    trial control\nfunction startTrial() {\n  const rest = restGeom();\n  if (!rest)
    { $.log(\"[NPC] rest geometry not ready; trial start deferred\"); $.state.npc_pendingStart
    = true; return; }\n  $.state.npc_pendingStart = false;\n  moveToStand(0, true);                    
    // step closer to the reach spot during PREP\n  $.state.npc_phase = \"prep\";\n 
    $.state.npc_t = 0;\n  clearReaction();\n  $.state.npc_bodyTurning = false;\n 
    $.state.npc_lookedAt = false;\n  $.state.npc_lookTs = 0;\n  $.state.npc_greeted
    = false;\n  $.state.npc_trace = [];\n  traceBuf = [];\n  $.state.npc_trialStartTs
    = Date.now();\n  $.log(\"[NPC] trial start \" + JSON.stringify($.state.npc_trial
    || {}) + \" social=\" + $.state.npc_social);\n}\n\nlet traceBuf = [];\nlet sampleTimer
    = 0;\nlet baseSamples = [];\n\n// Ready pose of the touch (local): contact point
    beside the participant's face, touching hand frame.\nfunction readyTouch(head,
    ip) {\n  const Tw = facePointWorld(head);\n  return { T: toLocal(Tw, ip), H0:
    toLocal(readyContactWorld(head, Tw), ip), frame: frameToLocal(touchHandFrameWorld(head),
    ip) };\n}\n\nfunction beginApproach(head, rest, ip) {\n  const rt = readyTouch(head,
    ip);\n  const T = rt.T, H0 = rt.H0;   // local contact points; the hand is already
    at H0 after the READY phase\n  const full = vlen(vsub(T, H0));\n  const L = Math.max(0.02,
    full - NPC_CFG.STOP_MARGIN);\n  $.state.npc_H0 = H0;\n  $.state.npc_T = T;\n 
    $.state.npc_L = L;\n  $.state.npc_dir = vnorm(vsub(T, H0));\n  const frame =
    rt.frame;\n  $.state.npc_frame = frame;    // hand orientation is kept fixed
    from here on\n  const Wend = vsub(vsub(T, vscale($.state.npc_dir, NPC_CFG.STOP_MARGIN)),
    palmOffset(rest, frame));\n  $.state.npc_reachable = vlen(vsub(Wend, rest.sR))
    <= (rest.L1 + rest.L2);\n  $.state.npc_phase = \"approach\";\n  $.state.npc_t
    = 0;\n  $.state.npc_reachStartTs = Date.now();\n  $.state.npc_headPos0 = vcopy(head.pos);\n 
    $.state.npc_headRot0 = head.rot.x + \",\" + head.rot.y + \",\" + head.rot.z +
    \",\" + head.rot.w;\n  $.state.npc_contactTs = 0;\n  $.state.npc_contactDist
    = -1;\n  $.state.npc_contactT = 0;\n  $.state.npc_strokeEndTs = 0;\n  $.state.npc_base
    = null;\n  $.state.npc_away = 0; $.state.npc_latMin = 0; $.state.npc_latMax =
    0;\n  $.state.npc_onsetDist = -1;\n  $.state.npc_axisW = vhoriz(qrot(ip.rot,
    $.state.npc_dir));\n  const H0w = toWorld(H0, ip), Tw = toWorld(T, ip);\n  $.state.npc_H0w
    = f3(H0w.x) + \",\" + f3(H0w.y) + \",\" + f3(H0w.z);\n  $.state.npc_Tw = f3(Tw.x)
    + \",\" + f3(Tw.y) + \",\" + f3(Tw.z);\n  baseSamples = [];\n  sampleTimer =
    0;\n  $.log(\"[NPC] approach: path=\" + f3(L) + \" m, duration=\" + f3(L / NPC_CFG.REACH_SPEED)
    + \" s, reachable=\" + $.state.npc_reachable);\n}\n\nfunction finishTrial() {\n 
    const traces = ($.state.npc_trace || []).concat(traceBuf);\n  traceBuf = [];\n 
    const tr = $.state.npc_trial || {};\n  const data = {\n    social: $.state.npc_social
    ? \"with\" : \"without\",\n    npcBlock: tr.block !== undefined ? String(tr.block)
    : \"\",\n    npcRep: tr.rep !== undefined ? String(tr.rep) : \"\",\n    npcAvatar:
    tr.avatar !== undefined ? String(tr.avatar) : \"\",\n    trialStartTs: $.state.npc_trialStartTs
    || 0,\n    reachStartTs: $.state.npc_reachStartTs || 0,\n    contactTs: $.state.npc_contactTs
    || 0,\n    strokeEndTs: $.state.npc_strokeEndTs || 0,\n    strokeAmp: NPC_CFG.STROKE_AMP,\n   
    strokeBack: NPC_CFG.STROKE_BACK,\n    strokeCycles: NPC_CFG.STROKE_CYCLES,\n   
    strokeReturnSpeed: NPC_CFG.STROKE_RETURN_SPEED,\n    strokeRampSec: NPC_CFG.STROKE_RAMP_SEC,\n   
    npcStandAz: NPC_CFG.TOUCH_STAND_AZ_DEG,\n    touchSide: \"right\",\n    fingerCurl:
    fingerCurlLabel(),\n    heightPlatform: $.state.npc_platformH || 0,\n    npcLift:
    $.state.npc_lift || 0,\n    retractEndTs: Date.now(),\n    pathLen: $.state.npc_L
    || 0,\n    reachDur: ($.state.npc_contactTs && $.state.npc_reachStartTs) ? ($.state.npc_contactTs
    - $.state.npc_reachStartTs) / 1000 : 0,\n    contactDist: $.state.npc_contactDist,\n   
    reachable: !!$.state.npc_reachable,\n    headPos0: $.state.npc_headPos0 ? (f3($.state.npc_headPos0.x)
    + \",\" + f3($.state.npc_headPos0.y) + \",\" + f3($.state.npc_headPos0.z)) :
    \"\",\n    headRot0: $.state.npc_headRot0 || \"\",\n    handStart: $.state.npc_H0w
    || \"\",   // contact point (finger pads) world position at approach start\n   
    faceTarget: $.state.npc_Tw || \"\",   // face target world position (fixed at
    approach start)\n    traceFormat: \"t,hx,hy,hz,hqx,hqy,hqz,hqw,d\",\n    retreatOnsetDist:
    $.state.npc_onsetDist,\n    retreatDist: $.state.npc_away || 0,\n    oscAmp:
    ($.state.npc_latMax || 0) - ($.state.npc_latMin || 0),\n    lookedAtNpc: !!$.state.npc_lookedAt,\n   
    lookTs: $.state.npc_lookTs || 0,\n    greeted: !!$.state.npc_greeted,\n    trace:
    traces.join(\";\"),\n  };\n  pushData(data);\n  $.state.npc_trace = [];\n  $.log(\"[NPC]
    trial done: samples=\" + traces.length + \" contactDist=\" + f3(data.contactDist)
    + \" retreat=\" + f3(data.retreatDist));\n  leave(true);\n}\n\n// Step back to
    the conversation spot, then disappear (tick); with signalDone, \"npc_done\" is
    sent once hidden.\nfunction leave(signalDone) {\n  $.state.npc_pendingStart =
    false;\n  $.state.npc_phase = \"leave\";\n  $.state.npc_t = 0;\n  $.state.npc_leaveSignal
    = !!signalDone;\n  clearReaction();\n  if (!$.state.npc_visible || !moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    true)) $.state.npc_glide = null;\n}\n\nfunction pushData(obj) {\n  try {\n   
    if ($.groupState) {\n      const cd = $.groupState.collectedData || {};\n     
    for (const k in obj) cd[k] = obj[k];\n      $.groupState.collectedData = cd;\n     
    return;\n    }\n  } catch (e) { $.log(\"[NPC] groupState write failed: \" + e);
    }\n  try {\n    const h = $.worldItemReference(\"luida-data-collector\");\n   
    if (h) h.send(\"luida_collect\", obj);\n  } catch (e) { $.log(\"[NPC] luida_collect
    send failed: \" + e); }\n}\n\n// ----------------------------------------------------------------
    pose building\n// Arm description (item-local directions): upper = shoulder->elbow,
    lower = elbow->wrist,\n// hand = wrist->fingers, palm = palm normal. Rest (T-pose,
    VRM convention): arms horizontal,\n// palms facing down, elbows flexing forward.\nconst
    PALM_DOWN = new Vector3(0, -1, 0);\n\nfunction armRots(rest, side, arm) {\n 
    const restU = side === \"R\" ? rest.axisRU : rest.axisLU;\n  const restL = side
    === \"R\" ? rest.axisRL : rest.axisLL;\n  return {\n    u: basisRot(restU, rest.fwd,
    arm.upper, arm.lower),   // elbow bends toward the forearm\n    l: basisRot(restL,
    PALM_DOWN, arm.lower, arm.palm),   // forearm twist follows the palm\n    h:
    basisRot(restL, PALM_DOWN, arm.hand, arm.palm),    // hand: fingers + palm direction\n 
    };\n}\n// Relaxed arm hanging at the side, palm facing the thigh (toward the
    body midline).\nfunction idleArm(rest, side) {\n  const R = vscale(rest.right,
    side === \"R\" ? 1 : -1), F = rest.fwd;\n  const lower = vnorm(vadd(vadd(vscale(UP,
    -0.92), vscale(F, 0.30)), vscale(R, 0.12)));\n  return {\n    upper: vnorm(vadd(vadd(vscale(UP,
    -1.0), vscale(R, 0.22)), vscale(F, 0.05))),\n    lower: lower,\n    hand: lower,\n   
    palm: vscale(R, -1),\n  };\n}\n// Arm raised for waving (side \"L\" or \"R\"):
    forearm up (oscillating sideways), palm facing forward (the participant\n// in
    the greeting; the mirror in the touch layout).\nfunction waveArm(rest, gt, side)
    {\n  const Lf = vscale(rest.right, side === \"R\" ? 1 : -1), F = rest.fwd;\n 
    const upper = vnorm(vadd(vadd(vscale(UP, -0.4), vscale(Lf, 0.75)), vscale(F,
    0.2)));\n  let lower = vnorm(vadd(vadd(vscale(UP, 0.85), vscale(F, 0.25)), vscale(Lf,
    0.2)));\n  lower = qrot(qaxis(F, 25 * Math.sin(2 * Math.PI * 2.5 * gt)), lower);\n 
    return { upper: upper, lower: lower, hand: lower, palm: F };\n}\n// Frontal reaching
    hand (greeting distance only): fingers HAND_PITCH_DEG above horizontal, in the
    vertical plane of\n// the approach direction d; palm facing along d (toward the
    face).\nfunction reachHandFrame(d) {\n  const dn = vnorm(d);\n  const horiz =
    vhoriz(dn);\n  const pitch = NPC_CFG.HAND_PITCH_DEG * Math.PI / 180;\n  const
    h = vnorm(vadd(vscale(horiz, Math.cos(pitch)), vscale(UP, Math.sin(pitch))));\n 
    let n = perpTo(dn, h);\n  if (vlen(n) < 0.2) n = perpTo(vsub(horiz, UP), h);\n 
    return { h: h, n: vnorm(n) };\n}\n// Wrist -> contact point of a straight hand
    (greeting distance only).\nfunction straightPalmOffset(frame) {\n  return vadd(vscale(frame.h,
    NPC_CFG.CONTACT_LEN), vscale(frame.n, NPC_CFG.PALM_OFF));\n}\n// Wrist -> contact
    point of the touching hand (curled fingers, rest.contact) for a hand frame {h:
    fingers, n: palm\n// normal}; the thumb side is n x h. Works in any frame (local
    or world) the directions are given in.\nfunction palmOffset(rest, frame) {\n 
    const c = rest.contact || { a: NPC_CFG.CONTACT_LEN, b: NPC_CFG.PALM_OFF, c: 0
    };\n  const t = vcross(frame.n, frame.h);\n  return vadd(vadd(vscale(frame.h,
    c.a), vscale(frame.n, c.b)), vscale(t, c.c));\n}\n// Right-hand finger rotations
    (normalized, item-local) for hand rotation qHand and curl weight w (0 = straight,\n//
    1 = FINGER_CURL). Every listed finger bone is set, also when straight: applyPose
    gives bones missing from Q the\n// identity rotation in the item frame, not their
    parent's.\nfunction setFingerRots(Q, rest, qHand, w) {\n  const fingers = rest.fingers
    || [];\n  for (const f of fingers) {\n    const bones = R_FINGERS[f.i].bones;\n   
    let q = qHand;\n    for (let k = 0; k < 3; k++) {\n      q = qmul(q, qaxis(f.axis,
    (f.curl[k] || 0) * w));\n      Q[bones[k]] = q;\n    }\n  }\n}\n// FINGER_CURL
    as a data label (\"none\" without finger bones), e.g. \"T0-10-10 I10-15-10 M20-25-15
    R30-30-20 L40-35-25\".\nfunction fingerCurlLabel() {\n  const rest = $.state.npc_rest;\n 
    if (!rest || !rest.fingers || rest.fingers.length === 0) return \"none\";\n 
    return rest.fingers.map(f => R_FINGERS[f.i].name.charAt(0) + f.curl.join(\"-\")).join(\"
    \");\n}\n// Right arm placing the hand's contact point at F (local) with the
    given hand frame.\nfunction reachArm(rest, F, frame) {\n  const W = vsub(F, palmOffset(rest,
    frame));\n  const hint = vnorm(vadd(vscale(UP, -0.8), vscale(rest.right, 0.6)));\n 
    const sol = solveArm(rest.sR, W, rest.L1, rest.L2, hint);\n  return { upper:
    sol.upperDir, lower: sol.lowerDir, hand: frame.h, palm: frame.n, frame: frame
    };\n}\n// Time to travel a leg of length L from rest to rest: accelerate for
    r seconds to the speed v, decelerate for r.\nfunction legDuration(L, v, r) {\n 
    v = Math.max(1e-3, v);\n  if (!(r > 0)) return L / v;\n  return L >= v * r ?
    L / v + r : 2 * Math.sqrt(L * r / v);\n}\n// Distance covered t seconds into
    such a leg.\nfunction legDistance(L, v, r, t) {\n  v = Math.max(1e-3, v);\n 
    const T = legDuration(L, v, r);\n  if (t <= 0) return 0;\n  if (t >= T) return
    L;\n  if (!(r > 0)) return v * t;\n  const a = v / r, ta = Math.min(r, T / 2);\n 
    if (t < ta) return 0.5 * a * t * t;\n  if (t > T - ta) { const u = T - t; return
    L - 0.5 * a * u * u; }\n  return 0.5 * a * ta * ta + a * ta * (t - ta);\n}\n//
    Stroke after contact (local coordinates). Each cycle: slide down the face by
    STROKE_AMP at REACH_SPEED (a straight\n// leg, in contact), then return to the
    top along one smooth arc at STROKE_RETURN_SPEED: half an ellipse that leaves\n//
    the face at the bottom, swings out to STROKE_BACK from it (against the palm normal
    palmN) half-way up, and comes\n// back onto the face at the top. The last cycle
    ends at the bottom of its down-stroke. Each leg starts and ends at\n// rest (legDuration
    / legDistance along its length). Returns the legs with their start times, and
    the total time.\nconst STROKE_ARC_STEPS = 24;       // samples of the return
    arc for its length (arc-length parametrisation)\nfunction strokeArcPoint(leg,
    th) {  // th: 0 (bottom, leg.a) -> PI (top, leg.b)\n  return vadd(vadd(leg.c,
    vscale(leg.hv, -Math.cos(th))), vscale(leg.out, Math.sin(th)));\n}\nfunction
    strokePath(Fc, palmN) {\n  const A = NPC_CFG.STROKE_AMP, B = NPC_CFG.STROKE_BACK,
    N = NPC_CFG.STROKE_CYCLES;\n  const vs = NPC_CFG.REACH_SPEED, vr = NPC_CFG.STROKE_RETURN_SPEED;\n 
    const ramp = NPC_CFG.STROKE_RAMP_SEC;\n  const legs = [];\n  if (!(A > 0) ||
    !(N > 0) || !(vs > 0)) return { start: Fc, legs: legs, total: 0 };\n  const down
    = vscale(UP, -A), out = vscale(vnorm(palmN), -Math.max(0, B));\n  let p = Fc,
    t = 0;\n  function add(leg) { leg.t0 = t; t += legDuration(leg.L, leg.v, ramp);
    legs.push(leg); p = leg.b; }\n  for (let k = 0; k < N; k++) {\n    const bottom
    = vadd(p, down);\n    add({ a: p, b: bottom, v: vs, L: A });       // stroke
    down, in contact\n    if (k < N - 1 && vr > 0) {\n      // back up to where this
    stroke started, along the arc\n      const top = vsub(p, down);\n      const
    leg = { a: p, b: top, v: vr, arc: true, c: vlerp(p, top, 0.5), hv: vscale(vsub(top,
    p), 0.5), out: out, cum: [0] };\n      let q = p, len = 0;\n      for (let i
    = 1; i <= STROKE_ARC_STEPS; i++) {\n        const r = strokeArcPoint(leg, Math.PI
    * i / STROKE_ARC_STEPS);\n        len += vlen(vsub(r, q)); q = r; leg.cum.push(len);\n     
    }\n      leg.L = len;\n      add(leg);\n    }\n  }\n  return { start: Fc, legs:
    legs, total: t };\n}\n// Position on the stroke path t seconds after contact.\nfunction
    strokePoint(path, t) {\n  const legs = path.legs;\n  if (t <= 0 || legs.length
    === 0) return path.start;\n  for (let i = 0; i < legs.length; i++) {\n    const
    leg = legs[i];\n    const T = legDuration(leg.L, leg.v, NPC_CFG.STROKE_RAMP_SEC);\n   
    if (t > leg.t0 + T) continue;\n    const dist = legDistance(leg.L, leg.v, NPC_CFG.STROKE_RAMP_SEC,
    t - leg.t0);\n    if (!leg.arc) return vlerp(leg.a, leg.b, leg.L > 1e-6 ? dist
    / leg.L : 1);\n    // arc: the sample interval that contains this distance, then
    the angle within it\n    let j = 1;\n    while (j < STROKE_ARC_STEPS && leg.cum[j]
    < dist) j++;\n    const span = leg.cum[j] - leg.cum[j - 1];\n    const f = span
    > 1e-9 ? (dist - leg.cum[j - 1]) / span : 0;\n    return strokeArcPoint(leg,
    Math.PI * (j - 1 + f) / STROKE_ARC_STEPS);\n  }\n  return legs[legs.length -
    1].b;\n}\n// Wrist and contact point of a solved right arm (accounts for IK clamping
    when out of reach).\nfunction wristOf(rest, arm) {\n  return vadd(vadd(rest.sR,
    vscale(arm.upper, rest.L1)), vscale(arm.lower, rest.L2));\n}\nfunction contactOf(rest,
    arm) {\n  return vadd(wristOf(rest, arm), palmOffset(rest, arm.frame));\n}\n//
    Two-bone IK for a wrist target W (local). Returns {upperDir, lowerDir}.\nfunction
    solveArm(S, W, L1, L2, bendHint) {\n  const toW = vsub(W, S);\n  let d = vlen(toW);\n 
    d = Math.max(0.03, Math.min(L1 + L2 - 0.002, d));\n  const dir = vnorm(toW);\n 
    let cosA = (L1 * L1 + d * d - L2 * L2) / (2 * L1 * d);\n  cosA = Math.max(-1,
    Math.min(1, cosA));\n  const sinA = Math.sqrt(Math.max(0, 1 - cosA * cosA));\n 
    let perp = vsub(bendHint, vscale(dir, vdot(bendHint, dir)));\n  if (vlen(perp)
    < 1e-4) perp = vcross(dir, UP);\n  perp = vnorm(perp);\n  const upperDir = vnorm(vadd(vscale(dir,
    cosA), vscale(perp, sinA)));\n  const E = vadd(S, vscale(upperDir, L1));\n  const
    lowerDir = vnorm(vsub(W, E));\n  return { upperDir: upperDir, lowerDir: lowerDir,
    elbow: E };\n}\nfunction applyPose(Q) {\n  const worldRots = {};\n  for (let
    i = 0; i < boneNodes.length; i++) {\n    const e = boneNodes[i];\n    const q
    = Q[e.bone] || IDENT;\n    worldRots[e.bone] = q;\n    const parentQ = (e.parentBone
    === null || worldRots[e.parentBone] === undefined) ? IDENT : worldRots[e.parentBone];\n   
    const desired = qmul(q, e.rest);\n    const parent = qmul(parentQ, e.restParent);\n   
    e.node.setRotation(qmul(qinv(parent), desired));\n  }\n}\n\n// ----------------------------------------------------------------
    per-frame\n$.onUpdate((deltaTime) => {\n  try { tick(deltaTime); } catch (e)
    { $.log(\"[NPC] tick error: \" + e); }\n});\n\nfunction tick(dt) {\n  $.state.npc_clock
    = ($.state.npc_clock || 0) + dt;\n  if (boneNodes.length === 0) cacheBones();\n 
    const rest = restGeom();\n  if (!rest) return;                       // keep
    the model visible until the rest pose is measured\n\n  // Visibility: hidden
    until shown (also re-applied after a script reload).\n  if ($.state.npc_visibilityApplied
    !== !!$.state.npc_visible) applyVisibility();\n\n  if ($.state.npc_heightPending)
    tryHeightMatch();\n\n  if ($.state.npc_pendingStart) {\n    $.state.npc_startDelay
    = ($.state.npc_startDelay || 0) - dt;\n    if ($.state.npc_startDelay > 0) return;\n   
    if (!$.state.npc_visible) {\n      // the participant is back on the marker:
    appear at the conversation spot of the touch layout (behind-right),\n      //
    then step in a moment later; retry shortly while the participant's bones are
    not readable\n      if (moveToStand(NPC_CFG.IDLE_EXTRA_DIST, false)) { setVisible(true);
    $.state.npc_startDelay = NPC_CFG.REAPPEAR_SEC; }\n      else $.state.npc_startDelay
    = 0.2;\n    } else startTrial();\n    return;\n  }\n\n  // Glide to the target
    standing pose (position/rotation are networked, so keep it short).\n  const g
    = $.state.npc_glide;\n  if (g) {\n    const t = clamp01((g.t || 0) + dt / NPC_CFG.GLIDE_SEC);\n   
    const e = easeInOut(t);\n    $.setPosition(vlerp(g.fromPos, g.toPos, e));\n   
    $.setRotation(qslerp(g.fromRot, g.toRot, e));\n    if (t >= 1) $.state.npc_glide
    = null; else { g.t = t; $.state.npc_glide = g; }\n  }\n\n  // Back at the conversation
    spot after a trial: disappear (out of the way of the report panel and the\n 
    // questionnaires), then let the director move on.\n  if ($.state.npc_phase ===
    \"leave\" && !$.state.npc_glide) {\n    $.state.npc_phase = \"idle\";\n    $.state.npc_t
    = 0;\n    setVisible(false);\n    if ($.state.npc_leaveSignal) $.sendSignalCompat(\"this\",
    \"npc_done\");\n    $.state.npc_leaveSignal = false;\n    $.log(\"[NPC] back
    at the conversation spot; hidden\");\n    return;\n  }\n\n  if (!$.state.npc_visible)
    return;        // nothing to animate while hidden\n\n  const p = participant();\n 
    const head = p ? headOf(p) : null;\n  let ip = itemPose();\n  const social =
    !!$.state.npc_social;\n  const phase = $.state.npc_phase || \"idle\";\n  const
    greeting = $.state.npc_mode === \"greeting\";\n  if (greeting && social && head
    && !$.state.npc_glide) ip = turnBodyToward(head, restGeom(), ip, dt);\n  let
    t = ($.state.npc_t || 0) + dt;\n  $.state.npc_t = t;\n\n  const Q = {};\n  const
    R = rest.right, F = rest.fwd;\n\n  // --- torso / idle motion (social only) ---\n 
    if (social) {\n    const breathe = Math.sin(2 * Math.PI * 0.25 * (Date.now()
    / 1000)) * 1.0;\n    Q[HumanoidBone.Chest] = qaxis(R, breathe);\n    if (phase
    === \"approach\" || phase === \"stroke\" || phase === \"hold\") Q[HumanoidBone.Spine]
    = qaxis(R, 5);\n  }\n\n  // --- gaze (social only): head (and eyes) only; large
    angles are taken up by the body turn above,\n  //     which also unwinds the
    head's local rotation as the body comes around ---\n  if (social && head) {\n   
    const dir = vnorm(vsub(toLocal(head.pos, ip), rest.head));\n    const qFull =
    qfromTo(F, dir);\n    const qHead = qclamp(qFull, NPC_CFG.HEAD_MAX_DEG);\n   
    const qEye = qmul(qHead, qclamp(qmul(qinv(qHead), qFull), NPC_CFG.EYE_EXTRA_DEG));\n   
    Q[HumanoidBone.Head] = qHead;\n    Q[HumanoidBone.LeftEye] = qEye;\n    Q[HumanoidBone.RightEye]
    = qEye;\n  }\n\n  // --- participant signals: greeting period (reactive), trial
    prep (logging + one greeting) ---\n  if (head && (greeting || phase === \"prep\"
    || phase === \"approach\")) {\n    const sig = detectParticipantSignals(p, head,
    rest, ip);\n    if (greeting) {\n      if (sig.gazeEdge) { $.state.npc_gGaze
    = ($.state.npc_gGaze || 0) + 1; if (social) startReaction(\"gaze\"); }\n     
    if (sig.handEdge) { $.state.npc_gHand = ($.state.npc_gHand || 0) + 1; if (social)
    startReaction(\"hand\"); }\n      if (social && p && detectTouch(p, rest, ip))
    surprise();\n    } else if (sig.aligned && !$.state.npc_lookedAt) {\n      $.state.npc_lookedAt
    = true;\n      $.state.npc_lookTs = Date.now();\n      if (social && phase ===
    \"prep\" && !$.state.npc_react) { startReaction(\"prep\", true); $.state.npc_greeted
    = true; }\n    }\n  }\n  // greeting, social: nothing has triggered a reaction
    for a while -> nod and smile once\n  if (greeting && social && !$.state.npc_react
    &&\n      nowSec() - ($.state.npc_lastReactEnd || 0) >= NPC_CFG.IDLE_REACT_SEC)
    startReaction(\"idle\");\n\n  // --- arms (bone rotations incl. twist, so the
    palms face the right way) ---\n  const idleR = armRots(rest, \"R\", idleArm(rest,
    \"R\"));\n  const idleL = armRots(rest, \"L\", idleArm(rest, \"L\"));\n  let
    armR = idleR, armL = idleL;\n  let curl = 0;                            // right-hand
    finger curl weight (0 = straight, 1 = FINGER_CURL)\n\n  // reaction gesture (nod
    and/or wave with the palm forward), social only. Face to face the left hand waves;
    behind\n  // the participant (touch layout) the right one, on the outer side,
    so the wave is not hidden behind their head\n  // in the mirror (the right arm
    is idle during the prep, when this greeting happens).\n  let nodDeg = 0;\n  const
    react = $.state.npc_react;\n  if (social && react) {\n    const rt = (react.t
    || 0) + dt;\n    if (react.wave) {\n      const lift = Math.sin(Math.PI * clamp01(rt
    / react.dur));     // 0 -> 1 -> 0\n      if ($.state.npc_standKind === \"touch\")
    armR = slerpArm(idleR, armRots(rest, \"R\", waveArm(rest, rt, \"R\")), lift);\n     
    else armL = slerpArm(idleL, armRots(rest, \"L\", waveArm(rest, rt, \"L\")), lift);\n   
    }\n    if (react.nod) {\n      const nodSec = react.wave ? 0.6 : NPC_CFG.NOD_SEC;\n     
    nodDeg = NPC_CFG.NOD_DEG * Math.sin(Math.PI * clamp01(rt / nodSec));\n    }\n   
    if (rt >= react.dur) clearReaction(); else { react.t = rt; $.state.npc_react
    = react; }\n  } else if (react && !social) {\n    clearReaction();\n  }\n\n 
    // --- phase machine for the right arm ---\n  if (phase === \"prep\") {\n   
    const greetBusy = social && $.state.npc_react;\n    if (t >= NPC_CFG.PREP_SEC
    && !greetBusy && head && !$.state.npc_glide) {\n      // social: if the participant
    never looked, greet once before raising the hand\n      if (social && !$.state.npc_greeted)
    { $.state.npc_greeted = true; startReaction(\"prep\", true); }\n      else {
    $.state.npc_phase = \"ready\"; $.state.npc_t = 0; }\n    }\n  } else if (phase
    === \"ready\") {\n    // raise the hand from the idle pose to the ready point
    beside the participant's face, palm already turned\n    // toward their cheek,
    fingers curling (fast; the stimulus starts afterwards)\n    const e = easeInOut(t
    / NPC_CFG.READY_SEC);\n    if (head) {\n      const rt = readyTouch(head, ip);\n     
    armR = slerpArm(idleR, armRots(rest, \"R\", reachArm(rest, rt.H0, rt.frame)),
    e);\n    }\n    curl = e;\n    if (t >= NPC_CFG.READY_SEC && head) beginApproach(head,
    rest, ip);\n  } else if (phase === \"approach\") {\n    const L = $.state.npc_L,
    dir = $.state.npc_dir, H0 = $.state.npc_H0;\n    const frame = $.state.npc_frame;\n   
    const s = Math.min(NPC_CFG.REACH_SPEED * t, L);\n    const Ft = vadd(H0, vscale(dir,
    s));\n    const arm = reachArm(rest, Ft, frame);\n    armR = armRots(rest, \"R\",
    arm);\n    curl = 1;\n    const Fw = toWorld(contactOf(rest, arm), ip);\n   
    let d = -1;\n    if (head) {\n      d = vlen(vsub(Fw, facePointWorld(head)));\n     
    sampleTrace(dt, t, head, Fw, d);\n    }\n    const reachedEnd = s >= L;\n   
    const earlyContact = d >= 0 && d <= NPC_CFG.STOP_MARGIN;\n    if (reachedEnd
    || earlyContact) {\n      $.state.npc_contactTs = Date.now();\n      $.state.npc_contactDist
    = d;\n      $.state.npc_contactT = t;\n      $.state.npc_Fc = Ft;\n      $.state.npc_strokeSec
    = strokePath(Ft, frame.n).total;\n      $.state.npc_Fhold = Ft;\n      $.state.npc_phase
    = \"stroke\";\n      $.state.npc_t = 0;\n      // how far the rendered wrist
    is from the IK wrist (bone map / rest pose mismatch shows up here)\n      const
    wn = nodeByBone[HumanoidBone.RightHand];\n      const wAct = wn ? wn.node.getGlobalPosition()
    : null;\n      const wErr = wAct ? vlen(vsub(wAct, toWorld(wristOf(rest, arm),
    ip))) : -1;\n      $.log(\"[NPC] contact: d=\" + f3(d) + \" early=\" + earlyContact
    + \" wristErr=\" + f3(wErr) + \", stroking for \" +\n            f3($.state.npc_strokeSec)
    + \" s\");\n    }\n  } else if (phase === \"stroke\") {\n    // gently stroke
    the face along strokePath(): down in contact, back up along an arc off the face
    (same hand\n    // orientation as the approach)\n    const Fc = $.state.npc_Fc
    || $.state.npc_T;\n    const dur = $.state.npc_strokeSec || 0;\n    const Fs
    = strokePoint(strokePath(Fc, $.state.npc_frame.n), Math.min(t, dur));\n    const
    arm = reachArm(rest, Fs, $.state.npc_frame);\n    armR = armRots(rest, \"R\",
    arm);\n    curl = 1;\n    if (head) {\n      const Fw = toWorld(contactOf(rest,
    arm), ip);\n      sampleTrace(dt, ($.state.npc_contactT || 0) + t, head, Fw,
    vlen(vsub(Fw, facePointWorld(head))));\n    }\n    if (social) nodDeg = Math.max(nodDeg,
    10 * Math.sin(Math.PI * clamp01(t / 1.0)));\n    if (t >= dur) {\n      $.state.npc_strokeEndTs
    = Date.now();\n      $.state.npc_Fhold = Fs;              // rest where the last
    stroke ended\n      $.state.npc_phase = \"hold\";\n      $.state.npc_t = 0;\n   
    }\n  } else if (phase === \"hold\") {\n    const Fc = $.state.npc_Fhold || $.state.npc_Fc
    || $.state.npc_T;\n    const arm = reachArm(rest, Fc, $.state.npc_frame);\n   
    armR = armRots(rest, \"R\", arm);\n    curl = 1;\n    const sinceContact = ($.state.npc_strokeSec
    || 0) + t;\n    if (head) {\n      const Fw = toWorld(contactOf(rest, arm), ip);\n     
    sampleTrace(dt, ($.state.npc_contactT || 0) + sinceContact, head, Fw, vlen(vsub(Fw,
    facePointWorld(head))));\n    }\n    if (social) nodDeg = Math.max(nodDeg, 10
    * Math.sin(Math.PI * clamp01(sinceContact / 1.0)));\n    if (t >= NPC_CFG.HOLD_SEC)
    {\n      $.state.npc_phase = \"retract\";\n      $.state.npc_t = 0;\n      //
    back along a straight line to the ready point (beside the face) at RETRACT_SPEED,
    so the hand does not\n      // sweep through the participant's head or shoulder\n     
    $.state.npc_retractSec = Math.max(0.5, vlen(vsub(Fc, $.state.npc_H0)) / NPC_CFG.RETRACT_SPEED);\n   
    }\n  } else if (phase === \"retract\") {\n    const Fc = $.state.npc_Fhold ||
    $.state.npc_Fc || $.state.npc_T;\n    const u = clamp01(t / ($.state.npc_retractSec
    || 2.0));\n    armR = armRots(rest, \"R\", reachArm(rest, vlerp(Fc, $.state.npc_H0,
    easeInOut(u)), $.state.npc_frame));\n    curl = 1;\n    if (u >= 1) { $.state.npc_phase
    = \"lower\"; $.state.npc_t = 0; }\n  } else if (phase === \"lower\") {\n    //
    blend the joint rotations from the ready pose back to the relaxed arm, fingers
    relaxing\n    const readyArm = armRots(rest, \"R\", reachArm(rest, $.state.npc_H0,
    $.state.npc_frame));\n    const e = easeInOut(t / NPC_CFG.LOWER_SEC);\n    armR
    = slerpArm(readyArm, idleR, e);\n    curl = 1 - e;\n    if (t >= NPC_CFG.LOWER_SEC)
    finishTrial();\n  }\n\n  // nod composes with gaze\n  if (nodDeg !== 0) {\n   
    const qNod = qaxis(R, nodDeg);\n    Q[HumanoidBone.Head] = qmul(Q[HumanoidBone.Head]
    || IDENT, qNod);\n  }\n\n  Q[HumanoidBone.RightUpperArm] = armR.u;\n  Q[HumanoidBone.RightLowerArm]
    = armR.l;\n  Q[HumanoidBone.RightHand] = armR.h;\n  setFingerRots(Q, rest, armR.h,
    curl);\n  Q[HumanoidBone.LeftUpperArm] = armL.u;\n  Q[HumanoidBone.LeftLowerArm]
    = armL.l;\n  Q[HumanoidBone.LeftHand] = armL.h;\n\n  applyPose(Q);\n}\n\n// 10
    Hz head trace plus the in-world retreat estimate.\nfunction sampleTrace(dt, t,
    head, Fw, d) {\n  sampleTimer += dt;\n  if (sampleTimer < NPC_CFG.SAMPLE_INTERVAL)
    return;\n  sampleTimer = 0;\n  const h = head.pos, r = head.rot;\n  const total
    = ($.state.npc_trace || []).length + traceBuf.length;\n  if (total < NPC_CFG.MAX_SAMPLES)
    {\n    traceBuf.push([t.toFixed(1), f3(h.x), f3(h.y), f3(h.z), f3(r.x), f3(r.y),
    f3(r.z), f3(r.w), f3(d)].join(\",\"));\n  }\n  if (traceBuf.length >= 10) {\n   
    $.state.npc_trace = ($.state.npc_trace || []).concat(traceBuf);\n    traceBuf
    = [];\n  }\n  // retreat / oscillation estimate (world frame)\n  if (!$.state.npc_base)
    {\n    baseSamples.push(vcopy(h));\n    if (t >= 1.0) {\n      let sum = v3(0,
    0, 0);\n      for (const b of baseSamples) sum = vadd(sum, b);\n      $.state.npc_base
    = vscale(sum, 1 / Math.max(1, baseSamples.length));\n    }\n    return;\n  }\n 
    // axis: horizontal approach direction (hand -> face), so moving away from the
    hand is positive along it\n  const axis = $.state.npc_axisW || v3(0, 0, 1);\n 
    const delta = vsub(h, $.state.npc_base);\n  const away = vdot(delta, axis);\n 
    const lateral = vdot(delta, vcross(axis, UP));\n  if (away > ($.state.npc_away
    || 0)) $.state.npc_away = away;\n  if (lateral < ($.state.npc_latMin || 0)) $.state.npc_latMin
    = lateral;\n  if (lateral > ($.state.npc_latMax || 0)) $.state.npc_latMax = lateral;\n 
    if ($.state.npc_onsetDist < 0 && away > NPC_CFG.RETREAT_THRESHOLD) $.state.npc_onsetDist
    = d;\n}\n"
