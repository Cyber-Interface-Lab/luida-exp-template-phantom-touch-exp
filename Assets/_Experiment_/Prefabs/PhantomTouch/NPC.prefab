    true;\n  } catch (e) { $.log(\"[NPC] resetParticipant failed: \" + e); return
    false; }\n}\n\n// ----------------------------------------------------------------
    greeting period\nfunction beginGreeting() {\n  $.state.npc_mode = \"greeting\";\n 
    $.state.npc_greetStartTs = Date.now();\n  $.state.npc_gGaze = 0; $.state.npc_gHand
    = 0; $.state.npc_gWaves = 0; $.state.npc_gNods = 0;\n  $.state.npc_gReact = 0;
    $.state.npc_smiles = 0; $.state.npc_gTouch = 0;\n  $.state.npc_gazeAligned =
    false;\n  $.state.npc_handUp = false;\n  $.state.npc_touching = false;\n  $.state.npc_reacted
    = false;          // the first reaction of the greeting period is nod + wave
    + smile\n  $.state.npc_lastReact = 0;\n  $.state.npc_lastReactEnd = nowSec(); 
