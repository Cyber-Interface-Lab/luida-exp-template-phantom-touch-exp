    = false;\n  const diff = rest.head.y - pHeadH;          // > 0: the participant
    is shorter\n  const platformH = diff >= NPC_CFG.HEIGHT_MATCH_MIN ? diff : 0;\n 
    const lift = -diff >= NPC_CFG.HEIGHT_MATCH_MIN ? -diff : 0;\n  $.state.npc_platformH
    = platformH;\n  $.state.npc_lift = lift;\n  sendPlatform(platformH);\n  applyRiser();\n 
    if (platformH > 0) resetParticipant(false);   // lift the participant onto the
    platform (keeps their facing)\n  if ($.state.npc_visible) moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    true);\n  pushData({ participantHeadH: pHeadH, npcHeadH: rest.head.y, heightPlatform:
    platformH, npcLift: lift });\n  $.log(\"[NPC] height match: participant head
    \" + f3(pHeadH) + \" m, NPC head \" + f3(rest.head.y) +\n        \" m -> platform
    \" + f3(platformH) + \", riser \" + f3(lift));\n}\n// Put the participant on
    the marker (on their platform); withRotation also turns them to face along it.\nfunction
    resetParticipant(withRotation) {\n  const p = participant();\n  const o = $.state.npc_origin;\n 
    if (!p || !o) return false;\n  try {\n    p.setPosition(v3(o.x, o.y + ($.state.npc_platformH
    || 0), o.z));\n    if (withRotation && $.state.npc_fwd) p.setRotation(qaxis(UP,
