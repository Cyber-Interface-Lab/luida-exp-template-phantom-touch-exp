--- !u!114 &1910187786163740648
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6915775039710669198}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "// NPC bone map: generated by Study4SceneBuilder from Assets/_Experiment_/Avatars/PhantomTouch/Source/luida_default_avatar_02.vrm\n//
    Do not edit manually: LUIDA > Study4 > Regenerate NPC bone map from the scene
    model.\n// rest / restParent: rotation of the bone / of its transform parent
    relative to the item root, in the\n// model's rest pose. BONE_PARENT: nearest
    listed ancestor.\n\nconst AVATAR_SYNC_HIPS_Y = true;\nconst AVATAR_HIPS_Y_OFFSET
    = 0;\n\nconst AVATAR_HIPS_PARENT_REST_ROT = new Quaternion(0, 0, 0, 1);\nconst
    AVATAR_HIPS_PARENT_REST_POS = new Vector3(0, 0, 0);\n\nconst BONE_MAP = [\n 
    { bone: HumanoidBone.Hips, name: \"J_Bip_C_Hips\", rest: new Quaternion(0.06289843,
    0, 0, 0.9980199), restParent: new Quaternion(0, 0, 0, 1) },\n  { bone: HumanoidBone.Spine,
    name: \"J_Bip_C_Spine\", rest: new Quaternion(0.07566475, 0, 0, 0.9971334), restParent:
    new Quaternion(0.06289843, 0, 0, 0.9980199) },\n  { bone: HumanoidBone.Chest,
    name: \"J_Bip_C_Chest\", rest: new Quaternion(-0.060871, 0, 0, 0.9981458), restParent:
    new Quaternion(0.07566475, 0, 0, 0.9971334) },\n  { bone: HumanoidBone.Neck,
    name: \"J_Bip_C_Neck\", rest: new Quaternion(0.05973143, 0, 0, 0.9982147), restParent:
    new Quaternion(-0.1682905, 0, 0, 0.9857376) },\n  { bone: HumanoidBone.Head,
    name: \"J_Bip_C_Head\", rest: new Quaternion(0.005404245, -2.190967E-07, -2.511393E-08,
    0.9999857), restParent: new Quaternion(0.05973143, 0, 0, 0.9982147) },\n  { bone:
    HumanoidBone.LeftShoulder, name: \"J_Bip_L_Shoulder\", rest: new Quaternion(0,
    2.328306E-09, 0.07061428, 0.9975039), restParent: new Quaternion(-0.1682905,
    0, 0, 0.9857376) },\n  { bone: HumanoidBone.LeftUpperArm, name: \"J_Bip_L_UpperArm\",
    rest: new Quaternion(-7.450581E-09, 1.227551E-09, 7.190206E-09, 1), restParent:
    new Quaternion(0, 2.328306E-09, 0.07061428, 0.9975039) },\n  { bone: HumanoidBone.LeftLowerArm,
    name: \"J_Bip_L_LowerArm\", rest: new Quaternion(-7.450581E-09, 2.832009E-10,
    7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, 1.227551E-09, 7.190206E-09,
    1) },\n  { bone: HumanoidBone.LeftHand, name: \"J_Bip_L_Hand\", rest: new Quaternion(-7.450581E-09,
    2.832009E-10, 7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, 2.832009E-10,
    7.192827E-09, 1) },\n  { bone: HumanoidBone.RightShoulder, name: \"J_Bip_R_Shoulder\",
    rest: new Quaternion(0, -2.328306E-09, -0.07061428, 0.9975039), restParent: new
    Quaternion(-0.1682905, 0, 0, 0.9857376) },\n  { bone: HumanoidBone.RightUpperArm,
    name: \"J_Bip_R_UpperArm\", rest: new Quaternion(-7.450581E-09, -1.227551E-09,
    -7.190206E-09, 1), restParent: new Quaternion(0, -2.328306E-09, -0.07061428,
    0.9975039) },\n  { bone: HumanoidBone.RightLowerArm, name: \"J_Bip_R_LowerArm\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -1.227551E-09, -7.190206E-09, 1) },\n  { bone:
    HumanoidBone.RightHand, name: \"J_Bip_R_Hand\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.LeftUpperLeg, name: \"J_Bip_L_UpperLeg\",
    rest: new Quaternion(0.01046093, 0, 0, 0.9999453), restParent: new Quaternion(0.06289843,
    0, 0, 0.9980199) },\n  { bone: HumanoidBone.LeftLowerLeg, name: \"J_Bip_L_LowerLeg\",
    rest: new Quaternion(0.03326847, 0, 0, 0.9994465), restParent: new Quaternion(0.01046093,
    0, 0, 0.9999453) },\n  { bone: HumanoidBone.RightUpperLeg, name: \"J_Bip_R_UpperLeg\",
    rest: new Quaternion(0.01046093, 0, 0, 0.9999453), restParent: new Quaternion(0.06289843,
    0, 0, 0.9980199) },\n  { bone: HumanoidBone.RightLowerLeg, name: \"J_Bip_R_LowerLeg\",
    rest: new Quaternion(0.03326847, 0, 0, 0.9994465), restParent: new Quaternion(0.01046093,
    0, 0, 0.9999453) },\n  { bone: HumanoidBone.LeftEye, name: \"J_Adj_L_FaceEye\",
    rest: new Quaternion(0.02570083, -0.1889786, 0.005137843, 0.9816316), restParent:
    new Quaternion(0.005404245, -2.190967E-07, -2.511393E-08, 0.9999857) },\n  {
    bone: HumanoidBone.RightEye, name: \"J_Adj_R_FaceEye\", rest: new Quaternion(0.02570083,
    0.1889782, -0.00513789, 0.9816317), restParent: new Quaternion(0.005404245, -2.190967E-07,
    -2.511393E-08, 0.9999857) },\n  { bone: HumanoidBone.RightThumbProximal, name:
    \"J_Bip_R_Thumb1\", rest: new Quaternion(0.7031665, -0.2467994, 0.2439799, 0.6205814),
    restParent: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n 
    { bone: HumanoidBone.RightThumbIntermediate, name: \"J_Bip_R_Thumb2\", rest:
    new Quaternion(0.7077863, -0.2292977, 0.2319948, 0.62661), restParent: new Quaternion(0.7031665,
    -0.2467994, 0.2439799, 0.6205814) },\n  { bone: HumanoidBone.RightThumbDistal,
    name: \"J_Bip_R_Thumb3\", rest: new Quaternion(0.700076, -0.2624655, 0.2513979,
    0.6146586), restParent: new Quaternion(0.7077863, -0.2292977, 0.2319948, 0.62661)
    },\n  { bone: HumanoidBone.RightIndexProximal, name: \"J_Bip_R_Index1\", rest:
    new Quaternion(-7.450581E-09, 0.009704283, 1.583248E-08, 0.9999532), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightIndexIntermediate, name: \"J_Bip_R_Index2\", rest: new Quaternion(-2.30968E-06,
    0.01926568, -0.01444243, 0.9997103), restParent: new Quaternion(-7.450581E-09,
    0.009704283, 1.583248E-08, 0.9999532) },\n  { bone: HumanoidBone.RightIndexDistal,
    name: \"J_Bip_R_Index3\", rest: new Quaternion(-9.602308E-05, 0.01667643, -0.01736773,
    0.9997104), restParent: new Quaternion(-2.30968E-06, 0.01926568, -0.01444243,
    0.9997103) },\n  { bone: HumanoidBone.RightMiddleProximal, name: \"J_Bip_R_Middle1\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightMiddleIntermediate, name: \"J_Bip_R_Middle2\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightMiddleDistal, name: \"J_Bip_R_Middle3\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightRingProximal, name: \"J_Bip_R_Ring1\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightRingIntermediate, name: \"J_Bip_R_Ring2\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightRingDistal, name: \"J_Bip_R_Ring3\", rest: new Quaternion(-1.490116E-08,
    0.01143836, -0.006218723, 0.9999155), restParent: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightLittleProximal,
    name: \"J_Bip_R_Little1\", rest: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09,
    1) },\n  { bone: HumanoidBone.RightLittleIntermediate, name: \"J_Bip_R_Little2\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightLittleDistal, name: \"J_Bip_R_Little3\", rest: new Quaternion(-2.235174E-08,
    -0.009609761, 0.007768773, 0.9999238), restParent: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1) },\n];\n\nconst BONE_PARENT = {\n  [HumanoidBone.Hips]:
    null,\n  [HumanoidBone.Spine]: HumanoidBone.Hips,\n  [HumanoidBone.Chest]: HumanoidBone.Spine,\n 
    [HumanoidBone.Neck]: HumanoidBone.Chest,\n  [HumanoidBone.Head]: HumanoidBone.Neck,\n 
    [HumanoidBone.LeftShoulder]: HumanoidBone.Chest,\n  [HumanoidBone.LeftUpperArm]:
    HumanoidBone.LeftShoulder,\n  [HumanoidBone.LeftLowerArm]: HumanoidBone.LeftUpperArm,\n 
    [HumanoidBone.LeftHand]: HumanoidBone.LeftLowerArm,\n  [HumanoidBone.RightShoulder]:
    HumanoidBone.Chest,\n  [HumanoidBone.RightUpperArm]: HumanoidBone.RightShoulder,\n 
    [HumanoidBone.RightLowerArm]: HumanoidBone.RightUpperArm,\n  [HumanoidBone.RightHand]:
    HumanoidBone.RightLowerArm,\n  [HumanoidBone.LeftUpperLeg]: HumanoidBone.Hips,\n 
    [HumanoidBone.LeftLowerLeg]: HumanoidBone.LeftUpperLeg,\n  [HumanoidBone.RightUpperLeg]:
    HumanoidBone.Hips,\n  [HumanoidBone.RightLowerLeg]: HumanoidBone.RightUpperLeg,\n 
    [HumanoidBone.LeftEye]: HumanoidBone.Head,\n  [HumanoidBone.RightEye]: HumanoidBone.Head,\n 
    [HumanoidBone.RightThumbProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightThumbIntermediate]:
    HumanoidBone.RightThumbProximal,\n  [HumanoidBone.RightThumbDistal]: HumanoidBone.RightThumbIntermediate,\n 
    [HumanoidBone.RightIndexProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightIndexIntermediate]:
    HumanoidBone.RightIndexProximal,\n  [HumanoidBone.RightIndexDistal]: HumanoidBone.RightIndexIntermediate,\n 
    [HumanoidBone.RightMiddleProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightMiddleIntermediate]:
    HumanoidBone.RightMiddleProximal,\n  [HumanoidBone.RightMiddleDistal]: HumanoidBone.RightMiddleIntermediate,\n 
    [HumanoidBone.RightRingProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightRingIntermediate]:
    HumanoidBone.RightRingProximal,\n  [HumanoidBone.RightRingDistal]: HumanoidBone.RightRingIntermediate,\n 
    [HumanoidBone.RightLittleProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightLittleIntermediate]:
    HumanoidBone.RightLittleProximal,\n  [HumanoidBone.RightLittleDistal]: HumanoidBone.RightLittleIntermediate,\n};\n\r\n//
    ===== Study 4 NPC controller =====\n// Runs on the NPC item (a LUIDA avatar wrapper
    built from a VRM, with AvatarSyncClone.js\n// replaced by this script). Expects
    the generated NPC_BoneMap.js header to be prepended\n// by LuidaScriptCombiner
    (BONE_MAP, BONE_PARENT, AVATAR_* constants).\n//\n// Messages (sent by the NpcDirector
    state-listening item):\n//   \"npc_setup\"           { social, fwd, origin, floorY
    } -> remember the social-cue condition and the marker\n//                                                 
    (standing spot, facing direction, floor height); clear the\n//                                                 
    height matching of the previous block; NPC stays hidden\n//   \"npc_hide\"           
    {}                    -> hide the body (avatar-switch phase)\n//   \"npc_show\"           
    { social? }           -> match heights (platform under a shorter participant
    / riser under a\n//                                                  shorter
    NPC), stand at conversation distance in front of the marker\n//                                                 
    and show the body\n//   \"npc_greeting_begin\"  { social? }           -> greeting
    period (social condition only): head gaze with body\n//                                                 
    turn, random reactions (nod / wave / both, sometimes smiling),\n//                                                 
    surprised face when touched\n//   \"npc_greeting_end\"    {}                   
    -> stop the greeting reactions, write greeting counters\n//   \"npc_trial_start\"    
    { block, rep, avatar, social, fwd, reset } -> leave the greeting spot in front
    (disappear)\n//                                                  -> (reset: put
    the participant back on the marker, on their platform)\n//                                                 
    -> reappear behind-right of the participant (touch layout; seen in the\n//                                                 
    front mirror) -> step closer -> prep -> raise the hand to the side of\n//                                                 
    the participant's face, fingers curling -> approach the right cheek\n//                                                 
    from the side (2 cm/s) -> stroke the face vertically (2 cm/s) -> hold\n//                                                 
    -> retract along the approach line -> lower the arm, fingers relaxing\n//                                                 
    -> step back -> hide -> npc_done\n//   \"npc_abort\"           {}                   
    -> step back and hide (no npc_done)\n// Output:\n//   item signal \"npc_done\"
    once the NPC has stepped back and hidden (a GlobalLogic on this item relays it
    to\n//   the global signal \"npc_done\")\n//   per-trial measurements merged
    into $.groupState.collectedData (this item is an ItemGroupMember)\n//\n// All
    pose math is done in the item-local frame of the NPC root, in the \"normalized
    skeleton\"\n// convention used by Cluster (T-pose = identity). The same world->local
    retargeting formula as\n// AvatarSyncClone.js is used to drive the bone sub-nodes.\n\nconst
    NPC_CFG = {\n  REACH_SPEED: 0.02,       // m/s (thesis 6.2.3)\n  PREP_SEC: 2.0,          
    // wait (and step closer) before the hand is raised\n  READY_SEC: 1.2,         
    // raise the hand to the ready position (fast, not part of the stimulus)\n  //
    Touch layout: the greeting is face to face (conversation spot in front of the
    marker, as before); for the touch\n  // the NPC stands behind-right of the participant,
    turned toward them, and its right hand comes in diagonally from\n  // the front-right
    of the participant's face. The participant watches it in the mirror straight
    ahead.\n  TOUCH_STAND_AZ_DEG: 110, // reach spot: on this azimuth around the
    marker (deg from its facing, + = right; 90 = beside,\n                          
    //   180 = behind; nearer the side than 125 so the arm reaches the front-right
    start); the\n                           //   conversation spot of the touch is
    IDLE_EXTRA_DIST farther out on the same line\n  TOUCH_BODY_YAW_DEG: -30, // NPC
    facing at the touch spots: the marker's facing turned by this (deg, - = to the
    left)\n  TOUCH_MIN_STAND_DIST: 0.30, // minimum horizontal marker-to-NPC distance
    at the touch reach spot (m)\n  TOUCH_STAND_FACTOR: 0.88, // touch reach spot:
    the wrist at the end of the approach is this fraction of (upper arm\n                          
    //   + forearm) from the shoulder (smaller = the NPC stands closer, elbow more
    bent) ...\n  TOUCH_START_FACTOR: 0.92, //   ... and at the start of the approach
    at most this fraction (the NPC steps closer if needed)\n  APPROACH_SIDE: 0.246,   
    // ready point of the contact point: this far to the participant's right of the
    face target ...\n  APPROACH_FWD: 0.172,     //   ... this far forward of it (participant's
    head yaw frame; with SIDE: 0.30 m, 35 deg\n                           //   in
    front of the side) ...\n  APPROACH_UP: -0.06,      //   ... and this far up (a
    little below, so the hand rises slightly toward the face); the\n                          
    //   approach is the straight line from there to the target\n  HAND_ACROSS_YAW_DEG:
    20, // touching hand: fingers point across the face (toward the participant's
    left), turned\n  HAND_ACROSS_TILT_DEG: 10, //   this far forward and this far
    up; palm toward the cheek, thumb up\n  // Right-hand fingers while the hand is
    raised, approaching, stroking and retracting (curled in during the raise,\n 
    // relaxed while the arm is lowered; straight otherwise): flexion toward the
    palm (deg) at the proximal,\n  // intermediate and distal joints. Needs the finger
    bones in NPC_BoneMap.js.\n  // (as in the reference photos: index nearly straight,
    the other fingers progressively more bent)\n  FINGER_CURL: { Thumb: [0, 10, 10],
    Index: [5, 15, 10], Middle: [25, 35, 20], Ring: [35, 45, 25], Little: [45, 50,
    30] },\n  FINGER_PAD: 0.008,       // finger pad (skin) on the palm side of the
    finger bones (m)\n  LOWER_SEC: 1.2,          // after retracting to the ready
    point: lower the arm to the side in this time\n  STROKE_AMP: 0.06,        //
    stroke: the fingers slide down the face by this much (m) at REACH_SPEED, then
    ...\n  STROKE_BACK: 0.03,       //   ... return to the top along an arc that
    swings this far out from the face ...\n  STROKE_CYCLES: 3,        //   ... this
    many times in total (0 disables the stroke)\n  STROKE_RETURN_SPEED: 0.04, //
    speed along the return arc (m/s)\n  STROKE_RAMP_SEC: 0.4,    // every leg of
    the stroke starts from rest and ends at rest: it accelerates for this long,\n                          
    //   keeps the leg's speed, then decelerates for this long (a leg too short to
    reach the\n                           //   speed accelerates half-way and decelerates);
    0 = constant speed\n  HOLD_SEC: 1.0,           // rest where the last stroke
    ended\n  RETRACT_SPEED: 0.10,     // m/s, back along the approach line to the
    ready point\n  STOP_MARGIN: 0.02,       // stop the hand's contact point (the
    curled fingers' pads) this far before the face target\n  // Touch target in the
    participant's head frame: in front of the face, on the midline under the eyes
    (the hand comes\n  // in from the participant's right and its contact point stops
    STOP_MARGIN to the right of it).\n  CHEEK_BELOW_EYES: 0.025, //   height: the
    eye bones' midpoint minus this ...\n  FACE_UP: 0.04,           //   ... or, for
    avatars without eye bones, head bone + this (the same height on VRoid models)\n 
    USE_EYE_BONES: false,    //   query the eye bones at all? Cluster returns null
    for missing bones, but the editor\n                           //   emulator (CSEmulator)
    throws a .NET exception that aborts the whole handler, so the\n                          
    //   director turns this on only outside LUIDA's test mode (npc_setup { eyes
    })\n  FACE_SIDE: 0.0,          //   toward the participant's right (0 = midline
    of the face); the hand stops\n                           //   STOP_MARGIN short
    of this on its way in from the front-right\n  FACE_FWD: 0.095,         //   forward
    of the head bone (about the face surface; the hand stops STOP_MARGIN short of\n                          
    //   this point, coming in from the front-right, i.e. ~1 cm in front and ~1.6
    cm right of it)\n  // Greeting spot (face to face, unchanged from the earlier
    frontal touch): the distance at which a straight hand,\n  // fingers HAND_PITCH_DEG
    above horizontal, would reach the face from the front, plus IDLE_EXTRA_DIST.\n 
    // CONTACT_LEN / PALM_OFF are also the touching hand's contact point when the
    bone map has no finger bones.\n  CONTACT_LEN: 0.12,       // wrist -> contact
    point along the fingers (finger pads) (m)\n  PALM_OFF: 0.015,         // palm-side
    offset of the contact point along the palm normal (m)\n  HAND_PITCH_DEG: 45,     
    // frontal reaching hand: fingers this far above horizontal\n  SAMPLE_INTERVAL:
    0.1,    // 10 Hz trace\n  STAND_FACTOR: 0.93,      // usable fraction of (upper
    arm + forearm) when choosing a reach spot\n  MIN_STAND_DIST: 0.40,    // greeting
    spot: minimum horizontal root-to-head distance of the frontal reach spot (m)\n 
    IDLE_EXTRA_DIST: 0.45,   // conversation distance = reach distance + this (m)\n 
    MAX_SAMPLES: 400,        // trace cap (10 Hz -> 40 s)\n  GLIDE_SEC: 1.0,         
    // step closer / step back duration\n  REAPPEAR_SEC: 0.5,       // 2nd trial
    of a block: shown at the conversation spot this long before stepping in\n  RESET_SETTLE_SEC:
    1.0,   // touch start: wait this long after putting the participant back on the
    marker\n  HEIGHT_MATCH_MIN: 0.05,  // match heights only when the head-bone heights
    differ by at least this (m):\n                           //   participant shorter
    -> platform under the participant (HeightPlatform item);\n                          
    //   NPC shorter -> the NPC stands on its Riser sub-node\n  HEIGHT_MEASURE_SEC:
    3.0, // keep trying to read the participant's bones this long after npc_show\n 
    IDLE_REACT_SEC: 5.0,     // greeting: nod + smile once whenever no reaction has
    happened for this long\n  HEAD_MAX_DEG: 50,        // gaze: the head alone turns
    up to this angle ...\n  EYE_EXTRA_DEG: 12,       // ... and the eyes a bit further\n 
    BODY_TURN_START_DEG: 35, // greeting: if the participant is farther than this
    from the NPC's facing,\n  BODY_TURN_STOP_DEG: 4,   //   the whole body turns
    toward them (lerp) until within this angle;\n  BODY_TURN_RATE: 2.5,     //  
    exponential rate (1/s). The head's local rotation unwinds as the body turns.\n 
    LOOK_AT_DEG: 30,         // participant \"looks at\" the NPC when head forward
    is within this angle\n  LOOK_AWAY_DEG: 45,       // ... and stops when it exceeds
    this angle (hysteresis)\n  HAND_RAISE_OFFSET: 0.10, // a hand counts as raised
    when above (head height - this)\n  REACT_COOLDOWN_SEC: 2.5, // minimum interval
    between reactions\n  NOD_SEC: 0.8,            // nod-only reaction duration\n 
    NOD_DEG: 15,\n  WAVE_SEC: 1.6,           // reaction duration when it includes
    a wave\n  JOY_PROB: 0.5,           // probability of smiling during a reaction
    (the first reaction always smiles)\n  TOUCH_COOLDOWN_SEC: 1.5, // surprised face
    when touched: minimum interval\n  TOUCH_HAND_MARGIN: 0.06, // participant hand
    bone (wrist) -> fingers allowance (m)\n  RETREAT_THRESHOLD: 0.02, // m, for the
    in-world retreat-onset estimate\n  MODEL_NODE: \"Model\",     // sub-node holding
    the VRM model (toggled for visibility)\n  JOY_KEY: \"npc_joy\",      // item
    Bool state -> Set Animator Value gimmick on the face mesh -> Animator Bool \"joy\"\n 
    SURPRISED_KEY: \"npc_surprised\", // item signal -> gimmick -> Animator Trigger
    \"surprised\" (1 s clip)\n                           // (Joy: Fcl_EYE_Joy=100,
    Fcl_MTH_Joy=50; Surprised: Fcl_EYE_Surprised=50, Fcl_MTH_Surprised=50)\n  RISER_NODE:
    \"Riser\",     // 1 m cube under the NPC's feet (top at the feet); shown while
    the NPC is lifted\n  PLATFORM_ITEM: \"HeightPlatform\", // world item reference:
    the platform under the participant's standing spot\n};\n\nconst IDENT = new Quaternion(0,
    0, 0, 1);\nconst UP = new Vector3(0, 1, 0);\n// Right-hand finger bones (proximal,
    intermediate, distal), keyed like NPC_CFG.FINGER_CURL.\nconst R_FINGERS = [\n 
    { name: \"Thumb\", bones: [HumanoidBone.RightThumbProximal, HumanoidBone.RightThumbIntermediate,
    HumanoidBone.RightThumbDistal] },\n  { name: \"Index\", bones: [HumanoidBone.RightIndexProximal,
    HumanoidBone.RightIndexIntermediate, HumanoidBone.RightIndexDistal] },\n  { name:
    \"Middle\", bones: [HumanoidBone.RightMiddleProximal, HumanoidBone.RightMiddleIntermediate,
    HumanoidBone.RightMiddleDistal] },\n  { name: \"Ring\", bones: [HumanoidBone.RightRingProximal,
    HumanoidBone.RightRingIntermediate, HumanoidBone.RightRingDistal] },\n  { name:
    \"Little\", bones: [HumanoidBone.RightLittleProximal, HumanoidBone.RightLittleIntermediate,
    HumanoidBone.RightLittleDistal] },\n];\n\n// ----------------------------------------------------------------
    math helpers\nfunction v3(x, y, z) { return new Vector3(x, y, z); }\nfunction
    vadd(a, b) { return v3(a.x + b.x, a.y + b.y, a.z + b.z); }\nfunction vsub(a,
    b) { return v3(a.x - b.x, a.y - b.y, a.z - b.z); }\nfunction vscale(a, s) { return
    v3(a.x * s, a.y * s, a.z * s); }\nfunction vdot(a, b) { return a.x * b.x + a.y
    * b.y + a.z * b.z; }\nfunction vcross(a, b) { return v3(a.y * b.z - a.z * b.y,
    a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x); }\nfunction vlen(a) { return Math.sqrt(vdot(a,
    a)); }\nfunction vnorm(a) { const l = vlen(a); return l > 1e-9 ? vscale(a, 1
    / l) : v3(0, 0, 1); }\nfunction vlerp(a, b, t) { return vadd(a, vscale(vsub(b,
    a), t)); }\nfunction vhoriz(a) { return vnorm(v3(a.x, 0, a.z)); }\nfunction vcopy(a)
    { return v3(a.x, a.y, a.z); }\n\nfunction qmul(a, b) {\n  return new Quaternion(\n   
    a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,\n    a.w * b.y - a.x * b.z + a.y
    * b.w + a.z * b.x,\n    a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,\n    a.w
    * b.w - a.x * b.x - a.y * b.y - a.z * b.z);\n}\nfunction qinv(q) { return new
    Quaternion(-q.x, -q.y, -q.z, q.w); }\nfunction qrot(q, v) {\n  const tx = 2 *
    (q.y * v.z - q.z * v.y);\n  const ty = 2 * (q.z * v.x - q.x * v.z);\n  const
    tz = 2 * (q.x * v.y - q.y * v.x);\n  return v3(\n    v.x + q.w * tx + (q.y *
    tz - q.z * ty),\n    v.y + q.w * ty + (q.z * tx - q.x * tz),\n    v.z + q.w *
    tz + (q.x * ty - q.y * tx));\n}\nfunction qaxis(axis, deg) {\n  const a = vnorm(axis);\n 
    const h = deg * Math.PI / 360;\n  const s = Math.sin(h);\n  return new Quaternion(a.x
    * s, a.y * s, a.z * s, Math.cos(h));\n}\n// Minimal rotation taking direction
    a to direction b.\nfunction qfromTo(a, b) {\n  const an = vnorm(a), bn = vnorm(b);\n 
    const d = Math.max(-1, Math.min(1, vdot(an, bn)));\n  if (d > 0.99999) return
    new Quaternion(0, 0, 0, 1);\n  if (d < -0.99999) {\n    let axis = vcross(v3(1,
    0, 0), an);\n    if (vlen(axis) < 1e-6) axis = vcross(v3(0, 1, 0), an);\n   
    return qaxis(axis, 180);\n  }\n  const axis = vcross(an, bn);\n  return qaxis(axis,
    Math.acos(d) * 180 / Math.PI);\n}\nfunction qslerp(a, b, t) {\n  if (t <= 0)
    return a; if (t >= 1) return b;\n  let cos = a.x * b.x + a.y * b.y + a.z * b.z
    + a.w * b.w;\n  let bx = b.x, by = b.y, bz = b.z, bw = b.w;\n  if (cos < 0) {
    cos = -cos; bx = -bx; by = -by; bz = -bz; bw = -bw; }\n  if (cos > 0.9995) {\n   
    return qnormalize(new Quaternion(a.x + (bx - a.x) * t, a.y + (by - a.y) * t,
    a.z + (bz - a.z) * t, a.w + (bw - a.w) * t));\n  }\n  const th = Math.acos(cos),
    s = Math.sin(th);\n  const wa = Math.sin((1 - t) * th) / s, wb = Math.sin(t *
    th) / s;\n  return new Quaternion(a.x * wa + bx * wb, a.y * wa + by * wb, a.z
    * wa + bz * wb, a.w * wa + bw * wb);\n}\nfunction qnormalize(q) {\n  const l
    = Math.sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w) || 1;\n  return new
    Quaternion(q.x / l, q.y / l, q.z / l, q.w / l);\n}\nfunction qangleDeg(q) { return
    2 * Math.acos(Math.max(-1, Math.min(1, Math.abs(q.w)))) * 180 / Math.PI; }\nfunction
    qclamp(q, maxDeg) { const a = qangleDeg(q); return a > maxDeg ? qslerp(IDENT,
    q, maxDeg / a) : q; }\nfunction clamp01(x) { return Math.max(0, Math.min(1, x));
    }\nfunction perpTo(v, axis) { const a = vnorm(axis); return vsub(v, vscale(a,
    vdot(v, a))); }\n// Rotation that maps restAxis -> axis AND turns restRef (perpendicular
    to restAxis) as close as\n// possible to ref (projected perpendicular to axis).
    This fixes the twist around the bone axis\n// (e.g. which way the palm faces),
    which a minimal from-to rotation leaves undetermined.\nfunction basisRot(restAxis,
    restRef, axis, ref) {\n  const q1 = qfromTo(restAxis, axis);\n  const a = vnorm(axis);\n 
    const p1 = perpTo(qrot(q1, restRef), a);\n  const p2 = perpTo(ref, a);\n  if
    (vlen(p1) < 1e-4 || vlen(p2) < 1e-4) return q1;\n  const u1 = vnorm(p1), u2 =
    vnorm(p2);\n  const ang = Math.acos(Math.max(-1, Math.min(1, vdot(u1, u2))))
    * 180 / Math.PI;\n  const sign = vdot(vcross(u1, u2), a) < 0 ? -1 : 1;\n  return
    qmul(qaxis(a, sign * ang), q1);\n}\nfunction slerpArm(a, b, t) { return { u:
    qslerp(a.u, b.u, t), l: qslerp(a.l, b.l, t), h: qslerp(a.h, b.h, t) }; }\nfunction
    easeInOut(x) { x = clamp01(x); return x * x * (3 - 2 * x); }\nfunction f3(x)
    { return (Math.round(x * 1000) / 1000).toString(); }\n// Script clock (seconds),
    advanced in tick(); used for cooldowns. Data timestamps use Date.now().\nfunction
    nowSec() { return $.state.npc_clock || 0; }\n\n// ----------------------------------------------------------------
    bone cache\nlet boneNodes = [];\nlet nodeByBone = {};\n\nfunction cacheBones()
    {\n  boneNodes = [];\n  nodeByBone = {};\n  if (typeof BONE_MAP === \"undefined\")
    return;\n  for (let i = 0; i < BONE_MAP.length; i++) {\n    const entry = BONE_MAP[i];\n   
    const node = $.subNode(entry.name);\n    if (!node) continue;\n    const parentBone
    = (typeof BONE_PARENT !== \"undefined\" && BONE_PARENT[entry.bone] !== undefined)
    ? BONE_PARENT[entry.bone] : null;\n    const info = {\n      bone: entry.bone,\n     
    node: node,\n      parentBone: parentBone,\n      rest: entry.rest !== undefined
    ? entry.rest : IDENT,\n      restParent: entry.restParent !== undefined ? entry.restParent
    : IDENT,\n    };\n    boneNodes.push(info);\n    nodeByBone[entry.bone] = info;\n 
    }\n}\n\nfunction itemPose() {\n  const pos = $.getPosition();\n  const rot =
    $.getRotation();\n  return { pos: pos || v3(0, 0, 0), rot: rot || IDENT };\n}\nfunction
    toLocal(world, ip) { return qrot(qinv(ip.rot), vsub(world, ip.pos)); }\nfunction
    toWorld(local, ip) { return vadd(ip.pos, qrot(ip.rot, local)); }\n\n// Rest geometry
    (item-local, measured once while the model is still in its rest pose and visible).\nfunction
    measureRest() {\n  const need = [HumanoidBone.RightUpperArm, HumanoidBone.RightLowerArm,
    HumanoidBone.RightHand,\n                HumanoidBone.LeftUpperArm, HumanoidBone.LeftLowerArm,
    HumanoidBone.LeftHand,\n                HumanoidBone.Head, HumanoidBone.Hips];\n 
    const ip = itemPose();\n  const p = {};\n  for (const b of need) {\n    const
    info = nodeByBone[b];\n    if (!info) return null;\n    const gp = info.node.getGlobalPosition();\n   
    if (!gp) return null;\n    p[b] = toLocal(gp, ip);\n  }\n  const right = vhoriz(vsub(p[HumanoidBone.RightUpperArm],
    p[HumanoidBone.LeftUpperArm]));\n  const fwd = vnorm(vcross(right, UP));\n  const
    rest = {\n    right: right, fwd: fwd,\n    sR: p[HumanoidBone.RightUpperArm],
    sL: p[HumanoidBone.LeftUpperArm],\n    head: p[HumanoidBone.Head],\n    axisRU:
    vnorm(vsub(p[HumanoidBone.RightLowerArm], p[HumanoidBone.RightUpperArm])),\n   
    axisRL: vnorm(vsub(p[HumanoidBone.RightHand], p[HumanoidBone.RightLowerArm])),\n   
    axisLU: vnorm(vsub(p[HumanoidBone.LeftLowerArm], p[HumanoidBone.LeftUpperArm])),\n   
    axisLL: vnorm(vsub(p[HumanoidBone.LeftHand], p[HumanoidBone.LeftLowerArm])),\n   
    L1: vlen(vsub(p[HumanoidBone.RightLowerArm], p[HumanoidBone.RightUpperArm])),\n   
    L2: vlen(vsub(p[HumanoidBone.RightHand], p[HumanoidBone.RightLowerArm])),\n 
    };\n  if (rest.L1 < 0.05 || rest.L2 < 0.05) return null;\n  measureFingers(rest,
    p[HumanoidBone.RightHand], ip);\n  return rest;\n}\n\n// Right-hand fingers in
    the rest pose: joint offsets from the hand bone, flexion axes, and the contact
    point of the\n// curled hand (rest.contact: components along the fingers (a),
    the palm normal (b) and the thumb side (c); see\n// palmOffset). The contact
    point sits at the middle fingertip along the hand and on the plane of the most
    palm-side\n// point of the curled fingers (plus the pad), so nothing of the hand
    comes closer to the face than STOP_MARGIN.\n// Without finger bones the fingers
    stay straight and the contact point is CONTACT_LEN / PALM_OFF.\nfunction measureFingers(rest,
    hand, ip) {\n  rest.fingers = [];\n  rest.contact = { a: NPC_CFG.CONTACT_LEN,
    b: NPC_CFG.PALM_OFF, c: 0 };\n  const e1 = rest.axisRL, e2 = vnorm(perpTo(PALM_DOWN,
    e1)), e3 = vcross(e2, e1);\n  let maxB = -1, mid = null;\n  for (let i = 0; i
    < R_FINGERS.length; i++) {\n    const f = R_FINGERS[i];\n    const pts = [];\n   
    for (const b of f.bones) {\n      const info = nodeByBone[b];\n      const gp
    = info ? info.node.getGlobalPosition() : null;\n      if (!gp) break;\n     
    pts.push(vsub(toLocal(gp, ip), hand));\n    }\n    if (pts.length < 3) continue;\n   
    const segs = [vsub(pts[1], pts[0]), vsub(pts[2], pts[1])];\n    segs.push(vscale(segs[1],
    0.9));        // distal phalanx (no end bone): about the intermediate one's length\n   
    const curl = NPC_CFG.FINGER_CURL[f.name] || [0, 0, 0];\n    const axis = vnorm(vcross(vnorm(segs[0]),
    PALM_DOWN));   // flexion: fingers toward the palm\n    rest.fingers.push({ i:
    i, axis: axis, curl: curl });\n    if (f.name === \"Thumb\") continue;\n    //
    curled joint and tip positions (rest frame, relative to the hand bone)\n    let
    q = IDENT, pt = pts[0];\n    for (let k = 0; k < 3; k++) {\n      q = qmul(q,
    qaxis(axis, curl[k] || 0));\n      pt = vadd(pt, qrot(q, segs[k]));\n      if
    (vdot(pt, e2) > maxB) maxB = vdot(pt, e2);\n    }\n    if (f.name === \"Middle\")
    mid = pt;\n  }\n  if (mid && maxB > -1) rest.contact = { a: vdot(mid, e1), b:
    maxB + NPC_CFG.FINGER_PAD, c: vdot(mid, e3) };\n  $.log(\"[NPC] fingers: \" +
    rest.fingers.length + \" curled, contact a=\" + f3(rest.contact.a) + \" b=\"
    + f3(rest.contact.b) + \" c=\" + f3(rest.contact.c));\n}\n\nfunction restGeom()
    {\n  if ($.state.npc_rest) return $.state.npc_rest;\n  if (boneNodes.length ===
    0) cacheBones();\n  const r = measureRest();\n  if (r) {\n    $.state.npc_rest
    = r;\n    $.log(\"[NPC] rest geometry: L1=\" + f3(r.L1) + \" L2=\" + f3(r.L2)
    + \" shoulderH=\" + f3(r.sR.y));\n  }\n  return r;\n}\n\n// ----------------------------------------------------------------
    visibility & face\nfunction applyVisibility() {\n  const node = $.subNode(NPC_CFG.MODEL_NODE);\n 
    if (!node) return;\n  try { node.setEnabled(!!$.state.npc_visible); } catch (e)
    { $.log(\"[NPC] setEnabled failed: \" + e); }\n  applyRiser();\n  $.state.npc_visibilityApplied
    = !!$.state.npc_visible;\n}\nfunction setVisible(v) {\n  $.state.npc_visible
    = !!v;\n  applyVisibility();\n}\n// Facial expressions: Cluster Script cannot
    write blend-shape weights, so the face mesh carries an Animator\n// (clips NpcFaceNeutral
    / Joy / Surprised) driven by two CCK Set Animator Value gimmicks that listen
    to this\n// item's state: Bool JOY_KEY -> Animator \"joy\", signal SURPRISED_KEY
    -> Animator trigger \"surprised\".\n// Joy face on/off (held for the duration
    of a reaction).\nfunction setJoy(on) {\n  on = !!on;\n  if (!!$.state.npc_joy
    === on) return;\n  $.state.npc_joy = on;\n  if (on) $.state.npc_smiles = ($.state.npc_smiles
    || 0) + 1;\n  try { $.setStateCompat(\"this\", NPC_CFG.JOY_KEY, on); } catch
    (e) { $.log(\"[NPC] setJoy: \" + e); }\n}\n// Surprised face for 1 s (the clip
    length), then back to the previous face.\nfunction surprise() {\n  const t =
    nowSec();\n  if (t - ($.state.npc_lastSurprise || 0) < NPC_CFG.TOUCH_COOLDOWN_SEC)
    return;\n  $.state.npc_lastSurprise = t;\n  $.state.npc_gTouch = ($.state.npc_gTouch
    || 0) + 1;\n  try { $.sendSignalCompat(\"this\", NPC_CFG.SURPRISED_KEY); } catch
    (e) { $.log(\"[NPC] surprise: \" + e); }\n}\nfunction clearReaction() {\n  if
    ($.state.npc_react) $.state.npc_lastReactEnd = nowSec();\n  $.state.npc_react
    = null;\n  setJoy(false);\n}\n\n// ----------------------------------------------------------------
    lifecycle\n$.onStart(() => {\n  $.state.npc_phase = \"idle\";\n  $.state.npc_mode
    = \"none\";\n  $.state.npc_t = 0;\n  $.state.npc_social = false;\n  $.state.npc_visible
    = false;\n  $.state.npc_trial = null;\n  $.state.npc_rest = null;\n  $.state.npc_trace
    = [];\n  $.state.npc_glide = null;\n  $.state.npc_joy = false;\n  try { $.setStateCompat(\"this\",
    NPC_CFG.JOY_KEY, false); } catch (e) { /* no gimmick yet */ }\n  cacheBones();\n 
    $.log(\"[NPC] started, bones=\" + boneNodes.length);\n});\n\n$.onReceive((messageType,
    arg, sender) => {\n  try {\n    if (arg && arg.fwd) $.state.npc_fwd = arg.fwd;  
    // facing direction of the participant's marker\n    if (arg && arg.origin) $.state.npc_origin
    = arg.origin;   // the marker (participant standing spot, floor)\n    if (arg
    && typeof arg.floorY === \"number\") $.state.npc_floorY = arg.floorY;\n    if
    (arg && arg.eyes !== undefined) $.state.npc_useEyes = !!arg.eyes;   // may the
    eye bones be queried?\n    if (messageType === \"npc_setup\") {\n      if (arg
    && arg.social !== undefined) $.state.npc_social = !!arg.social;\n      $.state.npc_phase
    = \"idle\";\n      $.state.npc_t = 0;\n      resetHeights();            // the
    participant's avatar (and so their height) changes in this block\n      $.log(\"[NPC]
    setup social=\" + $.state.npc_social);\n    } else if (messageType === \"npc_hide\")
    {\n      $.state.npc_mode = \"none\";\n      $.state.npc_phase = \"idle\";\n     
    $.state.npc_pendingStart = false;   // e.g. a session reset right after a trial
    start: stay hidden\n      clearReaction();\n      resetHeights();\n      setVisible(false);\n   
    } else if (messageType === \"npc_show\") {\n      if (arg && arg.social !== undefined)
    $.state.npc_social = !!arg.social;\n      $.state.npc_phase = \"idle\";\n     
    $.state.npc_t = 0;\n      $.state.npc_standKind = \"greet\";   // face to face,
    in front of the marker\n      beginHeightMatch();        // the participant wears
    this block's avatar now; retried in tick() if unreadable\n      moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    false);\n      setVisible(true);\n      $.log(\"[NPC] shown social=\" + $.state.npc_social);\n   
    } else if (messageType === \"npc_greeting_begin\") {\n      if (arg && arg.social
    !== undefined) $.state.npc_social = !!arg.social;\n      if (!$.state.npc_visible)
    { $.state.npc_standKind = \"greet\"; moveToStand(NPC_CFG.IDLE_EXTRA_DIST, false);
    setVisible(true); }\n      beginGreeting();\n    } else if (messageType === \"npc_greeting_end\")
    {\n      endGreeting();\n    } else if (messageType === \"npc_trial_start\")
    {\n      $.state.npc_trial = arg || {};\n      if (arg && arg.social !== undefined)
    $.state.npc_social = !!arg.social;\n      if ($.state.npc_mode === \"greeting\")
    endGreeting();\n      // touch layout: leave the greeting spot in front (disappear);
    the NPC reappears behind-right of the participant\n      // once they are back
    on the marker (tick), then steps in a moment later\n      $.state.npc_glide =
    null;\n      if ($.state.npc_visible && $.state.npc_standKind !== \"touch\")
    { clearReaction(); setVisible(false); }\n      $.state.npc_standKind = \"touch\";\n     
    $.state.npc_phase = \"idle\";\n      // put the participant back on the marker
    (facing along it, on their platform), then wait a moment\n      const reset =
    !!(arg && arg.reset) && resetParticipant(true);\n      $.state.npc_startDelay
    = reset ? NPC_CFG.RESET_SETTLE_SEC : 0;\n      $.state.npc_pendingStart = true;\n   
    } else if (messageType === \"npc_abort\") {\n      leave(false);\n    }\n  }
    catch (e) {\n    $.log(\"[NPC] onReceive error: \" + e);\n  }\n});\n\n// ----------------------------------------------------------------
    participant\nfunction participant() {\n  try {\n    const ps = $.groupState ?
    $.groupState.participants : null;\n    // An enrolled participant who left is
    not replaced by a bystander (for example the next person, who is\n    // being
    asked by LUIDA whether they are a new participant): the trial stalls until the
    director's timeout\n    // or the session reset. The nearby-player fallback is
    only for a world without enrolled participants.\n    if (ps && ps.length > 0)
    return (ps[0] && ps[0].exists()) ? ps[0] : null;\n  } catch (e) { /* not a group
    member */ }\n  const near = $.getPlayersNear($.getPosition(), 50);\n  return
    near && near.length > 0 ? near[0] : null;\n}\n\nfunction headOf(p) {\n  const
    pos = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const rot = p.getHumanoidBoneRotation(HumanoidBone.Head);\n 
    if (!pos || !rot) return null;\n  // eye height in the head frame (null when
    the eye bones are not queried, missing or implausible)\n  let eyeUp = null;\n 
    const useEyes = ($.state.npc_useEyes === undefined || $.state.npc_useEyes ===
    null) ? NPC_CFG.USE_EYE_BONES : $.state.npc_useEyes;\n  if (useEyes) {\n    const
    le = p.getHumanoidBonePosition(HumanoidBone.LeftEye), re = p.getHumanoidBonePosition(HumanoidBone.RightEye);\n   
    const eye = (le && re) ? vscale(vadd(le, re), 0.5) : (le || re);\n    if (eye)
    { const local = qrot(qinv(rot), vsub(eye, pos)); if (local.y > 0.02 && local.y
    < 0.2) eyeUp = local.y; }\n  }\n  return { pos: pos, rot: rot, fwd: qrot(rot,
    v3(0, 0, 1)), eyeUp: eyeUp };\n}\n// Height of the touch target above the head
    bone (head frame): under the eyes when the avatar has eye bones.\nfunction faceUp(head)
    {\n  return (head.eyeUp !== null && head.eyeUp !== undefined) ? head.eyeUp -
    NPC_CFG.CHEEK_BELOW_EYES : NPC_CFG.FACE_UP;\n}\n// Touch target: in front of
    the participant's face, FACE_SIDE toward their right (head local +x), FACE_FWD
    forward.\nfunction facePointWorld(head) {\n  return vadd(head.pos, qrot(head.rot,
    v3(NPC_CFG.FACE_SIDE, faceUp(head), NPC_CFG.FACE_FWD)));\n}\n// The participant's
    head yaw frame (horizontal forward and right).\nfunction headYawFrame(head) {\n 
    const f = vhoriz(head.fwd);\n  return { f: f, r: vcross(UP, f) };\n}\n// Ready
    point of the contact point: in front of and to the right of the face target (the
    hand comes in diagonally).\nfunction readyContactWorld(head, Tw) {\n  const hf
    = headYawFrame(head);\n  return vadd(Tw, vadd(vadd(vscale(hf.r, NPC_CFG.APPROACH_SIDE),
    vscale(hf.f, NPC_CFG.APPROACH_FWD)), vscale(UP, NPC_CFG.APPROACH_UP)));\n}\n//
    Touching hand (world directions): fingers h across the face toward the participant's
    left, turned forward by\n// HAND_ACROSS_YAW_DEG and up by HAND_ACROSS_TILT_DEG;
    palm normal n toward the right cheek (back-left, horizontal);\n// the thumb (n
    x h) then points up.\nfunction touchHandFrameWorld(head) {\n  const hf = headYawFrame(head);\n 
    const yaw = NPC_CFG.HAND_ACROSS_YAW_DEG * Math.PI / 180, tilt = NPC_CFG.HAND_ACROSS_TILT_DEG
    * Math.PI / 180;\n  const across = vadd(vscale(hf.r, -Math.cos(yaw)), vscale(hf.f,
    Math.sin(yaw)));\n  const h = vnorm(vadd(vscale(across, Math.cos(tilt)), vscale(UP,
    Math.sin(tilt))));\n  const n = vnorm(vscale(vadd(vscale(hf.r, Math.sin(yaw)),
    vscale(hf.f, Math.cos(yaw))), -1));\n  return { h: h, n: n };\n}\nfunction frameToLocal(fr,
    ip) { const qi = qinv(ip.rot); return { h: qrot(qi, fr.h), n: qrot(qi, fr.n)
    }; }\n\n// Standing pose for the current layout ($.state.npc_standKind: \"greet\"
    = in front of the marker, face to face;\n// \"touch\" = behind-right of it).
    extraDist = 0 -> reach spot (the hand reaches the face target with a slightly
    bent\n// arm); extraDist > 0 -> that much farther out (conversation distance).
    Heights: the participant stands on the floor\n// plus their platform, the NPC
    on the floor plus its riser.\nfunction standPose(extraDist) {\n  const p = participant();
    if (!p) return null;\n  const head = headOf(p); if (!head) return null;\n  const
    rest = restGeom(); if (!rest) return null;\n  const root = p.getPosition() ||
    v3(head.pos.x, head.pos.y - 1.5, head.pos.z);\n  const platformH = $.state.npc_platformH
    || 0, lift = $.state.npc_lift || 0;\n  const floorY = (typeof $.state.npc_floorY
    === \"number\") ? $.state.npc_floorY : root.y - platformH;\n  const g = {\n   
    head: head, rest: rest, root: root, platformH: platformH, floorY: floorY, feetY:
    floorY + lift,\n    reach: (rest.L1 + rest.L2) * ($.state.npc_standKind === \"touch\"
    ? NPC_CFG.TOUCH_STAND_FACTOR : NPC_CFG.STAND_FACTOR),\n    // the marker (falls
    back to the participant's head and facing)\n    o: $.state.npc_origin || head.pos,\n   
    pfwd: $.state.npc_fwd ? vhoriz($.state.npc_fwd) : vhoriz(head.fwd),\n  };\n 
    return $.state.npc_standKind === \"touch\" ? touchStandPose(g, extraDist || 0)
    : greetStandPose(g, extraDist || 0);\n}\n// In front of the marker, facing it:
    the distance at which a straight hand would reach the face from the front\n//
    (the earlier frontal touch), plus extraDist.\nfunction greetStandPose(g, extraDist)
    {\n  const head = g.head, rest = g.rest;\n  const pHeadH = head.pos.y - g.root.y;     
    // the participant's own height, wherever they stand now\n  const dy = (g.floorY
    + g.platformH + pHeadH + faceUp(head)) - (g.feetY + rest.sR.y);\n  const lateral
    = Math.abs(vdot(rest.sR, rest.right));\n  // Bisection on x = forward distance
    from the right shoulder to the face point, so that the\n  // wrist needed at
    the stop position (palm STOP_MARGIN before the face) is `reach` from the shoulder.\n 
    function wristDist(x) {\n    const face = vadd(vadd(vscale(rest.right, -lateral),
    vscale(UP, dy)), vscale(rest.fwd, x));\n    const d = vnorm(face);\n    const
    F = vsub(face, vscale(d, NPC_CFG.STOP_MARGIN));\n    return vlen(vsub(F, straightPalmOffset(reachHandFrame(d))));\n 
    }\n  let lo = 0.05, hi = 1.5;\n  for (let i = 0; i < 30; i++) { const mid = (lo
    + hi) / 2; if (wristDist(mid) < g.reach) lo = mid; else hi = mid; }\n  const
    shoulderFwd = vdot(rest.sR, rest.fwd);\n  const horiz = Math.max(NPC_CFG.MIN_STAND_DIST,
    lo + shoulderFwd + NPC_CFG.FACE_FWD) + extraDist;\n  const pos = v3(g.o.x + g.pfwd.x
    * horiz, g.feetY, g.o.z + g.pfwd.z * horiz);\n  const faceDir = vhoriz(vsub(v3(g.o.x,
    0, g.o.z), v3(pos.x, 0, pos.z)));\n  const rot = qfromTo(rest.fwd, faceDir);\n 
    return { pos: pos, rot: rot, horiz: horiz, dy: dy, az: 0 };\n}\n// Behind-right
    of the marker (azimuth TOUCH_STAND_AZ_DEG), facing the marker's facing turned
    by TOUCH_BODY_YAW_DEG:\n// the farthest distance along that line from which the
    right wrist still reaches the end of the approach (the\n// contact point STOP_MARGIN
    before the cheek, touching hand frame) within `reach`; extraDist farther for
    the\n// conversation spot.\nfunction touchStandPose(g, extraDist) {\n  const
    head = g.head, rest = g.rest;\n  const pr = vcross(UP, g.pfwd);\n  const az =
    NPC_CFG.TOUCH_STAND_AZ_DEG * Math.PI / 180, yaw = NPC_CFG.TOUCH_BODY_YAW_DEG
    * Math.PI / 180;\n  const u = vadd(vscale(g.pfwd, Math.cos(az)), vscale(pr, Math.sin(az)));\n 
    const facing = vadd(vscale(g.pfwd, Math.cos(yaw)), vscale(pr, Math.sin(yaw)));\n 
    const rot = qfromTo(rest.fwd, facing);\n  // face target with the participant
    standing on their platform (they may not have been lifted onto it yet)\n  const
    Tw0 = facePointWorld(head);\n  const Tw = v3(Tw0.x, Tw0.y + g.floorY + g.platformH
    - g.root.y, Tw0.z);\n  const dirW = vnorm(vsub(Tw, readyContactWorld(head, Tw)));\n 
    const W = vsub(vsub(Tw, vscale(dirW, NPC_CFG.STOP_MARGIN)), palmOffset(rest,
    touchHandFrameWorld(head)));\n  const base = v3(g.o.x, g.feetY, g.o.z);\n  const
    S0 = qrot(rot, rest.sR);\n  // the wrist at the start of the approach (ready
    point)\n  const W0 = vsub(readyContactWorld(head, Tw), palmOffset(rest, touchHandFrameWorld(head)));\n 
    function shoulderAt(D) { return vadd(vadd(base, vscale(u, D)), S0); }\n  function
    wristDist(D) { return vlen(vsub(W, shoulderAt(D))); }\n  const minD = NPC_CFG.TOUCH_MIN_STAND_DIST;\n 
    let lo = Math.max(minD, vdot(vsub(W, vadd(base, S0)), u)), hi = 1.5;\n  if (wristDist(lo)
    <= g.reach) {\n    for (let i = 0; i < 30; i++) { const mid = (lo + hi) / 2;
    if (wristDist(mid) <= g.reach) lo = mid; else hi = mid; }\n  }\n  // then step
    closer (down to the minimum) while the start of the approach is not comfortably
    within reach\n  const startReach = (rest.L1 + rest.L2) * NPC_CFG.TOUCH_START_FACTOR;\n 
    while (lo > minD + 1e-6 && vlen(vsub(W0, shoulderAt(lo))) > startReach) lo =
    Math.max(minD, lo - 0.005);\n  const horiz = lo + extraDist;\n  const pos = vadd(base,
    vscale(u, horiz));\n  return { pos: pos, rot: rot, horiz: horiz, dy: Tw.y - (g.feetY
    + rest.sR.y), az: NPC_CFG.TOUCH_STAND_AZ_DEG };\n}\nfunction moveToStand(extraDist,
    glide) {\n  const sp = standPose(extraDist);\n  if (!sp) return false;\n  if
    (glide) {\n    const ip = itemPose();\n    $.state.npc_glide = { fromPos: ip.pos,
