--- !u!114 &1910187786163740648
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6915775039710669198}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61061896c654489a41575fc291bf4a0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ClusterVR.CreatorKit.Item.Implements::ClusterVR.CreatorKit.Item.Implements.ScriptableItem
  sourceCodeAsset: {fileID: 0}
  sourceCode: "// NPC bone map: generated by Study4SceneBuilder from Assets/_Experiment_/Avatars/PhantomTouch/Source/luida_default_avatar_02.vrm\n//
    Do not edit manually: LUIDA > Study4 > Regenerate NPC bone map from the scene
    model.\n// rest / restParent: rotation of the bone / of its transform parent
    relative to the item root, in the\n// model's rest pose. BONE_PARENT: nearest
    listed ancestor.\n\nconst AVATAR_SYNC_HIPS_Y = true;\nconst AVATAR_HIPS_Y_OFFSET
    = 0;\n\nconst AVATAR_HIPS_PARENT_REST_ROT = new Quaternion(0, 0, 0, 1);\nconst
    AVATAR_HIPS_PARENT_REST_POS = new Vector3(0, 0, 0);\n\nconst BONE_MAP = [\n 
    { bone: HumanoidBone.Hips, name: \"J_Bip_C_Hips\", rest: new Quaternion(0.06289843,
    0, 0, 0.9980199), restParent: new Quaternion(0, 0, 0, 1) },\n  { bone: HumanoidBone.Spine,
    name: \"J_Bip_C_Spine\", rest: new Quaternion(0.07566475, 0, 0, 0.9971334), restParent:
    new Quaternion(0.06289843, 0, 0, 0.9980199) },\n  { bone: HumanoidBone.Chest,
    name: \"J_Bip_C_Chest\", rest: new Quaternion(-0.060871, 0, 0, 0.9981458), restParent:
    new Quaternion(0.07566475, 0, 0, 0.9971334) },\n  { bone: HumanoidBone.Neck,
    name: \"J_Bip_C_Neck\", rest: new Quaternion(0.05973143, 0, 0, 0.9982147), restParent:
    new Quaternion(-0.1682905, 0, 0, 0.9857376) },\n  { bone: HumanoidBone.Head,
    name: \"J_Bip_C_Head\", rest: new Quaternion(0.005404245, -2.190967E-07, -2.511393E-08,
    0.9999857), restParent: new Quaternion(0.05973143, 0, 0, 0.9982147) },\n  { bone:
    HumanoidBone.LeftShoulder, name: \"J_Bip_L_Shoulder\", rest: new Quaternion(0,
    2.328306E-09, 0.07061428, 0.9975039), restParent: new Quaternion(-0.1682905,
    0, 0, 0.9857376) },\n  { bone: HumanoidBone.LeftUpperArm, name: \"J_Bip_L_UpperArm\",
    rest: new Quaternion(-7.450581E-09, 1.227551E-09, 7.190206E-09, 1), restParent:
    new Quaternion(0, 2.328306E-09, 0.07061428, 0.9975039) },\n  { bone: HumanoidBone.LeftLowerArm,
    name: \"J_Bip_L_LowerArm\", rest: new Quaternion(-7.450581E-09, 2.832009E-10,
    7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, 1.227551E-09, 7.190206E-09,
    1) },\n  { bone: HumanoidBone.LeftHand, name: \"J_Bip_L_Hand\", rest: new Quaternion(-7.450581E-09,
    2.832009E-10, 7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, 2.832009E-10,
    7.192827E-09, 1) },\n  { bone: HumanoidBone.RightShoulder, name: \"J_Bip_R_Shoulder\",
    rest: new Quaternion(0, -2.328306E-09, -0.07061428, 0.9975039), restParent: new
    Quaternion(-0.1682905, 0, 0, 0.9857376) },\n  { bone: HumanoidBone.RightUpperArm,
    name: \"J_Bip_R_UpperArm\", rest: new Quaternion(-7.450581E-09, -1.227551E-09,
    -7.190206E-09, 1), restParent: new Quaternion(0, -2.328306E-09, -0.07061428,
    0.9975039) },\n  { bone: HumanoidBone.RightLowerArm, name: \"J_Bip_R_LowerArm\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -1.227551E-09, -7.190206E-09, 1) },\n  { bone:
    HumanoidBone.RightHand, name: \"J_Bip_R_Hand\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.LeftUpperLeg, name: \"J_Bip_L_UpperLeg\",
    rest: new Quaternion(0.01046093, 0, 0, 0.9999453), restParent: new Quaternion(0.06289843,
    0, 0, 0.9980199) },\n  { bone: HumanoidBone.LeftLowerLeg, name: \"J_Bip_L_LowerLeg\",
    rest: new Quaternion(0.03326847, 0, 0, 0.9994465), restParent: new Quaternion(0.01046093,
    0, 0, 0.9999453) },\n  { bone: HumanoidBone.RightUpperLeg, name: \"J_Bip_R_UpperLeg\",
    rest: new Quaternion(0.01046093, 0, 0, 0.9999453), restParent: new Quaternion(0.06289843,
    0, 0, 0.9980199) },\n  { bone: HumanoidBone.RightLowerLeg, name: \"J_Bip_R_LowerLeg\",
    rest: new Quaternion(0.03326847, 0, 0, 0.9994465), restParent: new Quaternion(0.01046093,
    0, 0, 0.9999453) },\n  { bone: HumanoidBone.LeftEye, name: \"J_Adj_L_FaceEye\",
    rest: new Quaternion(0.02570083, -0.1889786, 0.005137843, 0.9816316), restParent:
    new Quaternion(0.005404245, -2.190967E-07, -2.511393E-08, 0.9999857) },\n  {
    bone: HumanoidBone.RightEye, name: \"J_Adj_R_FaceEye\", rest: new Quaternion(0.02570083,
    0.1889782, -0.00513789, 0.9816317), restParent: new Quaternion(0.005404245, -2.190967E-07,
    -2.511393E-08, 0.9999857) },\n  { bone: HumanoidBone.RightThumbProximal, name:
    \"J_Bip_R_Thumb1\", rest: new Quaternion(0.7031665, -0.2467994, 0.2439799, 0.6205814),
    restParent: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n 
    { bone: HumanoidBone.RightThumbIntermediate, name: \"J_Bip_R_Thumb2\", rest:
    new Quaternion(0.7077863, -0.2292977, 0.2319948, 0.62661), restParent: new Quaternion(0.7031665,
    -0.2467994, 0.2439799, 0.6205814) },\n  { bone: HumanoidBone.RightThumbDistal,
    name: \"J_Bip_R_Thumb3\", rest: new Quaternion(0.700076, -0.2624655, 0.2513979,
    0.6146586), restParent: new Quaternion(0.7077863, -0.2292977, 0.2319948, 0.62661)
    },\n  { bone: HumanoidBone.RightIndexProximal, name: \"J_Bip_R_Index1\", rest:
    new Quaternion(-7.450581E-09, 0.009704283, 1.583248E-08, 0.9999532), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightIndexIntermediate, name: \"J_Bip_R_Index2\", rest: new Quaternion(-2.30968E-06,
    0.01926568, -0.01444243, 0.9997103), restParent: new Quaternion(-7.450581E-09,
    0.009704283, 1.583248E-08, 0.9999532) },\n  { bone: HumanoidBone.RightIndexDistal,
    name: \"J_Bip_R_Index3\", rest: new Quaternion(-9.602308E-05, 0.01667643, -0.01736773,
    0.9997104), restParent: new Quaternion(-2.30968E-06, 0.01926568, -0.01444243,
    0.9997103) },\n  { bone: HumanoidBone.RightMiddleProximal, name: \"J_Bip_R_Middle1\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightMiddleIntermediate, name: \"J_Bip_R_Middle2\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightMiddleDistal, name: \"J_Bip_R_Middle3\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightRingProximal, name: \"J_Bip_R_Ring1\", rest: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightRingIntermediate, name: \"J_Bip_R_Ring2\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightRingDistal, name: \"J_Bip_R_Ring3\", rest: new Quaternion(-1.490116E-08,
    0.01143836, -0.006218723, 0.9999155), restParent: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1) },\n  { bone: HumanoidBone.RightLittleProximal,
    name: \"J_Bip_R_Little1\", rest: new Quaternion(-7.450581E-09, -2.832009E-10,
    -7.192827E-09, 1), restParent: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09,
    1) },\n  { bone: HumanoidBone.RightLittleIntermediate, name: \"J_Bip_R_Little2\",
    rest: new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1), restParent:
    new Quaternion(-7.450581E-09, -2.832009E-10, -7.192827E-09, 1) },\n  { bone:
    HumanoidBone.RightLittleDistal, name: \"J_Bip_R_Little3\", rest: new Quaternion(-2.235174E-08,
    -0.009609761, 0.007768773, 0.9999238), restParent: new Quaternion(-7.450581E-09,
    -2.832009E-10, -7.192827E-09, 1) },\n];\n\nconst BONE_PARENT = {\n  [HumanoidBone.Hips]:
    null,\n  [HumanoidBone.Spine]: HumanoidBone.Hips,\n  [HumanoidBone.Chest]: HumanoidBone.Spine,\n 
    [HumanoidBone.Neck]: HumanoidBone.Chest,\n  [HumanoidBone.Head]: HumanoidBone.Neck,\n 
    [HumanoidBone.LeftShoulder]: HumanoidBone.Chest,\n  [HumanoidBone.LeftUpperArm]:
    HumanoidBone.LeftShoulder,\n  [HumanoidBone.LeftLowerArm]: HumanoidBone.LeftUpperArm,\n 
    [HumanoidBone.LeftHand]: HumanoidBone.LeftLowerArm,\n  [HumanoidBone.RightShoulder]:
    HumanoidBone.Chest,\n  [HumanoidBone.RightUpperArm]: HumanoidBone.RightShoulder,\n 
    [HumanoidBone.RightLowerArm]: HumanoidBone.RightUpperArm,\n  [HumanoidBone.RightHand]:
    HumanoidBone.RightLowerArm,\n  [HumanoidBone.LeftUpperLeg]: HumanoidBone.Hips,\n 
    [HumanoidBone.LeftLowerLeg]: HumanoidBone.LeftUpperLeg,\n  [HumanoidBone.RightUpperLeg]:
    HumanoidBone.Hips,\n  [HumanoidBone.RightLowerLeg]: HumanoidBone.RightUpperLeg,\n 
    [HumanoidBone.LeftEye]: HumanoidBone.Head,\n  [HumanoidBone.RightEye]: HumanoidBone.Head,\n 
    [HumanoidBone.RightThumbProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightThumbIntermediate]:
    HumanoidBone.RightThumbProximal,\n  [HumanoidBone.RightThumbDistal]: HumanoidBone.RightThumbIntermediate,\n 
    [HumanoidBone.RightIndexProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightIndexIntermediate]:
    HumanoidBone.RightIndexProximal,\n  [HumanoidBone.RightIndexDistal]: HumanoidBone.RightIndexIntermediate,\n 
    [HumanoidBone.RightMiddleProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightMiddleIntermediate]:
    HumanoidBone.RightMiddleProximal,\n  [HumanoidBone.RightMiddleDistal]: HumanoidBone.RightMiddleIntermediate,\n 
    [HumanoidBone.RightRingProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightRingIntermediate]:
    HumanoidBone.RightRingProximal,\n  [HumanoidBone.RightRingDistal]: HumanoidBone.RightRingIntermediate,\n 
    [HumanoidBone.RightLittleProximal]: HumanoidBone.RightHand,\n  [HumanoidBone.RightLittleIntermediate]:
    HumanoidBone.RightLittleProximal,\n  [HumanoidBone.RightLittleDistal]: HumanoidBone.RightLittleIntermediate,\n};\n\r\n//
    ===== Study 4 NPC controller =====\n// Runs on the NPC item (a LUIDA avatar wrapper
    built from a VRM, with AvatarSyncClone.js\n// replaced by this script). Expects
    the generated NPC_BoneMap.js header to be prepended\n// by LuidaScriptCombiner
    (BONE_MAP, BONE_PARENT, AVATAR_* constants).\n//\n// Messages (sent by the NpcDirector
    state-listening item):\n//   \"npc_setup\"           { social, fwd, origin, floorY
    } -> remember the social-cue condition and the marker\n//                                                 
    (standing spot, facing direction, floor height); clear the\n//                                                 
    height matching of the previous block; NPC stays hidden\n//   \"npc_hide\"           
    {}                    -> hide the body (avatar-switch phase)\n//   \"npc_show\"           
    { social? }           -> match heights (platform under a shorter participant
    / riser under a\n//                                                  shorter
    NPC), stand at conversation distance in front of the marker\n//                                                 
    and show the body\n//   \"npc_greeting_begin\"  { social? }           -> greeting
    period (social condition only): head gaze with body\n//                                                 
    turn, surprised face when touched; answers the cues below\n//   \"npc_greet_cue\"      
    { cue }               -> the participant has followed an instruction of the guided
    greeting\n//                                                  (GreetingGuide
    item; cue = \"hello\" (sent before the first instruction:\n//                                                 
    the NPC greets first) | \"wave\" | \"lookAway\" | \"lookBack\" | \"move\" |\n//                                                 
    \"lookAgain\" | \"center\"): social condition only, react as GREET_REACTIONS
    says\n//   \"npc_greeting_end\"    {}                    -> stop the greeting
    reactions, write greeting counters\n//   \"npc_trial_start\"     { block, rep,
    avatar, social, fwd, reset } -> (reset: put the participant back on the\n//                                                 
    marker, on their platform) -> (reappear at the conversation spot if\n//                                                 
    hidden) -> turn to the participant and step closer -> prep -> raise hand\n//                                                 
    -> approach (2 cm/s) -> stroke the face vertically (2 cm/s) -> hold\n//                                                 
    -> retract -> step back to the conversation spot -> hide -> npc_done\n//   \"npc_abort\"          
    {}                    -> step back and hide (no npc_done)\n// Output:\n//   item
    signal \"npc_done\" once the NPC has stepped back and hidden (a GlobalLogic on
    this item relays it to\n//   the global signal \"npc_done\")\n//   per-trial
    measurements merged into $.groupState.collectedData (this item is an ItemGroupMember)\n//\n//
    All pose math is done in the item-local frame of the NPC root, in the \"normalized
    skeleton\"\n// convention used by Cluster (T-pose = identity). The same world->local
    retargeting formula as\n// AvatarSyncClone.js is used to drive the bone sub-nodes.\n\nconst
    NPC_CFG = {\n  REACH_SPEED: 0.02,       // m/s (thesis 6.2.3)\n  PREP_SEC: 2.0,          
    // wait (and step closer) before the hand is raised\n  READY_SEC: 1.2,         
    // raise the hand to the ready position (fast, not part of the stimulus)\n  READY_FRAC:
    0.35,        // ready palm point: this fraction of the way from the right shoulder
    to the face\n                           // (the approach then extends the arm
    along the shoulder->face line)\n  // stroke: the fingers slide down the face
    at REACH_SPEED from the target (eyes + x, x = eyes - mouth) to halfway\n  //  
    between the eyes and the mouth, i.e. 1.5 x (at least STROKE_AMP_MIN), then ...\n 
    STROKE_AMP_MIN: 0.03,\n  STROKE_INWARD: -0.1,     //   (while sliding down, the
    fingers also move this much toward the face per metre down;\n                          
    //   negative: away from it. Starting at the forehead, the fingertips, which
    are above\n                           //   the contact point, meet the fringe
    hanging in front of the eyes near the bottom of\n                           //  
    the stroke; -0.1 keeps them off it: 0.9 cm farther at the bottom of a 9 cm stroke)\n 
    STROKE_BACK: 0.03,       //   ... return to the top along an arc that swings
    this far back from the face ...\n  STROKE_CYCLES: 2,        //   ... this many
    times in total (0 disables the stroke; 3 until 2026-11-12)\n  STROKE_RETURN_SPEED:
    0.04, // speed along the return arc (m/s)\n  STROKE_RAMP_SEC: 0.4,    // every
    leg of the stroke starts from rest and ends at rest: it accelerates for this
    long,\n                           //   keeps the leg's speed, then decelerates
    for this long (a leg too short to reach the\n                           //  
    speed accelerates half-way and decelerates); 0 = constant speed\n  HOLD_SEC:
    1.0,           // rest where the last stroke ended\n  RETRACT_SPEED: 0.10,    
    // m/s\n  STOP_MARGIN: 0.02,       // stop this far before the face surface\n 
    // Touch target in the participant's head frame, on the side the NPC's right
    hand comes from. Height: eyes + x, where\n  // x = eyes - mouth (relative to
    the head bone):\n  //   eyes: the eye bones' midpoint, or EYE_UP when they are
    not read (LUIDA's test mode) or missing;\n  //   mouth: MOUTH_UP. Humanoid avatars
    have no mouth bone (the optional jaw bone is missing on VRoid models and sits\n 
    //   at the jaw joint anyway); on the project's VRoid models the mouth (the centre
    of the vertices the mouth-open\n  //   blend shape moves) is 0.1-0.4 cm below
    the head bone, so the head bone's height is used.\n  EYE_UP: 0.063,          
    //   the eye bones sit 6.2-6.4 cm above the head bone on the project's VRoid
    models\n  MOUTH_UP: 0,\n  TARGET_UP_OFFSET: 0.02,  //   the target is this much
    higher than eyes + x (the stroke still ends halfway between the eyes\n                          
    //   and the mouth, so it is this much longer)\n  USE_EYE_BONES: false,    //  
    query the eye bones at all? Cluster returns null for missing bones, but the editor\n                          
    //   emulator (CSEmulator) throws a .NET exception that aborts the whole handler,
    so the\n                           //   director turns this on only outside LUIDA's
    test mode (npc_setup { eyes })\n  FACE_SIDE: 0.04,         //   toward the participant's
    left (0 = midline of the face)\n  FACE_FWD: 0.110,         //   forward of the
    head bone (the forehead with the fringe is 10-10.5 cm forward on the\n                          
    //   project's VRoid models at FACE_SIDE, 10-14 cm above the head bone). 0.09
    when the target\n                           //   was the cheek, 0.100 until the
    fingers still went into the face in a test on 2026-11-12\n\n  CONTACT_LEN: 0.12,      
    // wrist -> contact point along the fingers (finger pads) (m)\n  PALM_OFF: 0.015,        
    // palm-side offset of the contact point along the palm normal (m)\n  HAND_PITCH_DEG:
    30,      // reaching hand: fingers this far above horizontal (45 until 2026-11-12);
    palm turned toward the face\n  SAMPLE_INTERVAL: 0.1,    // 10 Hz trace\n  STAND_FACTOR:
    0.93,      // usable fraction of (upper arm + forearm + finger) when choosing
    the reach spot\n  MIN_STAND_DIST: 0.40,    // minimum horizontal root-to-head
    distance at the reach spot (m)\n  IDLE_EXTRA_DIST: 0.45,   // conversation distance
    = reach distance + this (m)\n  MAX_SAMPLES: 400,        // trace cap (10 Hz ->
    40 s)\n  GLIDE_SEC: 1.0,          // step closer / step back duration\n  REAPPEAR_SEC:
    0.5,       // 2nd trial of a block: shown at the conversation spot this long
    before stepping in\n  RESET_SETTLE_SEC: 1.0,   // touch start: wait this long
    after putting the participant back on the marker\n  HEIGHT_MATCH_MIN: 0.05, 
    // match heights only when the head-bone heights differ by at least this (m):\n                          
    //   participant shorter -> platform under the participant (HeightPlatform item);\n                          
    //   NPC shorter -> the NPC stands on its Riser sub-node\n  HEIGHT_MEASURE_SEC:
    3.0, // keep trying to read the participant's bones this long after npc_show\n 
    // Guided greeting: the participant follows the GreetingGuide item's instructions
    one by one; each time it reports\n  // one as done (\"npc_greet_cue\"), the NPC
    answers like this (social condition only; nothing otherwise). nod / wave:\n 
    // the gesture, joy: smile while it lasts, turn: the whole body turns to face
    the participant. An answer with a wave\n  // lasts WAVE_SEC, a nod alone NOD_SEC,
    a turn about 1 s (BODY_TURN_RATE). The guide waits for the answer to end\n  //
    before its next instruction and before the touch, in both conditions: its GG_HELLO
    / GG_STEPS 'react' times\n  // must not be shorter (tests/greeting-guide.test.mjs
    checks this).\n  GREET_REACTIONS: {\n    hello: { nod: true, wave: true, joy:
    true },       // before the first instruction: the NPC greets first\n    wave:
    { nod: true, wave: true, joy: true },        // the participant waved: wave back,
    nodding and smiling\n    lookBack: { nod: true, joy: true },                //
    looked away, then at the NPC again: nod and smile\n    move: { turn: true },                             
    // stepped aside: turn to them (head and eyes follow anyway)\n    lookAgain:
    { wave: true, joy: true },              // ... and looked at the NPC again: wave
    and smile\n    center: { turn: true },                            // back on
    the marker, facing forward: turn to them again\n  },\n  PREP_REACTION: { nod:
    true, wave: true, joy: true }, // touch phase, before the hand is raised: greet
    once\n  HEAD_MAX_DEG: 50,        // gaze: the head alone turns up to this angle
    ...\n  EYE_EXTRA_DEG: 12,       // ... and the eyes a bit further\n  BODY_TURN_START_DEG:
    35, // greeting: if the participant is farther than this from the NPC's facing,\n 
    BODY_TURN_STOP_DEG: 4,   //   the whole body turns toward them (lerp) until within
    this angle;\n  BODY_TURN_RATE: 2.5,     //   exponential rate (1/s). The head's
    local rotation unwinds as the body turns.\n  LOOK_AT_DEG: 30,         // participant
    \"looks at\" the NPC when head forward is within this angle\n  LOOK_AWAY_DEG:
    45,       // ... and stops when it exceeds this angle (hysteresis)\n  HAND_RAISE_OFFSET:
    0.10, // a hand counts as raised when above (head height - this)\n  NOD_SEC:
    0.8,            // nod-only reaction duration\n  NOD_DEG: 15,\n  WAVE_SEC: 1.6,          
    // reaction duration when it includes a wave\n  TOUCH_COOLDOWN_SEC: 1.5, // surprised
    face when touched: minimum interval\n  TOUCH_HAND_MARGIN: 0.06, // participant
    hand bone (wrist) -> fingers allowance (m)\n  RETREAT_THRESHOLD: 0.02, // m,
    for the in-world retreat-onset estimate\n  MODEL_NODE: \"Model\",     // sub-node
    holding the VRM model (toggled for visibility)\n  JOY_KEY: \"npc_joy\",     
    // item Bool state -> Set Animator Value gimmick on the face mesh -> Animator
    Bool \"joy\"\n  SURPRISED_KEY: \"npc_surprised\", // item signal -> gimmick ->
    Animator Trigger \"surprised\" (1 s clip)\n                           // (Joy:
    Fcl_EYE_Joy=100, Fcl_MTH_Joy=50; Surprised: Fcl_EYE_Surprised=50, Fcl_MTH_Surprised=50)\n 
    RISER_NODE: \"Riser\",     // 5 m cube under the NPC's feet (top at the feet);
    shown while the NPC is lifted\n  PLATFORM_ITEM: \"HeightPlatform\", // world
    item reference: the platform under the participant's standing spot\n};\n\nconst
    IDENT = new Quaternion(0, 0, 0, 1);\nconst UP = new Vector3(0, 1, 0);\n// Right-hand
    finger bones in NPC_BoneMap.js: kept straight, i.e. given the hand's rotation
    every frame (applyPose\n// gives a bone without a rotation the identity in the
    item frame, not its parent's).\nconst R_FINGER_BONES = [\n  HumanoidBone.RightThumbProximal,
    HumanoidBone.RightThumbIntermediate, HumanoidBone.RightThumbDistal,\n  HumanoidBone.RightIndexProximal,
    HumanoidBone.RightIndexIntermediate, HumanoidBone.RightIndexDistal,\n  HumanoidBone.RightMiddleProximal,
    HumanoidBone.RightMiddleIntermediate, HumanoidBone.RightMiddleDistal,\n  HumanoidBone.RightRingProximal,
    HumanoidBone.RightRingIntermediate, HumanoidBone.RightRingDistal,\n  HumanoidBone.RightLittleProximal,
    HumanoidBone.RightLittleIntermediate, HumanoidBone.RightLittleDistal,\n];\n\n//
    ---------------------------------------------------------------- math helpers\nfunction
    v3(x, y, z) { return new Vector3(x, y, z); }\nfunction vadd(a, b) { return v3(a.x
    + b.x, a.y + b.y, a.z + b.z); }\nfunction vsub(a, b) { return v3(a.x - b.x, a.y
    - b.y, a.z - b.z); }\nfunction vscale(a, s) { return v3(a.x * s, a.y * s, a.z
    * s); }\nfunction vdot(a, b) { return a.x * b.x + a.y * b.y + a.z * b.z; }\nfunction
    vcross(a, b) { return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x *
    b.y - a.y * b.x); }\nfunction vlen(a) { return Math.sqrt(vdot(a, a)); }\nfunction
    vnorm(a) { const l = vlen(a); return l > 1e-9 ? vscale(a, 1 / l) : v3(0, 0, 1);
    }\nfunction vlerp(a, b, t) { return vadd(a, vscale(vsub(b, a), t)); }\nfunction
    vhoriz(a) { return vnorm(v3(a.x, 0, a.z)); }\nfunction vcopy(a) { return v3(a.x,
    a.y, a.z); }\nfunction hdist(a, b) { const dx = a.x - b.x, dz = a.z - b.z; return
    Math.sqrt(dx * dx + dz * dz); }\n\nfunction qmul(a, b) {\n  return new Quaternion(\n   
    a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,\n    a.w * b.y - a.x * b.z + a.y
    * b.w + a.z * b.x,\n    a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,\n    a.w
    * b.w - a.x * b.x - a.y * b.y - a.z * b.z);\n}\nfunction qinv(q) { return new
    Quaternion(-q.x, -q.y, -q.z, q.w); }\nfunction qrot(q, v) {\n  const tx = 2 *
    (q.y * v.z - q.z * v.y);\n  const ty = 2 * (q.z * v.x - q.x * v.z);\n  const
    tz = 2 * (q.x * v.y - q.y * v.x);\n  return v3(\n    v.x + q.w * tx + (q.y *
    tz - q.z * ty),\n    v.y + q.w * ty + (q.z * tx - q.x * tz),\n    v.z + q.w *
    tz + (q.x * ty - q.y * tx));\n}\nfunction qaxis(axis, deg) {\n  const a = vnorm(axis);\n 
    const h = deg * Math.PI / 360;\n  const s = Math.sin(h);\n  return new Quaternion(a.x
    * s, a.y * s, a.z * s, Math.cos(h));\n}\n// Minimal rotation taking direction
    a to direction b.\nfunction qfromTo(a, b) {\n  const an = vnorm(a), bn = vnorm(b);\n 
    const d = Math.max(-1, Math.min(1, vdot(an, bn)));\n  if (d > 0.99999) return
    new Quaternion(0, 0, 0, 1);\n  if (d < -0.99999) {\n    let axis = vcross(v3(1,
    0, 0), an);\n    if (vlen(axis) < 1e-6) axis = vcross(v3(0, 1, 0), an);\n   
    return qaxis(axis, 180);\n  }\n  const axis = vcross(an, bn);\n  return qaxis(axis,
    Math.acos(d) * 180 / Math.PI);\n}\nfunction qslerp(a, b, t) {\n  if (t <= 0)
    return a; if (t >= 1) return b;\n  let cos = a.x * b.x + a.y * b.y + a.z * b.z
    + a.w * b.w;\n  let bx = b.x, by = b.y, bz = b.z, bw = b.w;\n  if (cos < 0) {
    cos = -cos; bx = -bx; by = -by; bz = -bz; bw = -bw; }\n  if (cos > 0.9995) {\n   
    return qnormalize(new Quaternion(a.x + (bx - a.x) * t, a.y + (by - a.y) * t,
    a.z + (bz - a.z) * t, a.w + (bw - a.w) * t));\n  }\n  const th = Math.acos(cos),
    s = Math.sin(th);\n  const wa = Math.sin((1 - t) * th) / s, wb = Math.sin(t *
    th) / s;\n  return new Quaternion(a.x * wa + bx * wb, a.y * wa + by * wb, a.z
    * wa + bz * wb, a.w * wa + bw * wb);\n}\nfunction qnormalize(q) {\n  const l
    = Math.sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w) || 1;\n  return new
    Quaternion(q.x / l, q.y / l, q.z / l, q.w / l);\n}\nfunction qangleDeg(q) { return
    2 * Math.acos(Math.max(-1, Math.min(1, Math.abs(q.w)))) * 180 / Math.PI; }\nfunction
    qclamp(q, maxDeg) { const a = qangleDeg(q); return a > maxDeg ? qslerp(IDENT,
    q, maxDeg / a) : q; }\nfunction clamp01(x) { return Math.max(0, Math.min(1, x));
    }\nfunction perpTo(v, axis) { const a = vnorm(axis); return vsub(v, vscale(a,
    vdot(v, a))); }\n// Rotation that maps restAxis -> axis AND turns restRef (perpendicular
    to restAxis) as close as\n// possible to ref (projected perpendicular to axis).
    This fixes the twist around the bone axis\n// (e.g. which way the palm faces),
    which a minimal from-to rotation leaves undetermined.\nfunction basisRot(restAxis,
    restRef, axis, ref) {\n  const q1 = qfromTo(restAxis, axis);\n  const a = vnorm(axis);\n 
    const p1 = perpTo(qrot(q1, restRef), a);\n  const p2 = perpTo(ref, a);\n  if
    (vlen(p1) < 1e-4 || vlen(p2) < 1e-4) return q1;\n  const u1 = vnorm(p1), u2 =
    vnorm(p2);\n  const ang = Math.acos(Math.max(-1, Math.min(1, vdot(u1, u2))))
    * 180 / Math.PI;\n  const sign = vdot(vcross(u1, u2), a) < 0 ? -1 : 1;\n  return
    qmul(qaxis(a, sign * ang), q1);\n}\nfunction slerpArm(a, b, t) { return { u:
    qslerp(a.u, b.u, t), l: qslerp(a.l, b.l, t), h: qslerp(a.h, b.h, t) }; }\nfunction
    easeInOut(x) { x = clamp01(x); return x * x * (3 - 2 * x); }\nfunction f3(x)
    { return (Math.round(x * 1000) / 1000).toString(); }\n// Script clock (seconds),
    advanced in tick(); used for cooldowns. Data timestamps use Date.now().\nfunction
    nowSec() { return $.state.npc_clock || 0; }\n\n// ----------------------------------------------------------------
    bone cache\nlet boneNodes = [];\nlet nodeByBone = {};\n\nfunction cacheBones()
    {\n  boneNodes = [];\n  nodeByBone = {};\n  if (typeof BONE_MAP === \"undefined\")
    return;\n  for (let i = 0; i < BONE_MAP.length; i++) {\n    const entry = BONE_MAP[i];\n   
    const node = $.subNode(entry.name);\n    if (!node) continue;\n    const parentBone
    = (typeof BONE_PARENT !== \"undefined\" && BONE_PARENT[entry.bone] !== undefined)
    ? BONE_PARENT[entry.bone] : null;\n    const info = {\n      bone: entry.bone,\n     
    node: node,\n      parentBone: parentBone,\n      rest: entry.rest !== undefined
    ? entry.rest : IDENT,\n      restParent: entry.restParent !== undefined ? entry.restParent
    : IDENT,\n    };\n    boneNodes.push(info);\n    nodeByBone[entry.bone] = info;\n 
    }\n}\n\nfunction itemPose() {\n  const pos = $.getPosition();\n  const rot =
    $.getRotation();\n  return { pos: pos || v3(0, 0, 0), rot: rot || IDENT };\n}\nfunction
    toLocal(world, ip) { return qrot(qinv(ip.rot), vsub(world, ip.pos)); }\nfunction
    toWorld(local, ip) { return vadd(ip.pos, qrot(ip.rot, local)); }\n\n// Rest geometry
    (item-local, measured once while the model is still in its rest pose and visible).\nfunction
    measureRest() {\n  const need = [HumanoidBone.RightUpperArm, HumanoidBone.RightLowerArm,
    HumanoidBone.RightHand,\n                HumanoidBone.LeftUpperArm, HumanoidBone.LeftLowerArm,
    HumanoidBone.LeftHand,\n                HumanoidBone.Head, HumanoidBone.Hips];\n 
    const ip = itemPose();\n  const p = {};\n  for (const b of need) {\n    const
    info = nodeByBone[b];\n    if (!info) return null;\n    const gp = info.node.getGlobalPosition();\n   
    if (!gp) return null;\n    p[b] = toLocal(gp, ip);\n  }\n  const right = vhoriz(vsub(p[HumanoidBone.RightUpperArm],
    p[HumanoidBone.LeftUpperArm]));\n  const fwd = vnorm(vcross(right, UP));\n  const
    rest = {\n    right: right, fwd: fwd,\n    sR: p[HumanoidBone.RightUpperArm],
    sL: p[HumanoidBone.LeftUpperArm],\n    head: p[HumanoidBone.Head],\n    axisRU:
    vnorm(vsub(p[HumanoidBone.RightLowerArm], p[HumanoidBone.RightUpperArm])),\n   
    axisRL: vnorm(vsub(p[HumanoidBone.RightHand], p[HumanoidBone.RightLowerArm])),\n   
    axisLU: vnorm(vsub(p[HumanoidBone.LeftLowerArm], p[HumanoidBone.LeftUpperArm])),\n   
    axisLL: vnorm(vsub(p[HumanoidBone.LeftHand], p[HumanoidBone.LeftLowerArm])),\n   
    L1: vlen(vsub(p[HumanoidBone.RightLowerArm], p[HumanoidBone.RightUpperArm])),\n   
    L2: vlen(vsub(p[HumanoidBone.RightHand], p[HumanoidBone.RightLowerArm])),\n 
    };\n  if (rest.L1 < 0.05 || rest.L2 < 0.05) return null;\n  return rest;\n}\n\nfunction
    restGeom() {\n  if ($.state.npc_rest) return $.state.npc_rest;\n  if (boneNodes.length
    === 0) cacheBones();\n  const r = measureRest();\n  if (r) {\n    $.state.npc_rest
    = r;\n    $.log(\"[NPC] rest geometry: L1=\" + f3(r.L1) + \" L2=\" + f3(r.L2)
    + \" shoulderH=\" + f3(r.sR.y));\n  }\n  return r;\n}\n\n// ----------------------------------------------------------------
    visibility & face\nfunction applyVisibility() {\n  const node = $.subNode(NPC_CFG.MODEL_NODE);\n 
    if (!node) return;\n  try { node.setEnabled(!!$.state.npc_visible); } catch (e)
    { $.log(\"[NPC] setEnabled failed: \" + e); }\n  applyRiser();\n  $.state.npc_visibilityApplied
    = !!$.state.npc_visible;\n}\nfunction setVisible(v) {\n  $.state.npc_visible
    = !!v;\n  applyVisibility();\n}\n// Facial expressions: Cluster Script cannot
    write blend-shape weights, so the face mesh carries an Animator\n// (clips NpcFaceNeutral
    / Joy / Surprised) driven by two CCK Set Animator Value gimmicks that listen
    to this\n// item's state: Bool JOY_KEY -> Animator \"joy\", signal SURPRISED_KEY
    -> Animator trigger \"surprised\".\n// Joy face on/off (held for the duration
    of a reaction).\nfunction setJoy(on) {\n  on = !!on;\n  if (!!$.state.npc_joy
    === on) return;\n  $.state.npc_joy = on;\n  if (on) $.state.npc_smiles = ($.state.npc_smiles
    || 0) + 1;\n  try { $.setStateCompat(\"this\", NPC_CFG.JOY_KEY, on); } catch
    (e) { $.log(\"[NPC] setJoy: \" + e); }\n}\n// Surprised face for 1 s (the clip
    length), then back to the previous face.\nfunction surprise() {\n  const t =
    nowSec();\n  if (t - ($.state.npc_lastSurprise || 0) < NPC_CFG.TOUCH_COOLDOWN_SEC)
    return;\n  $.state.npc_lastSurprise = t;\n  $.state.npc_gTouch = ($.state.npc_gTouch
    || 0) + 1;\n  try { $.sendSignalCompat(\"this\", NPC_CFG.SURPRISED_KEY); } catch
    (e) { $.log(\"[NPC] surprise: \" + e); }\n}\nfunction clearReaction() {\n  $.state.npc_react
    = null;\n  setJoy(false);\n}\n\n// ----------------------------------------------------------------
    lifecycle\n$.onStart(() => {\n  $.state.npc_phase = \"idle\";\n  $.state.npc_mode
    = \"none\";\n  $.state.npc_t = 0;\n  $.state.npc_social = false;\n  $.state.npc_visible
    = false;\n  $.state.npc_trial = null;\n  $.state.npc_rest = null;\n  $.state.npc_trace
    = [];\n  $.state.npc_glide = null;\n  $.state.npc_joy = false;\n  try { $.setStateCompat(\"this\",
    NPC_CFG.JOY_KEY, false); } catch (e) { /* no gimmick yet */ }\n  cacheBones();\n 
    $.log(\"[NPC] started, bones=\" + boneNodes.length);\n});\n\n$.onReceive((messageType,
    arg, sender) => {\n  try {\n    if (arg && arg.fwd) $.state.npc_fwd = arg.fwd;  
    // facing direction of the participant's marker\n    if (arg && arg.origin) $.state.npc_origin
    = arg.origin;   // the marker (participant standing spot, floor)\n    if (arg
    && typeof arg.floorY === \"number\") $.state.npc_floorY = arg.floorY;\n    if
    (arg && arg.eyes !== undefined) $.state.npc_useEyes = !!arg.eyes;   // may the
    eye bones be queried?\n    if (messageType === \"npc_setup\") {\n      if (arg
    && arg.social !== undefined) $.state.npc_social = !!arg.social;\n      $.state.npc_phase
    = \"idle\";\n      $.state.npc_t = 0;\n      resetHeights();            // the
    participant's avatar (and so their height) changes in this block\n      $.log(\"[NPC]
    setup social=\" + $.state.npc_social);\n    } else if (messageType === \"npc_hide\")
    {\n      $.state.npc_mode = \"none\";\n      $.state.npc_phase = \"idle\";\n     
    $.state.npc_pendingStart = false;   // e.g. a session reset right after a trial
    start: stay hidden\n      clearReaction();\n      resetHeights();\n      setVisible(false);\n   
    } else if (messageType === \"npc_show\") {\n      if (arg && arg.social !== undefined)
    $.state.npc_social = !!arg.social;\n      $.state.npc_phase = \"idle\";\n     
    $.state.npc_t = 0;\n      beginHeightMatch();        // the participant wears
    this block's avatar now; retried in tick() if unreadable\n      moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    false);\n      setVisible(true);\n      $.log(\"[NPC] shown social=\" + $.state.npc_social);\n   
    } else if (messageType === \"npc_greeting_begin\") {\n      if (arg && arg.social
    !== undefined) $.state.npc_social = !!arg.social;\n      if (!$.state.npc_visible)
    { moveToStand(NPC_CFG.IDLE_EXTRA_DIST, false); setVisible(true); }\n      beginGreeting();\n   
    } else if (messageType === \"npc_greet_cue\") {\n      greetCue(arg ? arg.cue
    : \"\");\n    } else if (messageType === \"npc_greeting_end\") {\n      endGreeting();\n   
    } else if (messageType === \"npc_trial_start\") {\n      $.state.npc_trial =
    arg || {};\n      if (arg && arg.social !== undefined) $.state.npc_social = !!arg.social;\n     
    if ($.state.npc_mode === \"greeting\") endGreeting();\n      // put the participant
    back on the marker (facing along it, on their platform), then wait a moment\n     
    const reset = !!(arg && arg.reset) && resetParticipant(true);\n      let delay
    = reset ? NPC_CFG.RESET_SETTLE_SEC : 0;\n      if (!$.state.npc_visible) {\n       
    // hidden since the previous trial: reappear at the conversation spot, then step
    in a moment later\n        moveToStand(NPC_CFG.IDLE_EXTRA_DIST, false);\n       
    setVisible(true);\n        delay = Math.max(delay, NPC_CFG.REAPPEAR_SEC);\n     
    }\n      if (delay > 0) { $.state.npc_startDelay = delay; $.state.npc_pendingStart
    = true; }\n      else startTrial();\n    } else if (messageType === \"npc_abort\")
    {\n      leave(false);\n    }\n  } catch (e) {\n    $.log(\"[NPC] onReceive error:
    \" + e);\n  }\n});\n\n// ----------------------------------------------------------------
    participant\nfunction participant() {\n  try {\n    const ps = $.groupState ?
    $.groupState.participants : null;\n    // An enrolled participant who left is
    not replaced by a bystander (for example the next person, who is\n    // being
    asked by LUIDA whether they are a new participant): the trial stalls until the
    director's timeout\n    // or the session reset. The nearby-player fallback is
    only for a world without enrolled participants.\n    if (ps && ps.length > 0)
    return (ps[0] && ps[0].exists()) ? ps[0] : null;\n  } catch (e) { /* not a group
    member */ }\n  const near = $.getPlayersNear($.getPosition(), 50);\n  return
    near && near.length > 0 ? near[0] : null;\n}\n\nfunction headOf(p) {\n  const
    pos = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const rot = p.getHumanoidBoneRotation(HumanoidBone.Head);\n 
    if (!pos || !rot) return null;\n  // touch target height in the head frame (eyes
    + x, x = eyes - mouth) and how far the stroke goes down from it (to\n  // halfway
    between the eyes and the mouth: 1.5 x)\n  let eyesUp = null;\n  const useEyes
    = ($.state.npc_useEyes === undefined || $.state.npc_useEyes === null) ? NPC_CFG.USE_EYE_BONES
    : $.state.npc_useEyes;\n  if (useEyes) {\n    const le = p.getHumanoidBonePosition(HumanoidBone.LeftEye),
    re = p.getHumanoidBonePosition(HumanoidBone.RightEye);\n    const eye = (le &&
    re) ? vscale(vadd(le, re), 0.5) : (le || re);\n    if (eye) {\n      const local
    = qrot(qinv(rot), vsub(eye, pos));\n      if (local.y > 0.02 && local.y < 0.2)
    eyesUp = local.y;\n    }\n  }\n  const eyes = eyesUp !== null ? eyesUp : NPC_CFG.EYE_UP,
    mouth = NPC_CFG.MOUTH_UP;\n  const x = eyes - mouth;\n  const up = eyes + x +
    NPC_CFG.TARGET_UP_OFFSET;\n  const strokeAmp = Math.max(NPC_CFG.STROKE_AMP_MIN,
    up - (eyes + mouth) / 2);\n  return { pos: pos, rot: rot, fwd: qrot(rot, v3(0,
    0, 1)), up: up, upSrc: eyesUp !== null ? \"eyeBones\" : \"EYE_UP\", strokeAmp:
    strokeAmp, eyesUp: eyesUp };\n}\n// Height of the touch target above the head
    bone (head frame) (see headOf).\nfunction faceUp(head) { return head.up; }\n//
    Touch target: eyes + (eyes - mouth) high (see headOf), FACE_SIDE toward the participant's
    left (head local -x), FACE_FWD\n// forward.\nfunction facePointWorld(head) {\n 
    return vadd(head.pos, qrot(head.rot, v3(-NPC_CFG.FACE_SIDE, faceUp(head), NPC_CFG.FACE_FWD)));\n}\n\n//
    Standing pose in front of the participant's marker. extraDist = 0 -> reach spot
    (the palm reaches the\n// face point with a slightly bent arm); extraDist > 0
    -> that much farther (conversation distance).\n// Heights: the participant stands
    on the floor plus their platform, the NPC on the floor plus its riser.\nfunction
    standPose(extraDist) {\n  const p = participant(); if (!p) return null;\n  const
    head = headOf(p); if (!head) return null;\n  const rest = restGeom(); if (!rest)
    return null;\n  const root = p.getPosition() || v3(head.pos.x, head.pos.y - 1.5,
    head.pos.z);\n  const reach = (rest.L1 + rest.L2) * NPC_CFG.STAND_FACTOR;\n 
    const platformH = $.state.npc_platformH || 0, lift = $.state.npc_lift || 0;\n 
    const floorY = (typeof $.state.npc_floorY === \"number\") ? $.state.npc_floorY
    : root.y - platformH;\n  const feetY = floorY + lift;\n  const pHeadH = head.pos.y
    - root.y;      // the participant's own height, wherever they stand now\n  const
    dy = (floorY + platformH + pHeadH + faceUp(head)) - (feetY + rest.sR.y);\n  const
    lateral = Math.abs(vdot(rest.sR, rest.right));\n  // Bisection on x = forward
    distance from the right shoulder to the face point, so that the\n  // wrist needed
    at the stop position (palm STOP_MARGIN before the face) is `reach` from the shoulder.\n 
    function wristDist(x) {\n    const face = vadd(vadd(vscale(rest.right, -lateral),
    vscale(UP, dy)), vscale(rest.fwd, x));\n    const d = vnorm(face);\n    const
    F = vsub(face, vscale(d, NPC_CFG.STOP_MARGIN));\n    return vlen(vsub(F, palmOffset(reachHandFrame(d))));\n 
    }\n  let lo = 0.05, hi = 1.5;\n  for (let i = 0; i < 30; i++) { const mid = (lo
    + hi) / 2; if (wristDist(mid) < reach) lo = mid; else hi = mid; }\n  const shoulderFwd
    = vdot(rest.sR, rest.fwd);\n  const horiz = Math.max(NPC_CFG.MIN_STAND_DIST,
    lo + shoulderFwd + NPC_CFG.FACE_FWD) + (extraDist || 0);\n  // in front of the
    marker along its facing direction (falls back to the participant's head and facing)\n 
    const o = $.state.npc_origin;\n  const bx = o ? o.x : head.pos.x, bz = o ? o.z
    : head.pos.z;\n  const pfwd = $.state.npc_fwd ? vhoriz($.state.npc_fwd) : vhoriz(head.fwd);\n 
    const pos = v3(bx + pfwd.x * horiz, feetY, bz + pfwd.z * horiz);\n  const faceDir
    = vhoriz(vsub(v3(bx, 0, bz), v3(pos.x, 0, pos.z)));\n  const rot = qfromTo(rest.fwd,
    faceDir);\n  return { pos: pos, rot: rot, horiz: horiz, dy: dy };\n}\nfunction
    moveToStand(extraDist, glide) {\n  const sp = standPose(extraDist);\n  if (!sp)
    return false;\n  if (glide) {\n    const ip = itemPose();\n    $.state.npc_glide
    = { fromPos: ip.pos, fromRot: ip.rot, toPos: sp.pos, toRot: sp.rot, t: 0 };\n 
    } else {\n    $.state.npc_glide = null;\n    $.setPosition(sp.pos);\n    $.setRotation(sp.rot);\n 
    }\n  $.log(\"[NPC] stand \" + f3(sp.horiz) + \" m in front (dy=\" + f3(sp.dy)
    + \", glide=\" + !!glide + \")\");\n  return true;\n}\n\n// ----------------------------------------------------------------
    height matching\n// Head-bone heights are compared once the participant wears
    this block's avatar (npc_show). A participant\n// shorter by HEIGHT_MATCH_MIN
    or more gets a platform under the marker (HeightPlatform item, message\n// \"platform_set\"
    { h }); an NPC shorter by that much stands on its Riser sub-node. Cleared at
    the next setup.\nfunction resetHeights() {\n  $.state.npc_platformH = 0;\n  $.state.npc_lift
    = 0;\n  $.state.npc_heightPending = false;\n  sendPlatform(0);\n  applyRiser();\n}\nfunction
    sendPlatform(h) {\n  try { const it = $.worldItemReference(NPC_CFG.PLATFORM_ITEM);
    if (it) it.send(\"platform_set\", { h: h }); }\n  catch (e) { $.log(\"[NPC] platform_set
    failed: \" + e); }\n}\nfunction applyRiser() {\n  const r = $.subNode(NPC_CFG.RISER_NODE);\n 
    if (!r) return;\n  try { r.setEnabled(!!$.state.npc_visible && ($.state.npc_lift
    || 0) > 0); } catch (e) { $.log(\"[NPC] riser: \" + e); }\n}\n// Head-bone height
    above the feet, or null while the avatar's bones are not readable (very small
    avatars count: until\n// 2026-11-12 anything up to 0.5 m was taken for unreadable
    bones, so they got no height platform).\nfunction participantHeight(p) {\n  const
    head = p.getHumanoidBonePosition(HumanoidBone.Head);\n  const root = p.getPosition();\n 
    if (!head || !root) return null;\n  const h = head.y - root.y;\n  return h >
    0.05 ? h : null;\n}\nfunction beginHeightMatch() {\n  $.state.npc_heightPending
    = true;\n  $.state.npc_heightDeadline = nowSec() + NPC_CFG.HEIGHT_MEASURE_SEC;\n 
    tryHeightMatch();\n}\nfunction tryHeightMatch() {\n  if (!$.state.npc_heightPending)
    return;\n  const rest = restGeom();\n  const p = participant();\n  const pHeadH
    = (rest && p) ? participantHeight(p) : null;\n  if (pHeadH === null) {\n    if
    (nowSec() < ($.state.npc_heightDeadline || 0)) return;\n    $.state.npc_heightPending
    = false;\n    $.log(\"[NPC] height match skipped: participant bones not readable\");\n   
    return;\n  }\n  $.state.npc_heightPending = false;\n  const diff = rest.head.y
    - pHeadH;          // > 0: the participant is shorter\n  const platformH = diff
    >= NPC_CFG.HEIGHT_MATCH_MIN ? diff : 0;\n  const lift = -diff >= NPC_CFG.HEIGHT_MATCH_MIN
    ? -diff : 0;\n  $.state.npc_platformH = platformH;\n  $.state.npc_lift = lift;\n 
    sendPlatform(platformH);\n  applyRiser();\n  if (platformH > 0) resetParticipant(false);  
    // lift the participant onto the platform (keeps their facing)\n  if ($.state.npc_visible)
    moveToStand(NPC_CFG.IDLE_EXTRA_DIST, true);\n  pushData({ participantHeadH: pHeadH,
    npcHeadH: rest.head.y, heightPlatform: platformH, npcLift: lift });\n  $.log(\"[NPC]
    height match: participant head \" + f3(pHeadH) + \" m, NPC head \" + f3(rest.head.y)
    +\n        \" m -> platform \" + f3(platformH) + \", riser \" + f3(lift));\n}\n//
    Put the participant on the marker (on their platform); withRotation also turns
    them to face along it.\nfunction resetParticipant(withRotation) {\n  const p
    = participant();\n  const o = $.state.npc_origin;\n  if (!p || !o) return false;\n 
    try {\n    p.setPosition(v3(o.x, o.y + ($.state.npc_platformH || 0), o.z));\n   
    if (withRotation && $.state.npc_fwd) p.setRotation(qaxis(UP, Math.atan2($.state.npc_fwd.x,
    $.state.npc_fwd.z) * 180 / Math.PI));\n    return true;\n  } catch (e) { $.log(\"[NPC]
    resetParticipant failed: \" + e); return false; }\n}\n\n// ----------------------------------------------------------------
    greeting period\nfunction beginGreeting() {\n  $.state.npc_mode = \"greeting\";\n 
    $.state.npc_greetStartTs = Date.now();\n  $.state.npc_gGaze = 0; $.state.npc_gHand
    = 0; $.state.npc_gWaves = 0; $.state.npc_gNods = 0;\n  $.state.npc_gReact = 0;
    $.state.npc_smiles = 0; $.state.npc_gTouch = 0; $.state.npc_gCues = 0;\n  $.state.npc_gazeAligned
    = false;\n  $.state.npc_handUp = false;\n  $.state.npc_touching = false;\n  $.state.npc_bodyTurning
    = false;\n  $.state.npc_turnCueAt = null;\n  clearReaction();\n  $.log(\"[NPC]
    greeting begin social=\" + $.state.npc_social);\n}\nfunction endGreeting() {\n 
    if ($.state.npc_mode !== \"greeting\") return;\n  $.state.npc_mode = \"none\";\n 
    $.state.npc_bodyTurning = false;\n  pushData({\n    greetSec: (Date.now() - ($.state.npc_greetStartTs
    || Date.now())) / 1000,\n    greetGazeEvents: $.state.npc_gGaze || 0,\n    greetHandRaises:
    $.state.npc_gHand || 0,\n    greetCues: $.state.npc_gCues || 0,\n    greetNpcReactions:
    $.state.npc_gReact || 0,\n    greetNpcNods: $.state.npc_gNods || 0,\n    greetNpcWaves:
    $.state.npc_gWaves || 0,\n    greetNpcSmiles: $.state.npc_smiles || 0,\n    greetTouches:
    $.state.npc_gTouch || 0,\n  });\n  $.log(\"[NPC] greeting end: gaze=\" + ($.state.npc_gGaze
    || 0) + \" hands=\" + ($.state.npc_gHand || 0) +\n        \" cues=\" + ($.state.npc_gCues
    || 0) + \" reactions=\" + ($.state.npc_gReact || 0) + \" touches=\" + ($.state.npc_gTouch
    || 0));\n}\n// The participant has followed an instruction of the guided greeting:
    answer it (social condition only).\nfunction greetCue(cue) {\n  if ($.state.npc_mode
    !== \"greeting\") return;\n  $.state.npc_gCues = ($.state.npc_gCues || 0) + 1;\n 
    const r = $.state.npc_social ? NPC_CFG.GREET_REACTIONS[cue] : null;\n  $.log(\"[NPC]
    greet cue \" + cue + (r ? \" -> \" + JSON.stringify(r) : \" (no reaction)\"));\n 
    if (!r) return;\n  if (r.turn) { $.state.npc_bodyTurning = true; $.state.npc_turnCueAt
    = nowSec(); $.state.npc_turnCue = cue; }\n  if (r.nod || r.wave) startReaction(r,
    cue);\n}\n// Start a reaction r = { nod, wave, joy }: nod and / or left-hand
    wave, smiling while it lasts when joy is set (the\n// face returns to neutral
    when the reaction ends). Replaces a reaction that is still running. name: for
    the log.\nfunction startReaction(r, name) {\n  $.state.npc_react = { t: 0, nod:
    !!r.nod, wave: !!r.wave, dur: r.wave ? NPC_CFG.WAVE_SEC : NPC_CFG.NOD_SEC, name:
    name || \"\" };\n  $.state.npc_gReact = ($.state.npc_gReact || 0) + 1;\n  if
    (r.nod) $.state.npc_gNods = ($.state.npc_gNods || 0) + 1;\n  if (r.wave) $.state.npc_gWaves
    = ($.state.npc_gWaves || 0) + 1;\n  setJoy(!!r.joy);\n}\n// Rotate the whole
    body toward the participant when they are too far to the side, or when a greeting
    cue asked for\n// it (npc_bodyTurning), until it faces them (greeting only).\nfunction
    turnBodyToward(head, rest, ip, dt) {\n  const faceDir = vhoriz(vsub(head.pos,
    ip.pos));\n  const curFwd = vhoriz(qrot(ip.rot, rest.fwd));\n  const cosA = Math.max(-1,
    Math.min(1, vdot(curFwd, faceDir)));\n  const ang = Math.acos(cosA) * 180 / Math.PI;\n 
    if (!$.state.npc_bodyTurning && ang > NPC_CFG.BODY_TURN_START_DEG) $.state.npc_bodyTurning
    = true;\n  if (!$.state.npc_bodyTurning) return ip;\n  if (ang < NPC_CFG.BODY_TURN_STOP_DEG)
    {\n    $.state.npc_bodyTurning = false;\n    if ($.state.npc_turnCueAt !== null
    && $.state.npc_turnCueAt !== undefined) {\n      $.log(\"[NPC] reaction \" +
    ($.state.npc_turnCue || \"?\") + \" (turn) ended after \" + f3(nowSec() - $.state.npc_turnCueAt)
    + \" s\");\n      $.state.npc_turnCueAt = null;\n    }\n    return ip;\n  }\n 
    const yaw = cosA < -0.999 ? qaxis(UP, 180) : qfromTo(curFwd, faceDir);\n  const
    target = qmul(yaw, ip.rot);\n  const rot = qslerp(ip.rot, target, 1 - Math.exp(-NPC_CFG.BODY_TURN_RATE
    * dt));\n  $.setRotation(rot);\n  return { pos: ip.pos, rot: rot };\n}\n// Participant
    hand(s) touching the NPC's head / torso / arms (edge-triggered).\nfunction detectTouch(p,
    rest, ip) {\n  const hands = [p.getHumanoidBonePosition(HumanoidBone.LeftHand),
    p.getHumanoidBonePosition(HumanoidBone.RightHand)];\n  const parts = [\n    {
    bone: HumanoidBone.Head, up: 0.07, r: 0.13 },\n    { bone: HumanoidBone.Chest,
    up: 0.0, r: 0.17 },\n    { bone: HumanoidBone.Hips, up: 0.0, r: 0.16 },\n   
    { bone: HumanoidBone.LeftUpperArm, up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.RightUpperArm,
    up: 0.0, r: 0.07 },\n    { bone: HumanoidBone.LeftLowerArm, up: 0.0, r: 0.06
    },\n    { bone: HumanoidBone.RightLowerArm, up: 0.0, r: 0.06 },\n  ];\n  let
    touching = false;\n  for (const part of parts) {\n    const info = nodeByBone[part.bone];\n   
    if (!info) continue;\n    const gp = info.node.getGlobalPosition();\n    if (!gp)
    continue;\n    const c = vadd(gp, vscale(UP, part.up));\n    for (const h of
    hands) {\n      if (h && vlen(vsub(h, c)) < part.r + NPC_CFG.TOUCH_HAND_MARGIN)
    { touching = true; break; }\n    }\n    if (touching) break;\n  }\n  const edge
    = touching && !$.state.npc_touching;\n  $.state.npc_touching = touching;\n  return
    edge;\n}\n// Detect the participant's social signals (gaze alignment, raised
    hand) with hysteresis / edges.\nfunction detectParticipantSignals(p, head, rest,
    ip) {\n  const npcHeadW = toWorld(rest.head, ip);\n  const toNpc = vnorm(vsub(npcHeadW,
    head.pos));\n  const ang = Math.acos(Math.max(-1, Math.min(1, vdot(vnorm(head.fwd),
    toNpc)))) * 180 / Math.PI;\n  let gazeEdge = false;\n  if (!$.state.npc_gazeAligned
    && ang < NPC_CFG.LOOK_AT_DEG) { $.state.npc_gazeAligned = true; gazeEdge = true;
    }\n  else if ($.state.npc_gazeAligned && ang > NPC_CFG.LOOK_AWAY_DEG) { $.state.npc_gazeAligned
    = false; }\n\n  const lh = p.getHumanoidBonePosition(HumanoidBone.LeftHand);\n 
    const rh = p.getHumanoidBonePosition(HumanoidBone.RightHand);\n  const th = head.pos.y
    - NPC_CFG.HAND_RAISE_OFFSET;\n  const up = !!((lh && lh.y > th) || (rh && rh.y
    > th));\n  let handEdge = false;\n  if (up && !$.state.npc_handUp) { $.state.npc_handUp
    = true; handEdge = true; }\n  else if (!up && $.state.npc_handUp) { $.state.npc_handUp
    = false; }\n  return { gazeEdge: gazeEdge, handEdge: handEdge, aligned: $.state.npc_gazeAligned,
    handUp: up };\n}\n\n// ----------------------------------------------------------------
    trial control\nfunction startTrial() {\n  const rest = restGeom();\n  if (!rest)
    { $.log(\"[NPC] rest geometry not ready; trial start deferred\"); $.state.npc_pendingStart
    = true; return; }\n  $.state.npc_pendingStart = false;\n  moveToStand(0, true);                    
    // step closer to the reach spot during PREP\n  $.state.npc_phase = \"prep\";\n 
    $.state.npc_t = 0;\n  clearReaction();\n  $.state.npc_bodyTurning = false;\n 
    $.state.npc_lookedAt = false;\n  $.state.npc_lookTs = 0;\n  $.state.npc_greeted
    = false;\n  $.state.npc_trace = [];\n  traceBuf = [];\n  $.state.npc_trialStartTs
    = Date.now();\n  $.log(\"[NPC] trial start \" + JSON.stringify($.state.npc_trial
    || {}) + \" social=\" + $.state.npc_social);\n}\n\nlet traceBuf = [];\nlet sampleTimer
    = 0;\nlet baseSamples = [];\nlet baseRootSamples = [];\n\n// Ready palm point
    on the shoulder->face line (local). T = face target (local).\nfunction readyContact(rest,
    T) {\n  return vadd(rest.sR, vscale(vsub(T, rest.sR), NPC_CFG.READY_FRAC));\n}\n\nfunction
    beginApproach(head, rest, ip) {\n  const T = toLocal(facePointWorld(head), ip);\n 
    const H0 = readyContact(rest, T);  // local palm point; the hand is already here
    after the READY phase\n  const full = vlen(vsub(T, H0));\n  const L = Math.max(0.02,
    full - NPC_CFG.STOP_MARGIN);\n  $.state.npc_H0 = H0;\n  $.state.npc_T = T;\n 
    $.state.npc_L = L;\n  $.state.npc_dir = vnorm(vsub(T, H0));\n  const frame =
    reachHandFrame($.state.npc_dir);\n  $.state.npc_frame = frame;    // hand orientation
    is kept fixed during the approach\n  const Wend = vsub(vsub(T, vscale($.state.npc_dir,
    NPC_CFG.STOP_MARGIN)), palmOffset(frame));\n  $.state.npc_reachable = vlen(vsub(Wend,
    rest.sR)) <= (rest.L1 + rest.L2);\n  $.state.npc_phase = \"approach\";\n  $.state.npc_t
    = 0;\n  $.state.npc_reachStartTs = Date.now();\n  $.state.npc_headPos0 = vcopy(head.pos);\n 
    $.state.npc_faceUp = faceUp(head); $.state.npc_faceUpSrc = head.upSrc || \"headBone\";
    $.state.npc_strokeAmp = head.strokeAmp;\n  $.state.npc_eyeUp = head.eyesUp;\n 
    $.state.npc_headRot0 = head.rot.x + \",\" + head.rot.y + \",\" + head.rot.z +
    \",\" + head.rot.w;\n  $.state.npc_contactTs = 0;\n  $.state.npc_contactDist
    = -1;\n  $.state.npc_contactT = 0;\n  $.state.npc_strokeEndTs = 0;\n  $.state.npc_base
    = null;\n  $.state.npc_away = 0; $.state.npc_latMin = 0; $.state.npc_latMax =
    0;\n  $.state.npc_onsetDist = -1;\n  // the participant's avatar position: moved
    by the stick (NpcDirector's slow touch rate), not by leaning\n  const p = participant();\n 
    const root = p ? p.getPosition() : null;\n  const o = $.state.npc_origin;\n 
    $.state.npc_rootStart = root ? f3(root.x) + \",\" + f3(root.y) + \",\" + f3(root.z)
    : \"\";\n  $.state.npc_rootShiftPre = (root && o) ? hdist(root, o) : -1;   //
    moved off the marker before the reach began\n  $.state.npc_rootBase = null; $.state.npc_rootAway
    = 0;\n  baseRootSamples = [];\n  $.state.npc_axisW = vhoriz(qrot(ip.rot, $.state.npc_dir));\n 
    const H0w = toWorld(H0, ip), Tw = toWorld(T, ip);\n  $.state.npc_H0w = f3(H0w.x)
    + \",\" + f3(H0w.y) + \",\" + f3(H0w.z);\n  $.state.npc_Tw = f3(Tw.x) + \",\"
    + f3(Tw.y) + \",\" + f3(Tw.z);\n  baseSamples = [];\n  sampleTimer = 0;\n  $.log(\"[NPC]
    approach: path=\" + f3(L) + \" m, duration=\" + f3(L / NPC_CFG.REACH_SPEED) +
    \" s, reachable=\" + $.state.npc_reachable +\n        \", target \" + f3($.state.npc_faceUp)
    + \" m above the head bone (eyes from \" + $.state.npc_faceUpSrc + \"), stroke
    \" +\n        f3($.state.npc_strokeAmp) + \" m\");\n}\n\nfunction finishTrial()
    {\n  const traces = ($.state.npc_trace || []).concat(traceBuf);\n  traceBuf =
    [];\n  const tr = $.state.npc_trial || {};\n  const pEnd = participant();\n 
    const rootEnd = pEnd ? pEnd.getPosition() : null;\n  const o = $.state.npc_origin;\n 
    const data = {\n    social: $.state.npc_social ? \"with\" : \"without\",\n   
    npcBlock: tr.block !== undefined ? String(tr.block) : \"\",\n    npcRep: tr.rep
    !== undefined ? String(tr.rep) : \"\",\n    npcAvatar: tr.avatar !== undefined
    ? String(tr.avatar) : \"\",\n    trialStartTs: $.state.npc_trialStartTs || 0,\n   
    reachStartTs: $.state.npc_reachStartTs || 0,\n    contactTs: $.state.npc_contactTs
    || 0,\n    strokeEndTs: $.state.npc_strokeEndTs || 0,\n    strokeAmp: (typeof
    $.state.npc_strokeAmp === \"number\") ? $.state.npc_strokeAmp : \"\",\n    strokeBack:
    NPC_CFG.STROKE_BACK,\n    strokeCycles: NPC_CFG.STROKE_CYCLES,\n    strokeReturnSpeed:
    NPC_CFG.STROKE_RETURN_SPEED,\n    strokeRampSec: NPC_CFG.STROKE_RAMP_SEC,\n   
    heightPlatform: $.state.npc_platformH || 0,\n    npcLift: $.state.npc_lift ||
    0,\n    retractEndTs: Date.now(),\n    pathLen: $.state.npc_L || 0,\n    reachDur:
    ($.state.npc_contactTs && $.state.npc_reachStartTs) ? ($.state.npc_contactTs
    - $.state.npc_reachStartTs) / 1000 : 0,\n    contactDist: $.state.npc_contactDist,\n   
    reachable: !!$.state.npc_reachable,\n    headPos0: $.state.npc_headPos0 ? (f3($.state.npc_headPos0.x)
    + \",\" + f3($.state.npc_headPos0.y) + \",\" + f3($.state.npc_headPos0.z)) :
    \"\",\n    headRot0: $.state.npc_headRot0 || \"\",\n    faceUp: (typeof $.state.npc_faceUp
    === \"number\") ? $.state.npc_faceUp : -1,   // target height above the head
    bone (m)\n    faceUpSrc: $.state.npc_faceUpSrc || \"\",   // the eye height from:
    eyeBones / EYE_UP\n    eyeUp: (typeof $.state.npc_eyeUp === \"number\") ? $.state.npc_eyeUp
    : \"\",   // eye bones above the head bone\n    handStart: $.state.npc_H0w ||
    \"\",   // fingertip world position at approach start\n    faceTarget: $.state.npc_Tw
    || \"\",   // face target world position (fixed at approach start)\n    traceFormat:
    \"t,hx,hy,hz,hqx,hqy,hqz,hqw,d,rx,ry,rz\",   // r = avatar position (moved by
    the stick)\n    retreatOnsetDist: $.state.npc_onsetDist,\n    retreatDist: $.state.npc_away
    || 0,\n    oscAmp: ($.state.npc_latMax || 0) - ($.state.npc_latMin || 0),\n   
    rootStart: $.state.npc_rootStart || \"\",              // avatar position at
    approach start\n    rootShiftPre: (typeof $.state.npc_rootShiftPre === \"number\")
    ? $.state.npc_rootShiftPre : -1,  // off the marker then (m)\n    rootRetreat:
    $.state.npc_rootAway || 0,              // like retreatDist, for the avatar position\n   
    rootShiftEnd: (rootEnd && o) ? hdist(rootEnd, o) : -1, // off the marker at the
    end of the retract (m)\n    lookedAtNpc: !!$.state.npc_lookedAt,\n    lookTs:
    $.state.npc_lookTs || 0,\n    greeted: !!$.state.npc_greeted,\n    trace: traces.join(\";\"),\n 
    };\n  pushData(data);\n  $.state.npc_trace = [];\n  $.log(\"[NPC] trial done:
    samples=\" + traces.length + \" contactDist=\" + f3(data.contactDist) + \" retreat=\"
    + f3(data.retreatDist) +\n        \" rootRetreat=\" + f3(data.rootRetreat) +
    \" rootShiftPre=\" + f3(data.rootShiftPre) + \" rootShiftEnd=\" + f3(data.rootShiftEnd));\n 
    leave(true);\n}\n\n// Touch end, once the NPC has gone: put every participant
    back on the marker (on their platform, keeping their\n// facing), however little
    they moved. The stick moves them slowly during the touch (NpcDirector), so they
    can back\n// away from the hand, and it is off again in the report that follows.\nfunction
    returnParticipant() {\n  const p = participant(), o = $.state.npc_origin;\n 
    if (!p || !o) { pushData({ returnedToMarker: false }); return; }\n  const root
    = p.getPosition();\n  const back = resetParticipant(false);\n  pushData({ returnedToMarker:
    back });\n  $.log(\"[NPC] participant \" + (back ? \"put back on the marker\"
    : \"could not be put back on the marker\") +\n        (root ? \" (was \" + f3(hdist(root,
    o)) + \" m away)\" : \"\"));\n}\n\n// Step back to the conversation spot, then
    disappear (tick); with signalDone, \"npc_done\" is sent once hidden.\nfunction
    leave(signalDone) {\n  $.state.npc_pendingStart = false;\n  $.state.npc_phase
    = \"leave\";\n  $.state.npc_t = 0;\n  $.state.npc_leaveSignal = !!signalDone;\n 
    clearReaction();\n  if (!$.state.npc_visible || !moveToStand(NPC_CFG.IDLE_EXTRA_DIST,
    true)) $.state.npc_glide = null;\n}\n\nfunction pushData(obj) {\n  try {\n   
    if ($.groupState) {\n      const cd = $.groupState.collectedData || {};\n     
    for (const k in obj) cd[k] = obj[k];\n      $.groupState.collectedData = cd;\n     
    return;\n    }\n  } catch (e) { $.log(\"[NPC] groupState write failed: \" + e);
    }\n  try {\n    const h = $.worldItemReference(\"luida-data-collector\");\n   
    if (h) h.send(\"luida_collect\", obj);\n  } catch (e) { $.log(\"[NPC] luida_collect
    send failed: \" + e); }\n}\n\n// ----------------------------------------------------------------
    pose building\n// Arm description (item-local directions): upper = shoulder->elbow,
    lower = elbow->wrist,\n// hand = wrist->fingers, palm = palm normal. Rest (T-pose,
    VRM convention): arms horizontal,\n// palms facing down, elbows flexing forward.\nconst
    PALM_DOWN = new Vector3(0, -1, 0);\n\nfunction armRots(rest, side, arm) {\n 
    const restU = side === \"R\" ? rest.axisRU : rest.axisLU;\n  const restL = side
    === \"R\" ? rest.axisRL : rest.axisLL;\n  return {\n    u: basisRot(restU, rest.fwd,
    arm.upper, arm.lower),   // elbow bends toward the forearm\n    l: basisRot(restL,
    PALM_DOWN, arm.lower, arm.palm),   // forearm twist follows the palm\n    h:
    basisRot(restL, PALM_DOWN, arm.hand, arm.palm),    // hand: fingers + palm direction\n 
    };\n}\n// Relaxed arm hanging at the side, palm facing the thigh (toward the
    body midline).\nfunction idleArm(rest, side) {\n  const R = vscale(rest.right,
    side === \"R\" ? 1 : -1), F = rest.fwd;\n  const lower = vnorm(vadd(vadd(vscale(UP,
    -0.92), vscale(F, 0.30)), vscale(R, 0.12)));\n  return {\n    upper: vnorm(vadd(vadd(vscale(UP,
    -1.0), vscale(R, 0.22)), vscale(F, 0.05))),\n    lower: lower,\n    hand: lower,\n   
    palm: vscale(R, -1),\n  };\n}\n// Left arm raised for waving: forearm up (oscillating
    sideways), palm facing the participant.\nfunction waveArm(rest, gt) {\n  const
    Lf = vscale(rest.right, -1), F = rest.fwd;\n  const upper = vnorm(vadd(vadd(vscale(UP,
    -0.4), vscale(Lf, 0.75)), vscale(F, 0.2)));\n  let lower = vnorm(vadd(vadd(vscale(UP,
    0.85), vscale(F, 0.25)), vscale(Lf, 0.2)));\n  lower = qrot(qaxis(F, 25 * Math.sin(2
    * Math.PI * 2.5 * gt)), lower);\n  return { upper: upper, lower: lower, hand:
    lower, palm: F };\n}\n// Reaching hand: fingers HAND_PITCH_DEG above horizontal,
    in the vertical plane of the approach direction d;\n// palm facing along d (toward
    the face). When the fingers point almost along d, the palm faces forward-down.\nfunction
    reachHandFrame(d) {\n  const dn = vnorm(d);\n  const horiz = vhoriz(dn);\n  const
    pitch = NPC_CFG.HAND_PITCH_DEG * Math.PI / 180;\n  const h = vnorm(vadd(vscale(horiz,
    Math.cos(pitch)), vscale(UP, Math.sin(pitch))));\n  let n = perpTo(dn, h);\n 
    if (vlen(n) < 0.2) n = perpTo(vsub(horiz, UP), h);\n  return { h: h, n: vnorm(n)
    };\n}\n// Wrist -> contact point (finger pads).\nfunction palmOffset(frame) {\n 
    return vadd(vscale(frame.h, NPC_CFG.CONTACT_LEN), vscale(frame.n, NPC_CFG.PALM_OFF));\n}\n//
    Right arm placing the palm contact point at F (local) with the given hand frame.\nfunction
    reachArm(rest, F, frame) {\n  const W = vsub(F, palmOffset(frame));\n  const
    hint = vnorm(vadd(vscale(UP, -0.8), vscale(rest.right, 0.6)));\n  const sol =
    solveArm(rest.sR, W, rest.L1, rest.L2, hint);\n  return { upper: sol.upperDir,
    lower: sol.lowerDir, hand: frame.h, palm: frame.n, frame: frame };\n}\n// Time
    to travel a leg of length L from rest to rest: accelerate for r seconds to the
    speed v, decelerate for r.\nfunction legDuration(L, v, r) {\n  v = Math.max(1e-3,
    v);\n  if (!(r > 0)) return L / v;\n  return L >= v * r ? L / v + r : 2 * Math.sqrt(L
    * r / v);\n}\n// Distance covered t seconds into such a leg.\nfunction legDistance(L,
    v, r, t) {\n  v = Math.max(1e-3, v);\n  const T = legDuration(L, v, r);\n  if
    (t <= 0) return 0;\n  if (t >= T) return L;\n  if (!(r > 0)) return v * t;\n 
    const a = v / r, ta = Math.min(r, T / 2);\n  if (t < ta) return 0.5 * a * t *
    t;\n  if (t > T - ta) { const u = T - t; return L - 0.5 * a * u * u; }\n  return
    0.5 * a * ta * ta + a * ta * (t - ta);\n}\n// Stroke after contact (local coordinates).
    Each cycle: slide down the face by the stroke length at REACH_SPEED (a straight\n//
    leg, in contact), then return to the top along one smooth arc at STROKE_RETURN_SPEED:
    half an ellipse that leaves\n// the face at the bottom, swings out to STROKE_BACK
    from it (back along the approach direction dir) half-way up, and\n// comes back
    onto the face at the top. The last cycle ends at the bottom of its down-stroke.
    Each leg starts and ends at\n// rest (legDuration / legDistance along its length).
    Returns the legs with their start times, and the total time.\nconst STROKE_ARC_STEPS
    = 24;       // samples of the return arc for its length (arc-length parametrisation)\nfunction
    strokeArcPoint(leg, th) {  // th: 0 (bottom, leg.a) -> PI (top, leg.b)\n  return
    vadd(vadd(leg.c, vscale(leg.hv, -Math.cos(th))), vscale(leg.out, Math.sin(th)));\n}\nfunction
    strokePath(Fc, dir) {\n  const A = (typeof $.state.npc_strokeAmp === \"number\")
    ? $.state.npc_strokeAmp : 1.5 * (NPC_CFG.EYE_UP - NPC_CFG.MOUTH_UP) + NPC_CFG.TARGET_UP_OFFSET;\n 
    const B = NPC_CFG.STROKE_BACK, N = NPC_CFG.STROKE_CYCLES;\n  const vs = NPC_CFG.REACH_SPEED,
    vr = NPC_CFG.STROKE_RETURN_SPEED;\n  const ramp = NPC_CFG.STROKE_RAMP_SEC;\n 
    const legs = [];\n  if (!(A > 0) || !(N > 0) || !(vs > 0)) return { start: Fc,
    legs: legs, total: 0 };\n  const down = vadd(vscale(UP, -A), vscale(vhoriz(dir),
    A * (NPC_CFG.STROKE_INWARD || 0))), out = vscale(vnorm(dir), -Math.max(0, B));\n 
    let p = Fc, t = 0;\n  function add(leg) { leg.t0 = t; t += legDuration(leg.L,
    leg.v, ramp); legs.push(leg); p = leg.b; }\n  for (let k = 0; k < N; k++) {\n   
    const bottom = vadd(p, down);\n    add({ a: p, b: bottom, v: vs, L: vlen(down)
    });   // stroke down (and along the face), in contact\n    if (k < N - 1 && vr
    > 0) {\n      // back up to where this stroke started, along the arc\n      const
    top = vsub(p, down);\n      const leg = { a: p, b: top, v: vr, arc: true, c:
    vlerp(p, top, 0.5), hv: vscale(vsub(top, p), 0.5), out: out, cum: [0] };\n     
    let q = p, len = 0;\n      for (let i = 1; i <= STROKE_ARC_STEPS; i++) {\n       
    const r = strokeArcPoint(leg, Math.PI * i / STROKE_ARC_STEPS);\n        len +=
    vlen(vsub(r, q)); q = r; leg.cum.push(len);\n      }\n      leg.L = len;\n     
    add(leg);\n    }\n  }\n  return { start: Fc, legs: legs, total: t };\n}\n// Position
    on the stroke path t seconds after contact.\nfunction strokePoint(path, t) {\n 
    const legs = path.legs;\n  if (t <= 0 || legs.length === 0) return path.start;\n 
    for (let i = 0; i < legs.length; i++) {\n    const leg = legs[i];\n    const
    T = legDuration(leg.L, leg.v, NPC_CFG.STROKE_RAMP_SEC);\n    if (t > leg.t0 +
    T) continue;\n    const dist = legDistance(leg.L, leg.v, NPC_CFG.STROKE_RAMP_SEC,
    t - leg.t0);\n    if (!leg.arc) return vlerp(leg.a, leg.b, leg.L > 1e-6 ? dist
    / leg.L : 1);\n    // arc: the sample interval that contains this distance, then
    the angle within it\n    let j = 1;\n    while (j < STROKE_ARC_STEPS && leg.cum[j]
    < dist) j++;\n    const span = leg.cum[j] - leg.cum[j - 1];\n    const f = span
    > 1e-9 ? (dist - leg.cum[j - 1]) / span : 0;\n    return strokeArcPoint(leg,
    Math.PI * (j - 1 + f) / STROKE_ARC_STEPS);\n  }\n  return legs[legs.length -
    1].b;\n}\n// Wrist and palm contact point of a solved right arm (accounts for
    IK clamping when out of reach).\nfunction wristOf(rest, arm) {\n  return vadd(vadd(rest.sR,
    vscale(arm.upper, rest.L1)), vscale(arm.lower, rest.L2));\n}\nfunction contactOf(rest,
    arm) {\n  return vadd(wristOf(rest, arm), palmOffset(arm.frame));\n}\n// Two-bone
    IK for a wrist target W (local). Returns {upperDir, lowerDir}.\nfunction solveArm(S,
    W, L1, L2, bendHint) {\n  const toW = vsub(W, S);\n  let d = vlen(toW);\n  d
    = Math.max(0.03, Math.min(L1 + L2 - 0.002, d));\n  const dir = vnorm(toW);\n 
    let cosA = (L1 * L1 + d * d - L2 * L2) / (2 * L1 * d);\n  cosA = Math.max(-1,
    Math.min(1, cosA));\n  const sinA = Math.sqrt(Math.max(0, 1 - cosA * cosA));\n 
    let perp = vsub(bendHint, vscale(dir, vdot(bendHint, dir)));\n  if (vlen(perp)
    < 1e-4) perp = vcross(dir, UP);\n  perp = vnorm(perp);\n  const upperDir = vnorm(vadd(vscale(dir,
    cosA), vscale(perp, sinA)));\n  const E = vadd(S, vscale(upperDir, L1));\n  const
    lowerDir = vnorm(vsub(W, E));\n  return { upperDir: upperDir, lowerDir: lowerDir,
    elbow: E };\n}\nfunction applyPose(Q) {\n  const worldRots = {};\n  for (let
    i = 0; i < boneNodes.length; i++) {\n    const e = boneNodes[i];\n    const q
    = Q[e.bone] || IDENT;\n    worldRots[e.bone] = q;\n    const parentQ = (e.parentBone
    === null || worldRots[e.parentBone] === undefined) ? IDENT : worldRots[e.parentBone];\n   
    const desired = qmul(q, e.rest);\n    const parent = qmul(parentQ, e.restParent);\n   
    e.node.setRotation(qmul(qinv(parent), desired));\n  }\n}\n\n// ----------------------------------------------------------------
    per-frame\n$.onUpdate((deltaTime) => {\n  try { tick(deltaTime); } catch (e)
    { $.log(\"[NPC] tick error: \" + e); }\n});\n\nfunction tick(dt) {\n  $.state.npc_clock
    = ($.state.npc_clock || 0) + dt;\n  if (boneNodes.length === 0) cacheBones();\n 
    const rest = restGeom();\n  if (!rest) return;                       // keep
    the model visible until the rest pose is measured\n\n  // Visibility: hidden
    until shown (also re-applied after a script reload).\n  if ($.state.npc_visibilityApplied
    !== !!$.state.npc_visible) applyVisibility();\n\n  if ($.state.npc_heightPending)
    tryHeightMatch();\n\n  if ($.state.npc_pendingStart) {\n    $.state.npc_startDelay
    = ($.state.npc_startDelay || 0) - dt;\n    if ($.state.npc_startDelay > 0) return;\n   
    startTrial();\n    return;\n  }\n\n  // Glide to the target standing pose (position/rotation
    are networked, so keep it short).\n  const g = $.state.npc_glide;\n  if (g) {\n   
    const t = clamp01((g.t || 0) + dt / NPC_CFG.GLIDE_SEC);\n    const e = easeInOut(t);\n   
    $.setPosition(vlerp(g.fromPos, g.toPos, e));\n    $.setRotation(qslerp(g.fromRot,
    g.toRot, e));\n    if (t >= 1) $.state.npc_glide = null; else { g.t = t; $.state.npc_glide
    = g; }\n  }\n\n  // Back at the conversation spot after a trial: disappear (out
    of the way of the report panel and the\n  // questionnaires), then let the director
    move on.\n  if ($.state.npc_phase === \"leave\" && !$.state.npc_glide) {\n   
    $.state.npc_phase = \"idle\";\n    $.state.npc_t = 0;\n    setVisible(false);\n   
    returnParticipant();\n    if ($.state.npc_leaveSignal) $.sendSignalCompat(\"this\",
    \"npc_done\");\n    $.state.npc_leaveSignal = false;\n    $.log(\"[NPC] back
    at the conversation spot; hidden\");\n    return;\n  }\n\n  if (!$.state.npc_visible)
    return;        // nothing to animate while hidden\n\n  const p = participant();\n 
    const head = p ? headOf(p) : null;\n  const root = p ? p.getPosition() : null;  
    // avatar position, for the trace\n  let ip = itemPose();\n  const social = !!$.state.npc_social;\n 
    const phase = $.state.npc_phase || \"idle\";\n  const greeting = $.state.npc_mode
    === \"greeting\";\n  if (greeting && social && head && !$.state.npc_glide) ip
    = turnBodyToward(head, restGeom(), ip, dt);\n  let t = ($.state.npc_t || 0) +
    dt;\n  $.state.npc_t = t;\n\n  const Q = {};\n  const R = rest.right, F = rest.fwd;\n\n 
    // --- torso / idle motion (social only) ---\n  if (social) {\n    const breathe
    = Math.sin(2 * Math.PI * 0.25 * (Date.now() / 1000)) * 1.0;\n    Q[HumanoidBone.Chest]
    = qaxis(R, breathe);\n    if (phase === \"approach\" || phase === \"stroke\"
    || phase === \"hold\") Q[HumanoidBone.Spine] = qaxis(R, 5);\n  }\n\n  // ---
    gaze (social only): head (and eyes) only; large angles are taken up by the body
    turn above,\n  //     which also unwinds the head's local rotation as the body
    comes around ---\n  if (social && head) {\n    const dir = vnorm(vsub(toLocal(head.pos,
    ip), rest.head));\n    const qFull = qfromTo(F, dir);\n    const qHead = qclamp(qFull,
    NPC_CFG.HEAD_MAX_DEG);\n    const qEye = qmul(qHead, qclamp(qmul(qinv(qHead),
    qFull), NPC_CFG.EYE_EXTRA_DEG));\n    Q[HumanoidBone.Head] = qHead;\n    Q[HumanoidBone.LeftEye]
    = qEye;\n    Q[HumanoidBone.RightEye] = qEye;\n  }\n\n  // --- participant signals:
    greeting period (counted), trial prep (logging + one greeting) ---\n  if (head
    && (greeting || phase === \"prep\" || phase === \"approach\")) {\n    const sig
    = detectParticipantSignals(p, head, rest, ip);\n    if (greeting) {\n      //
    counted only: the NPC's reactions follow the guided greeting's cues (greetCue)\n     
    if (sig.gazeEdge) $.state.npc_gGaze = ($.state.npc_gGaze || 0) + 1;\n      if
    (sig.handEdge) $.state.npc_gHand = ($.state.npc_gHand || 0) + 1;\n      if (social
    && p && detectTouch(p, rest, ip)) surprise();\n    } else if (sig.aligned &&
    !$.state.npc_lookedAt) {\n      $.state.npc_lookedAt = true;\n      $.state.npc_lookTs
    = Date.now();\n      if (social && phase === \"prep\" && !$.state.npc_react)
    { startReaction(NPC_CFG.PREP_REACTION, \"prep\"); $.state.npc_greeted = true;
    }\n    }\n  }\n\n  // --- arms (bone rotations incl. twist, so the palms face
    the right way) ---\n  const idleR = armRots(rest, \"R\", idleArm(rest, \"R\"));\n 
    const idleL = armRots(rest, \"L\", idleArm(rest, \"L\"));\n  let armR = idleR,
    armL = idleL;\n\n  // reaction gesture (nod and/or left-hand wave with the palm
    toward the participant), social only\n  let nodDeg = 0;\n  const react = $.state.npc_react;\n 
    if (social && react) {\n    const rt = (react.t || 0) + dt;\n    if (react.wave)
    {\n      const lift = Math.sin(Math.PI * clamp01(rt / react.dur));     // 0 ->
    1 -> 0\n      armL = slerpArm(idleL, armRots(rest, \"L\", waveArm(rest, rt)),
    lift);\n    }\n    if (react.nod) {\n      const nodSec = react.wave ? 0.6 :
    NPC_CFG.NOD_SEC;\n      nodDeg = NPC_CFG.NOD_DEG * Math.sin(Math.PI * clamp01(rt
    / nodSec));\n    }\n    if (rt >= react.dur) {\n      clearReaction();\n     
    $.log(\"[NPC] reaction \" + (react.name || \"?\") + \" ended after \" + f3(rt)
    + \" s\");\n    } else { react.t = rt; $.state.npc_react = react; }\n  } else
    if (react && !social) {\n    clearReaction();\n  }\n\n  // --- phase machine
    for the right arm ---\n  if (phase === \"prep\") {\n    const greetBusy = social
    && $.state.npc_react;\n    if (t >= NPC_CFG.PREP_SEC && !greetBusy && head &&
    !$.state.npc_glide) {\n      // social: if the participant never looked, greet
    once before raising the hand\n      if (social && !$.state.npc_greeted) { $.state.npc_greeted
    = true; startReaction(NPC_CFG.PREP_REACTION, \"prep\"); }\n      else { $.state.npc_phase
    = \"ready\"; $.state.npc_t = 0; }\n    }\n  } else if (phase === \"ready\") {\n   
    // raise the hand from the idle pose to the ready position, palm already turned
    toward the\n    // participant's face (fast; the stimulus starts afterwards)\n   
    const T = head ? toLocal(facePointWorld(head), ip) : vadd(rest.sR, vadd(vscale(rest.fwd,
    0.4), vscale(UP, 0.2)));\n    const H0 = readyContact(rest, T);\n    const readyArm
    = armRots(rest, \"R\", reachArm(rest, H0, reachHandFrame(vsub(T, H0))));\n   
    armR = slerpArm(idleR, readyArm, easeInOut(t / NPC_CFG.READY_SEC));\n    if (t
    >= NPC_CFG.READY_SEC && head) beginApproach(head, rest, ip);\n  } else if (phase
    === \"approach\") {\n    const L = $.state.npc_L, dir = $.state.npc_dir, H0 =
    $.state.npc_H0;\n    const frame = $.state.npc_frame || reachHandFrame(dir);\n   
    const s = Math.min(NPC_CFG.REACH_SPEED * t, L);\n    const Ft = vadd(H0, vscale(dir,
    s));\n    const arm = reachArm(rest, Ft, frame);\n    armR = armRots(rest, \"R\",
    arm);\n    const Fw = toWorld(contactOf(rest, arm), ip);\n    let d = -1;\n   
    if (head) {\n      d = vlen(vsub(Fw, facePointWorld(head)));\n      sampleTrace(dt,
    t, head, Fw, d, root);\n    }\n    const reachedEnd = s >= L;\n    const earlyContact
    = d >= 0 && d <= NPC_CFG.STOP_MARGIN;\n    if (reachedEnd || earlyContact) {\n     
    $.state.npc_contactTs = Date.now();\n      $.state.npc_contactDist = d;\n     
    $.state.npc_contactT = t;\n      $.state.npc_Fc = Ft;\n      $.state.npc_strokeSec
    = strokePath(Ft, dir).total;\n      $.state.npc_Fhold = Ft;\n      $.state.npc_phase
    = \"stroke\";\n      $.state.npc_t = 0;\n      // how far the rendered wrist
    is from the IK wrist (bone map / rest pose mismatch shows up here)\n      const
    wn = nodeByBone[HumanoidBone.RightHand];\n      const wAct = wn ? wn.node.getGlobalPosition()
    : null;\n      const wErr = wAct ? vlen(vsub(wAct, toWorld(wristOf(rest, arm),
    ip))) : -1;\n      $.log(\"[NPC] contact: d=\" + f3(d) + \" early=\" + earlyContact
    + \" wristErr=\" + f3(wErr) + \", stroking for \" +\n            f3($.state.npc_strokeSec)
    + \" s\");\n    }\n  } else if (phase === \"stroke\") {\n    // gently stroke
    the face along strokePath(): down in contact, back up along an arc off the face
    (same hand\n    // orientation as the approach)\n    const Fc = $.state.npc_Fc
    || $.state.npc_T;\n    const dur = $.state.npc_strokeSec || 0;\n    const Fs
    = strokePoint(strokePath(Fc, $.state.npc_dir), Math.min(t, dur));\n    const
    arm = reachArm(rest, Fs, $.state.npc_frame || reachHandFrame($.state.npc_dir));\n   
    armR = armRots(rest, \"R\", arm);\n    if (head) {\n      const Fw = toWorld(contactOf(rest,
    arm), ip);\n      sampleTrace(dt, ($.state.npc_contactT || 0) + t, head, Fw,
    vlen(vsub(Fw, facePointWorld(head))), root);\n    }\n    if (social) nodDeg =
    Math.max(nodDeg, 10 * Math.sin(Math.PI * clamp01(t / 1.0)));\n    if (t >= dur)
    {\n      $.state.npc_strokeEndTs = Date.now();\n      $.state.npc_Fhold = Fs;             
    // rest where the last stroke ended\n      $.state.npc_phase = \"hold\";\n     
    $.state.npc_t = 0;\n    }\n  } else if (phase === \"hold\") {\n    const Fc =
    $.state.npc_Fhold || $.state.npc_Fc || $.state.npc_T;\n    const arm = reachArm(rest,
    Fc, $.state.npc_frame || reachHandFrame($.state.npc_dir));\n    armR = armRots(rest,
    \"R\", arm);\n    const sinceContact = ($.state.npc_strokeSec || 0) + t;\n   
    if (head) {\n      const Fw = toWorld(contactOf(rest, arm), ip);\n      sampleTrace(dt,
    ($.state.npc_contactT || 0) + sinceContact, head, Fw, vlen(vsub(Fw, facePointWorld(head))),
    root);\n    }\n    if (social) nodDeg = Math.max(nodDeg, 10 * Math.sin(Math.PI
    * clamp01(sinceContact / 1.0)));\n    if (t >= NPC_CFG.HOLD_SEC) {\n      $.state.npc_phase
    = \"retract\";\n      $.state.npc_t = 0;\n      // duration from the distance
    back toward the ready point at RETRACT_SPEED (+0.8 s to settle)\n      $.state.npc_retractSec
    = vlen(vsub(Fc, $.state.npc_H0)) / NPC_CFG.RETRACT_SPEED + 0.8;\n    }\n  } else
    if (phase === \"retract\") {\n    // blend the joint rotations from the hold
    pose back to the relaxed arm\n    const Fc = $.state.npc_Fhold || $.state.npc_Fc
    || $.state.npc_T;\n    const holdArm = armRots(rest, \"R\", reachArm(rest, Fc,
    $.state.npc_frame || reachHandFrame($.state.npc_dir)));\n    const u = clamp01(t
    / Math.max(0.5, $.state.npc_retractSec || 2.0));\n    armR = slerpArm(holdArm,
    idleR, easeInOut(u));\n    if (u >= 1) finishTrial();\n  }\n\n  // nod composes
    with gaze\n  if (nodDeg !== 0) {\n    const qNod = qaxis(R, nodDeg);\n    Q[HumanoidBone.Head]
    = qmul(Q[HumanoidBone.Head] || IDENT, qNod);\n  }\n\n  Q[HumanoidBone.RightUpperArm]
    = armR.u;\n  Q[HumanoidBone.RightLowerArm] = armR.l;\n  Q[HumanoidBone.RightHand]
    = armR.h;\n  for (const b of R_FINGER_BONES) if (nodeByBone[b]) Q[b] = armR.h;\n 
    Q[HumanoidBone.LeftUpperArm] = armL.u;\n  Q[HumanoidBone.LeftLowerArm] = armL.l;\n 
    Q[HumanoidBone.LeftHand] = armL.h;\n\n  applyPose(Q);\n}\n\n// 10 Hz head (and
    avatar position) trace plus the in-world retreat estimate. root: the avatar position
    (or null).\nfunction sampleTrace(dt, t, head, Fw, d, root) {\n  sampleTimer +=
    dt;\n  if (sampleTimer < NPC_CFG.SAMPLE_INTERVAL) return;\n  sampleTimer = 0;\n 
    const h = head.pos, r = head.rot;\n  const total = ($.state.npc_trace || []).length
    + traceBuf.length;\n  if (total < NPC_CFG.MAX_SAMPLES) {\n    traceBuf.push([t.toFixed(1),
    f3(h.x), f3(h.y), f3(h.z), f3(r.x), f3(r.y), f3(r.z), f3(r.w), f3(d),\n                  
    root ? f3(root.x) : \"\", root ? f3(root.y) : \"\", root ? f3(root.z) : \"\"].join(\",\"));\n 
    }\n  if (traceBuf.length >= 10) {\n    $.state.npc_trace = ($.state.npc_trace
    || []).concat(traceBuf);\n    traceBuf = [];\n  }\n  // retreat / oscillation
    estimate (world frame)\n  if (!$.state.npc_base) {\n    baseSamples.push(vcopy(h));\n   
    if (root) baseRootSamples.push(vcopy(root));\n    if (t >= 1.0) {\n      let
    sum = v3(0, 0, 0);\n      for (const b of baseSamples) sum = vadd(sum, b);\n     
    $.state.npc_base = vscale(sum, 1 / Math.max(1, baseSamples.length));\n      if
    (baseRootSamples.length > 0) {   // same baseline window for the avatar position\n       
    let rs = v3(0, 0, 0);\n        for (const b of baseRootSamples) rs = vadd(rs,
    b);\n        $.state.npc_rootBase = vscale(rs, 1 / baseRootSamples.length);\n     
    }\n    }\n    return;\n  }\n  // axis: horizontal approach direction (hand ->
    face), so moving away from the hand is positive along it\n  const axis = $.state.npc_axisW
    || v3(0, 0, 1);\n  if (root && $.state.npc_rootBase) {\n    const rootAway =
    vdot(vsub(root, $.state.npc_rootBase), axis);\n    if (rootAway > ($.state.npc_rootAway
    || 0)) $.state.npc_rootAway = rootAway;\n  }\n  const delta = vsub(h, $.state.npc_base);\n 
    const away = vdot(delta, axis);\n  const lateral = vdot(delta, vcross(axis, UP));\n 
    if (away > ($.state.npc_away || 0)) $.state.npc_away = away;\n  if (lateral <
    ($.state.npc_latMin || 0)) $.state.npc_latMin = lateral;\n  if (lateral > ($.state.npc_latMax
    || 0)) $.state.npc_latMax = lateral;\n  if ($.state.npc_onsetDist < 0 && away
    > NPC_CFG.RETREAT_THRESHOLD) $.state.npc_onsetDist = d;\n}\n"
